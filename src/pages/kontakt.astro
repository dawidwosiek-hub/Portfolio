---
import Layout from '../layouts/Layout.astro';
import {services,site,projects} from '../lib/content';
import {createChallenge,env} from '../lib/form';
Astro.response.headers.set('Cache-Control','no-store');
const requestedProject=Astro.url.searchParams.get('projekt')||'';
const selectedProject=projects.find(p=>p.name===requestedProject);
const project=selectedProject?.name||'';
const selected=Astro.url.searchParams.get('usluga')||services.find(s=>s.category===selectedProject?.category)?.slug||'';
const configured=!!(env('RESEND_API_KEY')&&env('CONTACT_FROM')&&env('CONTACT_TO')&&env('FORM_SECRET')&&env('SITE_URL'));
---
<Layout title="Kontakt i wycena projektu | NADX" description="Opowiedz o swoim projekcie. Zapytaj o logo, materiały reklamowe, montaż filmu lub projekt nadruku. Kraków i współpraca zdalna.">
<section class="page-intro section contact-intro"><span class="eyebrow">KONTAKT / ZACZNIJMY OD ROZMOWY</span><h1>Co robimy dla<br/>Twojej <em>firmy?</em></h1><p>Nie musisz mieć gotowego briefu. Napisz, jaki masz cel — szczegóły ustalimy wspólnie.</p></section>
<section class="section contact-layout"><aside><span class="eyebrow">DOBRY POCZĄTEK</span><h2>Opowiedz mi<br/>o swoim pomyśle.</h2><p>Im więcej wiem o Twojej firmie i potrzebach, tym łatwiej zaproponować konkretny zakres.</p><div class="contact-data">{site.email&&<a href={`mailto:${site.email}`}>{site.email} <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></a>}{site.phone&&<a href={`tel:${site.phone.replace(/\s/g,'')}`}>{site.phone}</a>}{site.socials.map((s:{label:string;url:string})=><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></a>)}</div><p class="location">Kraków i okolice<br/>Zdalnie w całej Polsce</p>{!configured&&<div class="setup-notice"><strong>Kontakt w przygotowaniu</strong><p>Formularz oczekuje na konfigurację skrzynki. Obecnie nie wysyła zapytań.</p></div>}</aside>
<form id="inquiry" novalidate><input type="hidden" name="challenge" value={createChallenge()}/><input type="hidden" name="project" value={project}/>{project&&<div class="project-selection">Inspiracja: <strong>{project}</strong></div>}
<div class="form-field"><label for="service">Czego potrzebujesz? <span>*</span></label><select id="service" name="service" required><option value="">Wybierz usługę</option>{services.map(s=><option value={s.slug} selected={selected===s.slug}>{s.title}</option>)}</select><span class="field-error" id="error-service"></span></div>
<div class="form-field"><label for="description">Opisz swój projekt <span>*</span></label><textarea id="description" name="description" rows="5" minlength="20" maxlength="5000" required placeholder="Czym zajmuje się firma? Co chcesz zaprojektować lub pokazać?"></textarea><span class="field-error" id="error-description"></span></div>
<div class="form-row"><div class="form-field"><label for="deadline">Oczekiwany termin <span>*</span></label><input id="deadline" name="deadline" maxlength="120" placeholder="Np. wrzesień lub do ustalenia" required/><span class="field-error" id="error-deadline"></span></div><div class="form-field"><label for="budget">Budżet <small>(opcjonalnie)</small></label><input id="budget" name="budget" maxlength="120" placeholder="Kwota lub przedział"/><span class="field-error" id="error-budget"></span></div></div>
<div class="form-row"><div class="form-field"><label for="name">Imię <span>*</span></label><input id="name" name="name" autocomplete="given-name" minlength="2" maxlength="120" required/><span class="field-error" id="error-name"></span></div><div class="form-field"><label for="email">E-mail <span>*</span></label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required/><span class="field-error" id="error-email"></span></div></div>
<div class="form-row"><div class="form-field"><label for="phone">Telefon <small>(opcjonalnie)</small></label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40"/><span class="field-error" id="error-phone"></span></div><div class="form-field"><label for="reference">Link do materiałów <small>(opcjonalnie)</small></label><input id="reference" name="reference" type="url" maxlength="2048" placeholder="https://…"/><span class="field-error" id="error-reference"></span></div></div>
<div class="honeypot" aria-hidden="true"><label for="website">Pozostaw to pole puste</label><input id="website" name="website" tabindex="-1" autocomplete="off"/></div>
<div class="form-field"><label class="checkbox-label"><input type="checkbox" name="privacy" id="privacy" required/><span>Zapoznałem/am się z <a href="/prywatnosc">informacją o prywatności</a> i przetwarzaniu danych w celu odpowiedzi na zapytanie. *</span></label><span class="field-error" id="error-privacy"></span></div>
<p class="form-status" role="status" aria-live="polite" tabindex="-1"></p><button type="submit" class="button yellow">Wyślij zapytanie <span aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></span></button><p class="form-note">* Pola wymagane. Wysłanie zapytania nie oznacza zamówienia usługi.</p><noscript>Formularz wymaga JavaScript. {site.email?`Napisz bezpośrednio na ${site.email}.`:'Kontakt e-mail nie został jeszcze uzupełniony.'}</noscript>
</form></section>
<script>
import {validate} from '../lib/form-validation';
const form=document.querySelector<HTMLFormElement>('#inquiry')!;
const status=form.querySelector<HTMLElement>('.form-status')!;
const button=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
function errors(items:Record<string,string>){form.querySelectorAll('.field-error').forEach(el=>el.textContent='');form.querySelectorAll('[aria-invalid]').forEach(el=>{el.removeAttribute('aria-invalid');el.removeAttribute('aria-describedby');});for(const [key,message]of Object.entries(items)){const field=form.elements.namedItem(key)as HTMLElement;const error=document.getElementById(`error-${key}`);if(error)error.textContent=message;field?.setAttribute('aria-invalid','true');field?.setAttribute('aria-describedby',`error-${key}`);}if(Object.keys(items).length)(form.elements.namedItem(Object.keys(items)[0])as HTMLElement)?.focus();}
form.addEventListener('submit',async e=>{e.preventDefault();const data=Object.fromEntries(new FormData(form));const payload={...data,privacy:(form.elements.namedItem('privacy')as HTMLInputElement).checked};const invalid=validate(payload);errors(invalid);if(Object.keys(invalid).length){status.textContent='Sprawdź zaznaczone pola.';return;}button.disabled=true;button.textContent='Wysyłanie…';form.setAttribute('aria-busy','true');status.textContent='Przekazuję zapytanie…';try{const r=await fetch('/api/inquiry',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});const result=await r.json();status.textContent=result.message||'Nie udało się wysłać zapytania.';if(!r.ok){errors(result.errors||{});if(!result.errors)status.focus();}else{window.dispatchEvent(new CustomEvent('nadx:analytics',{detail:{event:'inquiry_accepted',service:data.service}}));form.reset();button.hidden=true;status.classList.add('success');status.focus();}}catch{status.textContent='Błąd połączenia. Spróbuj ponownie — wpisana treść została zachowana.';status.focus();}finally{button.disabled=false;button.innerHTML='Wyślij zapytanie <span aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></span>';form.removeAttribute('aria-busy');}});
form.querySelector('select')?.addEventListener('change',e=>window.dispatchEvent(new CustomEvent('nadx:analytics',{detail:{event:'service_select',service:(e.target as HTMLSelectElement).value}})));
</script>
</Layout>
