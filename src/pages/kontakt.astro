---
import Layout from '../layouts/Layout.astro';
import {services,site,projects,phoneHref,projectInCategory} from '../lib/content';
import {createChallenge,env} from '../lib/form';
Astro.response.headers.set('Cache-Control','no-store');
const requestedProject=Astro.url.searchParams.get('projekt')||'';
const selectedProject=projects.find(p=>p.name===requestedProject);
const project=selectedProject?.name||'';
const topics:Record<string,{title:string;service:string}>={oklejenia:{title:'Projekt oklejenia samochodu lub łodzi',service:'druk-i-reklama'},marka:{title:'Logo i materiały dla firmy',service:'logo-i-identyfikacja'}};
const topicKey=Astro.url.searchParams.get('temat')||'';
const topic=Object.hasOwn(topics,topicKey)?topics[topicKey]:undefined;
const selected=services.find(s=>s.slug===Astro.url.searchParams.get('usluga'))?.slug||topic?.service||services.find(s=>selectedProject&&projectInCategory(selectedProject,s.category))?.slug||'';
const configured=!!(env('RESEND_API_KEY')&&env('CONTACT_FROM')&&env('CONTACT_TO')&&env('FORM_SECRET')&&env('SITE_URL'));
---
<Layout title="Kontakt i wycena projektu | NADX" description="Opowiedz o swoim projekcie. Zapytaj o logo, materiały reklamowe, montaż filmu lub projekt nadruku. Kraków i współpraca zdalna.">
<section class="page-intro section contact-intro"><span class="eyebrow">KONTAKT / ZACZNIJMY OD ROZMOWY</span><h1>Zacznijmy<br/><em>Twój projekt.</em></h1><p>Napisz, czym zajmuje się firma i czego potrzebujesz. Wrócę z propozycją zakresu i wyceną.</p><div class="quick-contact"><a href={`mailto:${site.email}`}>{site.email}</a><a href={phoneHref}>{site.phone}</a></div></section>
<section class="section contact-layout">
<form id="inquiry" novalidate data-delivery={configured?'api':'email'} data-recipient={site.email} data-topic={topic?.title||''}><input type="hidden" name="challenge" value={createChallenge()}/><input type="hidden" name="project" value={project}/>{(project||topic)&&<div class="project-selection">{project?<>Inspiracja: <strong>{project}</strong></>:<>Temat: <strong>{topic?.title}</strong></>}</div>}
<div class="form-field"><label for="service">Czego potrzebujesz? <span>*</span></label><select id="service" name="service" required><option value="">Wybierz usługę</option>{services.map(s=><option value={s.slug} selected={selected===s.slug}>{s.title}</option>)}</select><span class="field-error" id="error-service"></span></div>
<div class="form-field"><label for="description">Opisz swój projekt <span>*</span></label><textarea id="description" name="description" rows="5" minlength="20" maxlength="5000" required placeholder="Czym zajmuje się firma? Co chcesz zaprojektować lub pokazać?"></textarea><span class="field-error" id="error-description"></span></div>
<div class="form-row"><div class="form-field"><label for="name">Imię <span>*</span></label><input id="name" name="name" autocomplete="given-name" minlength="2" maxlength="120" required/><span class="field-error" id="error-name"></span></div><div class="form-field"><label for="email">E-mail <span>*</span></label><input id="email" name="email" type="email" autocomplete="email" maxlength="254" required/><span class="field-error" id="error-email"></span></div></div>
<details class="contact-extra"><summary>Termin, budżet i materiały <span>(opcjonalnie)</span></summary><div class="form-row"><div class="form-field"><label for="deadline">Oczekiwany termin <small>(opcjonalnie)</small></label><input id="deadline" name="deadline" maxlength="120" placeholder="Jeśli jeszcze nie wiesz, ustalimy go wspólnie"/><span class="field-error" id="error-deadline"></span></div><div class="form-field"><label for="budget">Budżet <small>(opcjonalnie)</small></label><input id="budget" name="budget" maxlength="120" placeholder="Kwota lub przedział"/><span class="field-error" id="error-budget"></span></div></div>
<div class="form-row"><div class="form-field"><label for="phone">Telefon <small>(opcjonalnie)</small></label><input id="phone" name="phone" type="tel" autocomplete="tel" maxlength="40"/><span class="field-error" id="error-phone"></span></div><div class="form-field"><label for="reference">Link do materiałów <small>(opcjonalnie)</small></label><input id="reference" name="reference" type="url" maxlength="2048" placeholder="https://…"/><span class="field-error" id="error-reference"></span></div></div>
</details>
<div class="honeypot" aria-hidden="true"><label for="website">Pozostaw to pole puste</label><input id="website" name="website" tabindex="-1" autocomplete="off"/></div>
<div class="form-field"><label class="checkbox-label"><input type="checkbox" name="privacy" id="privacy" required/><span>Zapoznałem/am się z <a href="/prywatnosc">informacją o prywatności</a> i przetwarzaniu danych w celu odpowiedzi na zapytanie. *</span></label><span class="field-error" id="error-privacy"></span></div>
<p class="form-status" role="status" aria-live="polite" tabindex="-1"></p><button type="submit" class="button yellow">{configured?'Wyślij zapytanie':'Przygotuj wiadomość e-mail'} <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></button><p class="form-note">{configured?'* Pola wymagane. Zapytanie nie zobowiązuje do zamówienia.':'* Pola wymagane. Przygotowanie briefu odbywa się w Twojej przeglądarce. Gotową treść wyślesz ze swojej poczty lub skopiujesz.'}</p>
<div class="mail-draft" hidden><h3>Twoje zapytanie jest gotowe.</h3><p>Otwórz swoją pocztę i wyślij wiadomość albo skopiuj treść na adres <a href={`mailto:${site.email}`}>{site.email}</a>. Wiadomość nie została jeszcze wysłana.</p><label for="mail-text">Treść do wysłania</label><textarea id="mail-text" rows="9" readonly></textarea><div class="mail-actions"><a class="button yellow" id="mail-open" href={`mailto:${site.email}`}>Otwórz pocztę z zapytaniem <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></a><button class="copy-draft" type="button">Skopiuj treść</button></div><p class="copy-status" role="status"></p></div>
<noscript>Napisz bezpośrednio na <a href={`mailto:${site.email}`}>{site.email}</a> lub zadzwoń: <a href={phoneHref}>{site.phone}</a>.</noscript>
</form><aside><span class="eyebrow">DOBRY POCZĄTEK</span><h2>Wolisz bezpośrednio?</h2><p>Napisz e-mail lub zadzwoń.</p><div class="contact-data">{site.email&&<a href={`mailto:${site.email}`}>{site.email} <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></a>}{site.phone&&<a href={phoneHref}>{site.phone}</a>}{site.socials.map((s:{label:string;url:string})=><a href={s.url} target="_blank" rel="noopener noreferrer">{s.label} <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></a>)}</div><p class="location">Kraków i okolice<br/>Zdalnie w całej Polsce</p><div class="next-steps"><strong>Co dzieje się dalej?</strong><ol><li>Opisujesz firmę i potrzebne materiały.</li><li>Ustalamy zakres oraz wycenę.</li><li>Po akceptacji przechodzimy do projektu.</li></ol></div></aside></section>
<script>
import {validate} from '../lib/form-validation';
const form=document.querySelector<HTMLFormElement>('#inquiry')!;
const status=form.querySelector<HTMLElement>('.form-status')!;
const button=form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
const draft=form.querySelector<HTMLElement>('.mail-draft')!;
const mailText=form.querySelector<HTMLTextAreaElement>('#mail-text')!;
function prepareMail(data:Record<string,unknown>){
 const service=(form.elements.namedItem('service') as HTMLSelectElement).selectedOptions[0]?.textContent||'';
 const subject=`Zapytanie — ${service} — NADX`;
 const text=`Dzień dobry,\n\n${data.description}\n\nUsługa: ${service}\n${form.dataset.topic?`Temat: ${form.dataset.topic}\n`:''}${data.project?`Inspiracja: ${data.project}\n`:''}Termin: ${data.deadline}\n${data.budget?`Budżet: ${data.budget}\n`:''}${data.reference?`Materiały: ${data.reference}\n`:''}\n${data.name}\nE-mail: ${data.email}${data.phone?`\nTelefon: ${data.phone}`:''}`;
 mailText.value=text;
 form.querySelector<HTMLAnchorElement>('#mail-open')!.href=`mailto:${form.dataset.recipient}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(text)}`;
 draft.hidden=false;status.textContent='Zapytanie gotowe do wysłania z Twojej poczty.';draft.scrollIntoView({block:'center',behavior:matchMedia('(prefers-reduced-motion: reduce)').matches?'instant':'smooth'});form.querySelector<HTMLAnchorElement>('#mail-open')!.focus({preventScroll:true});
}
form.querySelector('.copy-draft')?.addEventListener('click',async()=>{const message=form.querySelector<HTMLElement>('.copy-status')!;try{await navigator.clipboard.writeText(mailText.value);message.textContent='Skopiowano. Wklej treść do wiadomości e-mail.';}catch{mailText.focus();mailText.select();message.textContent='Zaznaczono treść — skopiuj ją i wklej do wiadomości e-mail.';}});
function errors(items:Record<string,string>){form.querySelectorAll('.field-error').forEach(el=>el.textContent='');form.querySelectorAll('[aria-invalid]').forEach(el=>{el.removeAttribute('aria-invalid');el.removeAttribute('aria-describedby');});for(const [key,message]of Object.entries(items)){const field=form.elements.namedItem(key)as HTMLElement;const error=document.getElementById(`error-${key}`);if(error)error.textContent=message;field?.closest('details')?.setAttribute('open','');field?.setAttribute('aria-invalid','true');field?.setAttribute('aria-describedby',`error-${key}`);}if(Object.keys(items).length)(form.elements.namedItem(Object.keys(items)[0])as HTMLElement)?.focus();}
const originalButton=button.innerHTML;
form.addEventListener('submit',async event=>{
 event.preventDefault();
 const data=Object.fromEntries(new FormData(form));
 const payload={...data,deadline:String(data.deadline||'').trim()||'Do ustalenia',privacy:(form.elements.namedItem('privacy') as HTMLInputElement).checked};
 const invalid=validate(payload);errors(invalid);
 if(Object.keys(invalid).length){status.textContent='Sprawdź zaznaczone pola.';return;}
 if(form.dataset.delivery==='email'){prepareMail(payload);return;}
 button.disabled=true;button.textContent='Wysyłanie…';form.setAttribute('aria-busy','true');status.textContent='Przekazuję zapytanie…';
 try{
  const response=await fetch('/api/inquiry',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(payload)});
  const result=await response.json();status.textContent=result.message||'Nie udało się wysłać zapytania.';
  if(!response.ok){errors(result.errors||{});if(!result.errors){prepareMail(payload);status.textContent='Formularz nie przekazał wiadomości. Możesz wysłać przygotowaną treść ze swojej poczty.';}}
  else{window.dispatchEvent(new CustomEvent('nadx:analytics',{detail:{event:'inquiry_accepted',service:data.service}}));form.reset();button.hidden=true;draft.hidden=true;status.classList.add('success');status.focus();}
 }catch{prepareMail(payload);status.textContent='Nie udało się połączyć. Treść została zachowana i jest gotowa do wysłania e-mailem.';}
 finally{button.disabled=false;button.innerHTML=originalButton;form.removeAttribute('aria-busy');}
});
form.addEventListener('input',event=>{if(!draft.hidden&&!(event.target as HTMLElement).closest('.mail-draft')){draft.hidden=true;status.textContent='Zmieniono dane — przygotuj wiadomość ponownie.';}});
form.querySelector('select')?.addEventListener('change',e=>window.dispatchEvent(new CustomEvent('nadx:analytics',{detail:{event:'service_select',service:(e.target as HTMLSelectElement).value}})));
</script>
</Layout>

<style>
 .contact-intro{padding-top:45px;padding-bottom:32px}.contact-intro h1{font-size:clamp(2.6rem,5.5vw,5.5rem)}.contact-layout{padding-top:20px}.next-steps{border-top:1px solid #dedede;margin-top:30px;padding-top:22px;max-width:360px}.next-steps strong{font-size:.86rem}.next-steps ol{padding-left:19px;margin:12px 0 0;font-size:.81rem;color:#626262;line-height:1.85}.contact-data a:first-child{overflow-wrap:anywhere}.mail-draft{margin-top:27px;border-top:3px solid #ffcc00;padding-top:23px}.mail-draft h3{font-size:1.45rem;line-height:1.2}.mail-draft>p{font-size:.8rem;line-height:1.8;margin:14px 0 20px}.mail-draft>p a{text-decoration:underline}.mail-draft>label{display:block;font-size:.76rem;margin-bottom:9px}.mail-draft textarea{display:block;width:100%;min-height:220px;padding:16px;border:1px solid #dedede;background:#fff;font:inherit;font-size:.8rem;line-height:1.7;resize:vertical}.mail-actions{display:flex;align-items:center;gap:20px;flex-wrap:wrap;margin-top:19px}.mail-actions .button{font-size:.8rem;gap:20px}.copy-draft{border:0;border-bottom:1px solid #101010;background:transparent;padding:9px 0;font-size:.8rem}.mail-draft .copy-status{font-size:.75rem;margin-top:15px}.contact-layout aside>h2{font-size:clamp(2rem,3vw,3.2rem)}@media(max-width:760px){.contact-intro{padding-top:34px;padding-bottom:25px}.contact-intro h1{font-size:2.75rem}.contact-layout{gap:30px;padding-top:10px}.next-steps{margin-top:22px;padding-top:17px}.mail-actions .button{max-width:100%;gap:16px;font-size:.77rem}.contact-data{font-size:.9rem}.contact-layout aside>h2{font-size:2rem}}

 .contact-layout{grid-template-areas:'aside form';grid-template-columns:.8fr 1.2fr}.contact-layout>aside{grid-area:aside}.contact-layout>form{grid-area:form;min-width:0}.quick-contact{display:flex;gap:23px;flex-wrap:wrap;margin-top:17px;font-size:.83rem}.quick-contact a{display:inline-flex;align-items:center;min-height:44px;border-bottom:1px solid #dedede}.contact-extra{border-block:1px solid #dedede;margin:0 0 25px}.contact-extra summary{cursor:pointer;padding:17px 0;font-size:.81rem;font-weight:550}.contact-extra summary span{font-weight:400;color:#626262;font-size:.73rem}.contact-extra[open] summary{margin-bottom:8px}.contact-extra .form-row:last-child .form-field{margin-bottom:15px}.project-selection{background:#fff;border:1px solid #dedede;border-left:3px solid #ffcc00;padding:16px}.copy-draft{min-height:44px}@media(max-width:760px){.contact-layout{grid-template-areas:'form' 'aside';grid-template-columns:1fr;gap:36px}.contact-layout aside{border-top:1px solid #dedede;padding-top:26px}.contact-intro h1{font-size:2.8rem}.quick-contact{font-size:.76rem;gap:18px;margin-top:12px}.contact-extra summary{font-size:.77rem;line-height:1.6}.contact-extra summary span{font-size:.67rem}.contact-layout aside h2{font-size:1.7rem}}
</style>
