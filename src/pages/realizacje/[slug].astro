---
import Layout from '../../layouts/Layout.astro';
import ProjectImage from '../../components/ProjectImage.astro';
import ProjectIdentity from '../../components/ProjectIdentity.astro';
import ProjectApplications from '../../components/ProjectApplications.astro';
import ProjectSources from '../../components/ProjectSources.astro';
import {projects, projectCategories, type Project} from '../../lib/content';
export function getStaticPaths(){return projects.map(project=>({params:{slug:project.slug},props:{project}}));}
export const prerender=true;
interface Props {project:Project}
const {project:p}=Astro.props;
const details=p.gallery.filter(image=>image.kind==='visualization');
const galleryNumber=(p.logo?1:0)+(p.identity?1:0)+1;
---
<Layout title={`${p.name} — ${p.logo?'logo i identyfikacja marki':'realizacja'} | NADX`} description={p.scope} bodyClass="project-page" image={p.shareImage || p.image}>
<article class="case-study">
<header class="case-intro case-container">
 <a class="breadcrumb" href="/realizacje">← Wszystkie realizacje</a>
 <div class="case-intro-grid"><div><span class="eyebrow">{projectCategories(p).join(' / ')}</span><h1>{p.name}<span aria-hidden="true">.</span></h1></div><div class="case-intro-copy"><p>{p.scope}</p><span class="case-credit">Projekt: Dawid Wosiek / NADX</span></div></div>
 {p.applications&&p.applications.length>0&&<nav class="case-nav" aria-label="W tej realizacji">{p.logo&&<a href="#logo-title">Logo</a>}{p.identity&&<a href="#identity-title">Typografia</a>}<a href="#gallery-title">Wizytówki</a>{p.applications.map(application=><a href={`#application-${application.slug}`}>{application.label}</a>)}</nav>}
</header>
{p.logo&&<section class="case-logo case-container" aria-labelledby="logo-title">
 <div class="case-rule"><h2 id="logo-title">01 / Znak</h2><span>Projekt logo</span></div>
 <figure><div class="logo-stage"><img src={p.logo.src} alt={p.logo.alt} width={p.logo.width} height={p.logo.height} class:list={{'logo-inverted':p.logo.invert}} fetchpriority="high"/></div><figcaption>{p.logo.caption}</figcaption></figure>
</section>}
{p.identity&&<div class="case-container"><ProjectIdentity identity={p.identity} number={p.logo?2:1}/></div>}
<section class="case-context case-container" aria-labelledby="context-title"><div><span class="eyebrow">MARKA / KONTEKST</span><h2 id="context-title">{p.client}</h2><p>{p.need}</p></div><div><span class="eyebrow">POMYSŁ I ROZWIĄZANIE</span><p>{p.solution}</p></div></section>
<section class="case-print case-container" aria-labelledby="gallery-title"><div class="case-rule"><span class="case-rule-label">{String(galleryNumber).padStart(2,'0')} / {p.logo?'Materiały drukowane':'Prezentacja projektu'}</span></div><div class="case-print-heading"><h2 id="gallery-title">{p.galleryTitle || 'Projekt w szczegółach.'}</h2>{p.galleryIntro&&<p>{p.galleryIntro}</p>}</div><figure class="case-hero"><ProjectImage media={{src:p.image,smallSrc:p.imageSmall,alt:p.alt,width:p.imageWidth,height:p.imageHeight}} priority={!p.logo} sizes="(max-width: 760px) 88vw, min(85vw, 1120px)"/>{p.imageCaption&&<figcaption>{p.imageCaption}</figcaption>}</figure>{p.gallery.length>0&&<ProjectSources media={p.gallery} label={details.length>0?'Zobacz projekty i detale':'Zobacz oryginalne projekty'}/>}</section>
{p.applications&&p.applications.length>0&&<div class="case-container"><ProjectApplications applications={p.applications} startNumber={galleryNumber+1}/></div>}
<section class="case-scope case-container" aria-labelledby="scope-title">
 <div><span class="eyebrow">ZAKRES MOJEJ PRACY</span><h2 id="scope-title">{p.logo?<>Od znaku.<br/>Do materiałów.</>:'Zakres projektu.'}</h2></div>
 <div>{p.scopeItems?.length?<ul>{p.scopeItems.map((item,index)=><li><span aria-hidden="true">{String(index+1).padStart(2,'0')}</span>{item}</li>)}</ul>:<p>{p.scope}</p>}</div>
</section>
{p.video&&<section class="case-container case-video"><video controls preload="none" poster={p.video.poster} playsinline aria-label={`Film: ${p.name}`}><source src={p.video.src} type="video/mp4"/>Twoja przeglądarka nie obsługuje tego filmu.</video></section>}
{p.result&&<section class="section"><span class="eyebrow">EFEKT / POTWIERDZONE INFORMACJE</span><h2>Rezultat.</h2><p>{p.result}</p></section>}
</article>
<section class="section cta"><h2>Twój projekt<br/>może być <em>następny.</em></h2><a class="button yellow" href={`/kontakt?projekt=${encodeURIComponent(p.name)}`} data-track="portfolio_contact" data-project={p.slug}>Chcę podobny projekt <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></a></section>
</Layout>

<style>
 :global(body.project-page){--paper:#fff;--muted:#626262;--line:#dedede}
 .case-study{--accent:#bd1014;--section-space:clamp(54px,6vw,88px);--case-title:clamp(2.2rem,3.7vw,3.6rem)}
 .case-container{width:90%;max-width:1320px;margin-inline:auto}
 .case-intro{padding-block:45px 60px}
 .breadcrumb{margin-bottom:44px}
 .case-intro-grid{display:grid;grid-template-columns:1.4fr 1fr;gap:60px;align-items:end}
 .case-intro h1{font-size:clamp(4.5rem,10vw,10rem);letter-spacing:-.075em;line-height:.88}
 .case-intro .eyebrow{font-size:.63rem;margin-bottom:24px}
 .case-intro-copy p{font-size:1.05rem;max-width:440px;line-height:1.6}
 .case-credit{display:block;margin-top:22px;color:var(--muted);font-size:.7rem}
 .case-nav{display:flex;flex-wrap:wrap;gap:12px 28px;margin-top:38px;font-size:.72rem}
 .case-nav a{border-bottom:1px solid var(--line);padding-bottom:4px}
 .case-nav a:hover{border-color:var(--ink)}
 .case-logo{padding-bottom:64px}
 .case-rule{display:flex;justify-content:space-between;gap:24px;align-items:center;border-top:1px solid var(--line);padding-top:24px}
 .case-rule h2,.case-rule>span{font-size:.65rem;line-height:1.6;letter-spacing:.12em;text-transform:uppercase;font-weight:600}
 .case-rule h2,.case-rule-label{display:flex;align-items:center;gap:14px}
 .case-rule h2:before,.case-rule-label:before{content:'';width:24px;height:3px;background:var(--accent);flex-shrink:0}
 .case-rule>span{font-weight:400;color:var(--muted);text-align:right}
 figure{margin:0}
 .logo-stage{min-height:360px;display:grid;place-items:center;padding:60px 10% 40px}
 .logo-stage img{width:100%;max-width:760px}
 .logo-inverted{filter:invert(1)}
 figcaption{font-size:.68rem;line-height:1.7;color:var(--muted);padding-top:18px}
 .case-logo figcaption{text-align:center}
 .case-hero{max-width:1120px;padding-top:30px;margin-inline:auto}
 .case-hero :global(img){width:100%;max-height:760px;object-fit:contain}
 .case-hero figcaption{text-align:center}
 .case-context{display:grid;grid-template-columns:1fr 1fr;gap:10%;padding-block:0 var(--section-space)}
 .case-context h2{font-size:clamp(2rem,3.5vw,3.5rem);max-width:490px}
 .case-context p{font-size:.95rem}
 .case-context h2+p{margin-top:24px}
 .case-context .eyebrow{margin-bottom:24px}
 .case-print{padding-bottom:var(--section-space)}
 .case-print-heading{display:grid;grid-template-columns:1.2fr 1fr;gap:10%;align-items:start;margin:36px 0 20px}
 .case-print-heading h2{font-size:var(--case-title)}
 .case-print-heading p{font-size:.9rem;max-width:470px;padding-top:4px}
 .case-scope{padding-bottom:var(--section-space);display:grid;grid-template-columns:1fr 1fr;gap:10%;align-items:start}
 .case-scope h2{font-size:clamp(2rem,3.8vw,4rem);margin-bottom:32px}
 .case-scope ul{padding:0;margin:0;list-style:none}
 .case-scope li{border-top:1px solid var(--line);padding:18px 0;display:flex;gap:20px;font-size:.85rem;line-height:1.5}
 .case-scope li>span{color:var(--accent);font-size:.65rem;padding-top:3px}
 .case-video{padding-bottom:80px}
 .case-video video{width:100%}
 @media(max-width:760px){
  .case-container{width:88%}
  .case-intro{padding-block:30px 40px}
  .breadcrumb{margin-bottom:35px}
  .case-intro-grid{grid-template-columns:1fr;gap:28px}
  .case-intro h1{font-size:clamp(4.5rem,19vw,8rem)}
  .case-intro .eyebrow{font-size:.59rem;letter-spacing:.07em;margin-bottom:22px}
  .case-intro-copy p{font-size:.95rem}
  .case-credit{font-size:.65rem;margin-top:14px}
  .case-rule{gap:16px;padding-top:18px;align-items:start}
  .case-rule h2,.case-rule>span{font-size:.57rem;letter-spacing:.07em}
  .case-rule h2,.case-rule-label{gap:8px}
  .case-rule h2:before,.case-rule-label:before{width:16px}
  .logo-stage{min-height:0;padding:55px 2% 35px}
  .case-logo{padding-bottom:36px}
  figcaption{font-size:.64rem;padding-top:14px}
  .case-context{grid-template-columns:1fr;gap:32px;padding-block:0 48px}
  .case-context .eyebrow{margin-bottom:18px}
  .case-context h2{font-size:2.2rem}
  .case-context p{font-size:.9rem}
  .case-print{padding-bottom:52px}
  .case-print-heading{grid-template-columns:1fr;gap:20px;margin:28px 0 12px}
  .case-print-heading h2{font-size:2.4rem}
  .case-print-heading p{font-size:.88rem;padding:0}
  .case-hero{padding-top:22px}
  .case-scope{padding-bottom:50px;grid-template-columns:1fr;gap:24px}
  .case-scope h2{font-size:2.6rem;margin-bottom:26px}
  .case-scope li{padding-block:16px}
 }
</style>
