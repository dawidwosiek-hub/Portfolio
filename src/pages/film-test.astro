---
import Layout from '../layouts/Layout.astro';
import ScrollFilm from '../components/ScrollFilm.astro';
const captions=[
 {from:0.02,to:0.12,k:'Identyfikacja',t:'Znak, który <em>zapamiętają.</em>'},
 {from:0.16,to:0.29,k:'Druk',t:'Papier, który <em>trzyma się w rękach.</em>'},
 {from:0.39,to:0.51,k:'Wideo',t:'Film, który ogląda się <em>do końca.</em>',align:'r'},
 {from:0.61,to:0.74,k:'Reklama i oklejenia',t:'Twoja marka <em>na ulicy.</em>'},
];
const works=[
 {from:0.03,to:0.12,slug:'leasing-cartel-logo',side:'r'},
 {from:0.17,to:0.28,slug:'diverto-materialy-promocyjne',side:'r'},
 {from:0.40,to:0.50,slug:'prato-development-rolki',side:'l'},
 {from:0.62,to:0.73,slug:'bipi-detailing-bilbord',side:'r'},
];
---
<Layout title="Test: przewijany film" noindex={true}>
<ScrollFilm name="studio" captions={captions} works={works} poster="/media/film/studio/d/000.webp"/>
<section class="section"><h2>Dalsza treść strony</h2><p>Tu zaczyna się reszta strony głównej.</p></section>
</Layout>
