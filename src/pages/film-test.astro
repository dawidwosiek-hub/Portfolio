---
import Layout from '../layouts/Layout.astro';
import ScrollFilm from '../components/ScrollFilm.astro';
const captions=[
 {from:0.02,to:0.17,k:'Identyfikacja',t:'Znak, który <em>zapamiętają.</em>'},
 {from:0.23,to:0.40,k:'Druk i reklama',t:'Widać go <em>z daleka.</em>'},
 {from:0.46,to:0.62,k:'Wideo',t:'Film, który ogląda się <em>do końca.</em>'},
 {from:0.68,to:0.85,k:'Oklejenia i odzież',t:'Twoja marka <em>w ruchu.</em>'},
];
const works=[
 {from:0.04,to:0.17,slug:'leasing-cartel-logo',side:'r'},
 {from:0.25,to:0.40,slug:'bipi-detailing-bilbord',side:'r'},
 {from:0.48,to:0.62,slug:'prato-development-rolki',side:'r'},
 {from:0.70,to:0.85,slug:'mm-trans-plus-logo',side:'r'},
];
---
<Layout title="Test: przewijany film" noindex={true}>
<ScrollFilm name="studio" captions={captions} works={works} poster="/media/film/studio/d/000.webp"/>
<section class="section"><h2>Dalsza treść strony</h2><p>Tu zaczyna się reszta strony głównej.</p></section>
</Layout>
