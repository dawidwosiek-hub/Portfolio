---
import Layout from '../layouts/Layout.astro';
import ScrollFilm from '../components/ScrollFilm.astro';
const captions=[
 {from:0.02,to:0.2,k:'Identyfikacja',t:'Znak, który <em>zapamiętają.</em>'},
 {from:0.3,to:0.5,k:'Druk',t:'Papier, który <em>trzyma się w rękach.</em>'},
 {from:0.7,to:0.87,k:'Wideo',t:'Film, który ogląda się <em>do końca.</em>',align:'r'},
];
const works=[
 {from:0.03,to:0.19,slug:'leasing-cartel-logo',side:'r'},
 {from:0.31,to:0.49,slug:'diverto-materialy-promocyjne',side:'r'},
 {from:0.71,to:0.86,slug:'prato-development-rolki',side:'l'},
];
---
<Layout title="Test: przewijany film" noindex={true}>
<ScrollFilm name="studio" captions={captions} works={works} poster="/media/film/studio/d/000.webp"/>
<section class="section"><h2>Dalsza treść strony</h2><p>Tu zaczyna się reszta strony głównej.</p></section>
</Layout>
