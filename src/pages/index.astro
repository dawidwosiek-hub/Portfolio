---
import Layout from '../layouts/Layout.astro';

import Projects from '../components/Projects.astro';
import Process from '../components/Process.astro';
import CTA from '../components/CTA.astro';
import {site, services, projects} from '../lib/content';
const featured=projects.find(p=>p.name==='SHIRO') || projects[0];
const stats=site.statistics.filter(s=>s.confirmed && s.value);
const comparisons=site.comparisons.filter(c=>c.published);
---
<Layout>
<section class="hero"><div class="hero-copy"><span class="eyebrow"><i></i> DAWID WOSIEK / GRAFIKA I WIDEO</span><h1>Logo i grafika.<br/>Wideo dla<br/><em>Twojej firmy.</em></h1><p>Projektuję identyfikację, materiały reklamowe i nadruki. Montuję filmy dla firm i twórców. Zobacz realizacje i porozmawiajmy o tym, czego potrzebuje Twoja marka.</p><div class="hero-actions"><a class="button yellow" href="/realizacje">Zobacz realizacje <span aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></span></a><a class="text-link" href="/kontakt" data-track="quote_click">Zapytaj o wycenę <span aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></span></a></div><span class="location">Kraków i okolice <span>·</span> Współpraca zdalna w całej Polsce</span></div>{featured&&<figure class="hero-work"><a href={`/realizacje/${featured.slug}`}><img src={featured.image} srcset={featured.imageSmall?`${featured.imageSmall} 768w, ${featured.image} ${featured.imageWidth||1536}w`:undefined} sizes="(max-width: 760px) 88vw, 46vw" alt={featured.alt} width={featured.imageWidth} height={featured.imageHeight} fetchpriority="high"/><figcaption><span><strong>{featured.name}</strong>Logo i materiały marki</span><span>Zobacz projekt <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></span></figcaption></a><div class="hero-deliverables"><span>Logo i identyfikacja</span><span>Materiały do druku</span><span>Wideo i montaż</span></div></figure>}</section>
<div class="discipline-strip" aria-label="Specjalizacje"><span>GRAFIKA</span><i><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></i><span>FILM</span><i><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></i><span>PRODUKCJA</span><i><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></i><span class="strip-note">JEDEN SPÓJNY WIZERUNEK.</span></div>
{stats.length>0 && <section class="statistics section" aria-label="Potwierdzone statystyki">{stats.map(s=><div><strong>{s.value}</strong><span>{s.label}</span>{s.context&&<small>{s.context}</small>}</div>)}</section>}
<section class="section work-section"><div class="section-heading"><span class="eyebrow">01 / REALIZACJE</span><h2>Pomysł widać<br/>w <em>szczegółach.</em></h2><a class="text-link" href="/realizacje">Wszystkie realizacje <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></a></div><Projects featured compact/></section>
<section class="section dark services-section"><div class="section-heading"><span class="eyebrow">02 / CO MOGĘ DLA CIEBIE ZROBIĆ</span><h2>Od pierwszego znaku.<br/>Do ostatniego <em>kadru.</em></h2><p>Projektowanie, które bierze pod uwagę cały obraz. I to, co dzieje się z nim po wyjściu z ekranu.</p></div><div class="service-list">{services.map(s=><a href={`/oferta/${s.slug}`} class="service-row"><span class="service-number">{s.number}</span><div><h3>{s.title}</h3><p>{s.short}</p></div><span class="round-arrow" aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></span></a>)}</div><a class="text-link" href="/oferta">Znajdź rozwiązanie dla swojej firmy <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></a></section>
<section class="section about-teaser"><div class="about-symbol" aria-hidden="true"><img src="/brand/nadx-logo.svg" alt="" width="812" height="820" loading="lazy"/><small>DESIGN / MOTION / PRODUCTION</small></div><div><span class="eyebrow">ZA MARKĄ NADX</span><h2>Nie tylko<br/>ładny <em>obraz.</em></h2><p>{site.about}</p><a class="text-link" href="/o-mnie">Poznaj mój sposób pracy <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></a></div></section>
{comparisons.length>0&&<section class="section"><span class="eyebrow">PRZED / PO</span><h2>Zobacz, co zmienia dobry projekt.</h2>{comparisons.map(c=><div class="comparison"><h3>{c.title}</h3><div class="compare-frame"><img src={c.before} alt={c.beforeAlt} loading="lazy"/><img class="compare-after" src={c.after} alt={c.afterAlt} loading="lazy"/></div><label>Odsłonięcie gotowego projektu<input type="range" min="0" max="100" value="50" aria-label={`Porównanie: ${c.title}`}/></label></div>)}</section>}
<Process/>
{site.testimonials.filter(t=>t.consent).length>0&&<section class="section testimonials"><span class="eyebrow">GŁOS KLIENTÓW</span>{site.testimonials.filter(t=>t.consent).map(t=><figure><blockquote>{t.quote}</blockquote><figcaption>{t.author}{t.role&&` · ${t.role}`}</figcaption></figure>)}</section>}
{site.clientLogos.filter(l=>l.consent).length>0&&<section class="section client-logos" aria-label="Marki, z którymi współpracuję">{site.clientLogos.filter(l=>l.consent).map(l=><img src={l.src} alt={l.name} loading="lazy" width="160" height="80"/>)}</section>}
<CTA/>
<script>document.querySelectorAll('.comparison').forEach(el=>{el.querySelector('input')?.addEventListener('input',e=>{(el.querySelector('.compare-after') as HTMLElement).style.clipPath=`inset(0 ${100-Number((e.target as HTMLInputElement).value)}% 0 0)`;});});</script>
</Layout>

<style>
 .hero-work{margin:0;min-width:0}.hero-work img{display:block;width:100%;height:auto;aspect-ratio:3/2;object-fit:contain}.hero-work figcaption{display:flex;justify-content:space-between;align-items:center;gap:22px;padding-top:19px;border-top:1px solid #dedede;font-size:.72rem}.hero-work figcaption strong{display:block;font-size:1.15rem;letter-spacing:-.03em;line-height:1.35}.hero-work figcaption>span:first-child{color:#626262;line-height:1.8}.hero-work figcaption strong{color:#101010}.hero-work figcaption>span:last-child{display:flex;align-items:center;gap:17px;font-weight:550}.hero-work figcaption .arrow{font-size:1rem}.hero-deliverables{display:flex;gap:20px;flex-wrap:wrap;margin-top:24px;font-size:.64rem;color:#626262}.hero-deliverables span{padding-left:12px;border-left:2px solid #ffcc00}.hero-copy>p{max-width:420px}.hero h1{font-size:clamp(3rem,5.8vw,6.5rem)}@media(max-width:760px){.hero h1{font-size:clamp(2.9rem,11.5vw,5rem)}.hero-work figcaption{font-size:.67rem;padding-top:14px}.hero-work figcaption strong{font-size:1rem}.hero-deliverables{gap:12px 18px;font-size:.61rem;margin-top:18px}.hero{padding-top:36px;gap:28px}.hero .eyebrow{font-size:.56rem;letter-spacing:.09em}}
</style>
