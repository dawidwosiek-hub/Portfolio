---
import Layout from '../layouts/Layout.astro';
import Projects from '../components/Projects.astro';
import Process from '../components/Process.astro';
import CTA from '../components/CTA.astro';
import {site, services} from '../lib/content';
const film='/media/nadx/portfolio-cinematic-v2';
const tiles=[
 {href:'/realizacje/odwroceni-projekty-oklejen',src:'/media/podglad/odwroceni-c0ec4c60be97/boat-editorial.webp',small:'/media/podglad/odwroceni-c0ec4c60be97/boat-editorial-768.webp',w:1536,h:1024,name:'Odwróceni',type:'Oklejenie łodzi',alt:'Łódź z limonkowo-różową grafiką Odwróceni na jeziorze o zachodzie słońca — wizualizacja projektu oklejenia.'},
 {href:'/realizacje/shiro-logo-i-wizytowki',src:'/media/shiro/obuwie-mockup-1536.webp',small:'/media/shiro/obuwie-mockup-768.webp',w:1536,h:1024,name:'SHIRO',type:'Znak na obuwiu',alt:'Czarny but z czerwonym znakiem SHIRO na boku i czerwonymi sznurówkami — wizualizacja projektu.'},
 {href:'/realizacje/olsen-odziez-firmowa',src:'/media/olsen/czapka-baza-1536.webp',small:'/media/olsen/czapka-baza-768.webp',w:1536,h:1024,name:'OLSEN',type:'Haft na czapce',alt:'Czarna czapka z haftowanym logo OLSEN — wizualizacja projektu haftu.'},
];
---
<Layout bodyClass="home">
<section class="home-hero" aria-label="Wstęp i wybrane prace">
 <div class="hero-tile hero-intro">
  <div>
   <h1>Grafika, która wychodzi z&nbsp;ekranu.</h1>
   <p>Projektuję logo, druki, oklejenia i nadruki na odzież. Montuję filmy dla firm i twórców. Pracuję w&nbsp;Krakowie i&nbsp;zdalnie w&nbsp;całej Polsce.</p>
  </div>
  <div class="hero-actions">
   <a class="button dark" href="/kontakt" data-track="quote_click">Wyceń projekt</a>
   <a class="text-link" href="/realizacje">Zobacz realizacje</a>
   <button class="film-link" type="button" data-film-open hidden><i aria-hidden="true"></i>Film, 16 s</button>
  </div>
 </div>
 {tiles.map((t,i)=><a class="hero-tile hero-work" href={t.href}><img src={t.src} srcset={`${t.small} 768w, ${t.src} 1536w`} sizes="(max-width:760px) 100vw, 50vw" alt={t.alt} width={t.w} height={t.h} loading={i===0?'eager':'lazy'} fetchpriority={i===0?'high':undefined} decoding="async"/><span class="tile-caption"><strong>{t.name}</strong>{t.type}</span></a>)}
</section>

<section id="realizacje" class="section home-work work-section" aria-labelledby="work-title">
 <div class="section-head"><div><h2 id="work-title">Realizacje</h2><p>Oklejenia, identyfikacja, druk i odzież. Każdy projekt pokazany na nośniku, na którym ma pracować.</p></div><a class="text-link" href="/realizacje">Wszystkie realizacje</a></div>
 <Projects featured/>
</section>

<section class="section home-offer" aria-labelledby="offer-title">
 <div class="section-head"><div><h2 id="offer-title">Co mogę zrobić dla Twojej firmy</h2><p>Zakres, liczbę propozycji i formaty plików ustalamy przed rozpoczęciem pracy.</p></div><a class="text-link" href="/oferta">Pełna oferta</a></div>
 <div class="offer-grid">{services.map(s=><div class="offer-item"><h3>{s.title}</h3><p>{s.short}</p><ul>{s.deliverables.slice(0,3).map(d=><li>{d}</li>)}</ul><a class="text-link" href={`/oferta/${s.slug}`}>Szczegóły</a></div>)}</div>
</section>

<section class="section home-about" aria-labelledby="about-title">
 {site.portrait?<img class="about-photo" src={site.portrait} alt="Dawid Wosiek, NADX" width="800" height="1000" loading="lazy"/>:<div class="about-mark"><img src="/brand/nadx-logo.svg" alt="Znak NADX" width="812" height="820" loading="lazy"/></div>}
 <div><h2 id="about-title">Projekt, który da się wykonać.</h2><p>{site.about}</p><a class="text-link" href="/o-mnie">O mnie i sposobie pracy</a></div>
</section>

<Process/>
<CTA/>

<dialog class="film-dialog" aria-labelledby="film-title">
 <div class="film-bar"><h2 id="film-title">Odwróceni: od grafiki do formy</h2><button type="button" data-film-close>Zamknij</button></div>
 <video data-src={`${film}.mp4`} controls playsinline muted preload="none" poster={`${film}-poster.webp`} width="1280" height="720"></video>
</dialog>
<script>
 const dialog=document.querySelector<HTMLDialogElement>('.film-dialog');
 const open=document.querySelector<HTMLButtonElement>('[data-film-open]');
 const video=dialog?.querySelector('video');
 if(dialog&&open&&video){
  open.hidden=false;
  open.addEventListener('click',()=>{if(!video.src)video.src=video.dataset.src!;dialog.showModal();void video.play().catch(()=>{});});
  dialog.querySelector('[data-film-close]')?.addEventListener('click',()=>dialog.close());
  dialog.addEventListener('close',()=>{video.pause();open.focus({preventScroll:true});});
  dialog.addEventListener('click',e=>{if(e.target===dialog)dialog.close();});
 }
</script>
</Layout>
