---
import Layout from '../layouts/Layout.astro';
import BrandArt from '../components/BrandArt.astro';
import Projects from '../components/Projects.astro';
import Process from '../components/Process.astro';
import CTA from '../components/CTA.astro';
import {site, services} from '../lib/content';
const stats=site.statistics.filter(s=>s.confirmed && s.value);
const comparisons=site.comparisons.filter(c=>c.published);
---
<Layout>
<section class="hero"><div class="hero-copy"><span class="eyebrow"><i></i> NIEZALEŻNY DESIGN & WIDEO</span><h1>Daj swojej<br/>marce coś,<br/>co <em>przyciąga.</em></h1><p>Projektuję logo, materiały reklamowe i odzież. Tworzę filmy, które przyciągają uwagę do Twojej marki.</p><div class="hero-actions"><a class="button yellow" href="/realizacje">Zobacz realizacje <span aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></span></a><a class="text-link" href="/kontakt" data-track="quote_click">Wyceń projekt <span aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></span></a></div><span class="location">Kraków i okolice <span>·</span> Współpraca zdalna w całej Polsce</span></div><BrandArt/></section>
<div class="discipline-strip" aria-label="Specjalizacje"><span>GRAFIKA</span><i><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></i><span>FILM</span><i><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></i><span>PRODUKCJA</span><i><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></i><span class="strip-note">JEDEN SPÓJNY WIZERUNEK.</span></div>
{stats.length>0 && <section class="statistics section" aria-label="Potwierdzone statystyki">{stats.map(s=><div><strong>{s.value}</strong><span>{s.label}</span>{s.context&&<small>{s.context}</small>}</div>)}</section>}
<section class="section work-section"><div class="section-heading"><span class="eyebrow">01 / REALIZACJE</span><h2>Pomysł widać<br/>w <em>szczegółach.</em></h2><a class="text-link" href="/realizacje">Wszystkie realizacje <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></a></div><Projects featured/></section>
<section class="section dark services-section"><div class="section-heading"><span class="eyebrow">02 / CO MOGĘ DLA CIEBIE ZROBIĆ</span><h2>Od pierwszego znaku.<br/>Do ostatniego <em>kadru.</em></h2><p>Projektowanie, które bierze pod uwagę cały obraz. I to, co dzieje się z nim po wyjściu z ekranu.</p></div><div class="service-list">{services.map(s=><a href={`/oferta/${s.slug}`} class="service-row"><span class="service-number">{s.number}</span><div><h3>{s.title}</h3><p>{s.short}</p></div><span class="round-arrow" aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></span></a>)}</div><a class="text-link" href="/oferta">Znajdź rozwiązanie dla swojej firmy <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></a></section>
<section class="section about-teaser"><div class="about-symbol" aria-hidden="true"><img src="/brand/nadx-logo.svg" alt="" width="812" height="820" loading="lazy"/><small>DESIGN / MOTION / PRODUCTION</small></div><div><span class="eyebrow">ZA MARKĄ NADX</span><h2>Nie tylko<br/>ładny <em>obraz.</em></h2><p>{site.about}</p><a class="text-link" href="/o-mnie">Poznaj mój sposób pracy <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></a></div></section>
{comparisons.length>0&&<section class="section"><span class="eyebrow">PRZED / PO</span><h2>Zobacz, co zmienia dobry projekt.</h2>{comparisons.map(c=><div class="comparison"><h3>{c.title}</h3><div class="compare-frame"><img src={c.before} alt={c.beforeAlt} loading="lazy"/><img class="compare-after" src={c.after} alt={c.afterAlt} loading="lazy"/></div><label>Odsłonięcie gotowego projektu<input type="range" min="0" max="100" value="50" aria-label={`Porównanie: ${c.title}`}/></label></div>)}</section>}
<Process/>
{site.testimonials.filter(t=>t.consent).length>0&&<section class="section testimonials"><span class="eyebrow">GŁOS KLIENTÓW</span>{site.testimonials.filter(t=>t.consent).map(t=><figure><blockquote>{t.quote}</blockquote><figcaption>{t.author}{t.role&&` · ${t.role}`}</figcaption></figure>)}</section>}
{site.clientLogos.filter(l=>l.consent).length>0&&<section class="section client-logos" aria-label="Marki, z którymi współpracuję">{site.clientLogos.filter(l=>l.consent).map(l=><img src={l.src} alt={l.name} loading="lazy" width="160" height="80"/>)}</section>}
<CTA/>
<script>document.querySelectorAll('.comparison').forEach(el=>{el.querySelector('input')?.addEventListener('input',e=>{(el.querySelector('.compare-after') as HTMLElement).style.clipPath=`inset(0 ${100-Number((e.target as HTMLInputElement).value)}% 0 0)`;});});</script>
</Layout>
