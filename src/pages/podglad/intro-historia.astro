  const P2=()=>kf([[T.drop0,V(.15,.35,3.4),V(0,-.05,0)],[T.drop1,V(.5,.55,3.5),V(0,-1.25,0)],[T.tape1,V(.6,.5,3.7),V(0,-1.25,0)],[T.van1,V(1.4,.5,6.8),V(.9,-1.1,-1.0)],[T.drv0,V(1.4,.5,6.8),V(1.0,-1.1,-1.2)]]);
  const vp=van.position,pl=plane.position;
  const P3=()=>{const s=seg(t,T.drv1-.5,T.cargo1);return {P:vp.clone().add(V(-1.0+1.8*s,1.9+.4*s,6.4+2.2*s)),L:vp.clone().add(V(1.2+2.6*s,.5,-.8*s))};};
  const P4=()=>({P:pl.clone().add(V(-5.5,1.4,8.5)),L:pl.clone().add(V(2,.3,0))});
  const P5=()=>{const a=(t-T.glb0)*.35;return {P:Gc(Math.sin(a)*1.2,.7,6.6),L:Gc(0,0,0)};};
  const P6=()=>kf([[T.door0,D(0,.3,5.2),D(0,-.6,-.6)],[T.dOpen0,D(0,.1,4.3),D(0,-.8,-.6)],[T.bOpen1,D(.3,0,3.7),D(0,-.75,-.3)],[T.rise1,D(0,.35,4.2),D(0,.15,0)],[T.back1,D(0,-.05,6.0),D(0,-.55,0)]]);
  const phases=[[T.sq1,P1,0],[T.drop0,P2,0],[T.drv0,P3,.45],[T.take0,P4,.6],[T.glb0,P5,0],[T.door0,P6,0]];
  let k=0;for(let i=0;i<phases.length;i++)if(t>=phases[i][0])k=i;
  let r=phases[k][1]();
  if(k>0&&phases[k][2]>0){const w=eio((t-phases[k][0])/phases[k][2]);if(w<1){const o=phases[k-1][1]();r={P:o.P.lerp(r.P,w),L:o.L.lerp(r.L,w)};}}
  P=r.L.clone().add(r.P.clone().sub(r.L).multiplyScalar(fit));L=r.L;
  if(t>=T.back0&&IDLE>0){const w=Math.min(1,IDLE/2);P.x+=Math.sin(IDLE*.22)*.9*w;L.x+=Math.sin(IDLE*.22)*.25*w;P.y+=Math.sin(IDLE*.17)*.12*w;}
 }
 // ręczna kamera
 P.x+=Math.sin(t*.7)*.04;P.y+=Math.sin(t*.53+1)*.03;
 cam.position.copy(P);cam.lookAt(L);if(KICK)cam.rotateZ(KICK*.018);KICK=0;
}

// ---------------- scena w czasie t ----------------
let capI=-1;
function update(t){
 pU.uTime.value=t;bgMat.uniforms.uT.value=t;eU.uT.value=t;
 // 1
 pU.uG.value=eio(seg(t,T.gather0,T.gather1));pU.uFade.value=1-seg(t,T.crisp0+.25,T.crisp1+.1);pts.visible=t<T.crisp1+.2;
 logoMat.opacity=eo(seg(t,T.crisp0,T.crisp1));logo.visible=logoMat.opacity>0;
 bloom.strength=lerp(.9,0,seg(t,T.crisp0,T.crisp1))+.0;bloom.threshold=.82;
 // 2: obrót 180°, kwadrat → księga
 const r=eio(seg(t,T.rot0,T.rot1));G.rotation.y=r*PI+Math.sin(r*PI)*.15;G.rotation.x=Math.sin(r*PI)*.12;
 const morph=eio(seg(t,T.rot0,T.rot0+.6));
 logo.scale.set(lerp(LS,BW,morph),lerp(LS,BH,morph),lerp(.02,BT,morph));
 const showBook=G.rotation.y>PI/2;logo.visible=logo.visible&&!showBook;book.visible=showBook&&t<T.burn1+.1;
 const pop=1+Math.sin(seg(t,T.rot1-.3,T.rot1+.25)*PI)*.06;G.scale.setScalar(pop);
 // okładka i kartka
 const open=eio(seg(t,T.open0,T.open1))*(1-eio(seg(t,T.close0,T.close1)));hinge.rotation.y=-open*PI*.985;
 const fp=eio(seg(t,T.flip0,T.flip1));pageHinge.visible=t>T.flip0&&t<T.close0;if(pageHinge.visible)bendPage(fp);
 pageRightM.map=t>=T.flip0+.05?(pageRightM.userData.s2||(pageRightM.userData.s2=half(tS2,true))):(pageRightM.userData.s1||(pageRightM.userData.s1=pageRightM.map));
 // 3: spalanie
 burnU.uBurn.value=seg(t,T.burn0,T.burn1);fireL.intensity=Math.sin(seg(t,T.burn0,T.burn1)*PI)*9*(0.85+.15*Math.sin(t*23.));
 bgMat.uniforms.uWarm.value=Math.sin(seg(t,T.burn0,T.burn1)*PI);
 embers.visible=t>T.burn0&&t<T.burn1+2.2;
 if(t>T.burn0&&t<T.burn1)bloom.strength=.75;else if(t>=T.burn1)bloom.strength=Math.max(0,.75-(t-T.burn1)*1.2);
 poster.visible=t>T.burn0&&t<T.card0+(T.card1-T.card0)/2;
 // 4: składanie
 fU.uF1.value=eio(seg(t,T.f10,T.f11));fU.uF2.value=eio(seg(t,T.f20,T.f21));fU.uF3.value=eio(seg(t,T.f30,T.f31));
 const c1=[0,-PH/4],c2=[-PW/4,-PH/4],c3=[-PW/4,-PH*3/8];
 let cx=lerp(0,c1[0],fU.uF1.value),cy=lerp(0,c1[1],fU.uF1.value);cx=lerp(cx,c2[0],fU.uF2.value);cy=lerp(cy,c2[1],fU.uF2.value);cx=lerp(cx,c3[0],fU.uF3.value);cy=lerp(cy,c3[1],fU.uF3.value);
 poster.position.set(-cx,-cy,0);
 // wizytówka: obrót, w połowie zamiana
 const cr=eio(seg(t,T.card0,T.card1)),sr=eio(seg(t,T.sq0,T.sq1));
 holder.rotation.y=cr*PI+sr*PI;holder.rotation.x=Math.sin(cr*PI)*.25-Math.sin(sr*PI)*.2;
 const ph=t<T.card0+(T.card1-T.card0)/2?0:(t<T.sq0+(T.sq1-T.sq0)/2?1:2);
 poster.visible=poster.visible&&ph===0;card.visible=ph===1;
 const cs=1+.12*Math.sin(seg(t,T.card1-.15,T.card1+.4)*PI);card.scale.setScalar(cs);
 sq.scale.set(.9,.9,1);
 // 5: historia produktu
 sq.visible=ph===2&&t<T.logo0;
 const SH=t>=T.ship0;
 // cząstki → koszulka
 teePts.visible=SH&&t<T.teeS1+.3;tU.uTime.value=t;tU.uPx.value=pU.uPx.value;
 tU.uG.value=eio(seg(t,T.ship0,T.teeG1));tU.uFade.value=1-seg(t,T.teeS0+.2,T.teeS1+.25);
 const h=t>=T.rise0?1:eio(seg(t,T.hood0,T.hood1)),f=t>=T.rise0?0:eio(seg(t,T.fold0,T.fold1));
 const inBox=t>=T.close1&&t<T.rise0;
 garment.visible=SH&&t>=T.logo0&&!inBox;
 if(garment.visible){
  const folded=t>=T.flipA&&t<T.rise0;
  garMesh.visible=!folded;foldTop.visible=foldHinge.visible=folded;
  if(!folded)garShape(h,f);
  foldHinge.rotation.x=eio(seg(t,T.flipA,T.flipB))*PI*.985;
  const op=t>=T.rise0?1:eo(seg(t,T.teeS0,T.teeS1));garM.transparent=op<1;garM.opacity=op;
  garM.color.setHex(0x1e1e21).lerp(new THREE.Color(0x3a3d43),h);
  lineM.opacity=folded?0:(t>=T.rise0?.35:lerp(.95,.4,seg(t,T.teeS1,T.hood0)))*cl((t-T.ship0)/.4);
  const hd=folded?0:Math.pow(h,4)*(1-f);hoodOpen.scale.set(.14*hd+1e-3,.17*hd+1e-3,1);strings.scale.set(1,hd+1e-3,1);pocket.scale.set(hd+1e-3,hd+1e-3,1);
  // logo: z kwadratu na piersi
  const le=eio(seg(t,T.logo0,T.logo1));const ly=lerp(lerp(.30,.20,h),.18,f),ls=lerp(.34,.3,f);
  decal.position.set(0,lerp(0,ly,le),GD/2+.02+Math.sin(le*PI)*.5);decal.scale.setScalar(lerp(.9,ls,le));decal.rotation.z=Math.sin(le*PI)*.5;
  // ruch odzieży
  if(t<T.rise0){
   const a=eio(seg(t,T.drop0,T.drop0+.4)),b=eio(seg(t,T.drop0+.35,T.drop1));
   garment.rotation.set(-PI/2*a,Math.sin(seg(t,T.teeS1,T.fold0)*PI*2)*.28*(1-a),0);
   garment.position.set(0,lerp(lerp(0,-.7,a),GROUND+.06,b),lerp(0,.175,a));garment.scale.setScalar(1);
  }else{
   const r=seg(t,T.rise0,T.rise1);garment.rotation.set(0,Math.sin(r*PI)*.5+Math.sin(IDLE*.5)*.35,0);
   garment.position.set(DC.x,lerp(GROUND+.3,.3,eo(r)),DC.z+lerp(-.35,.1,eo(r)));garment.scale.setScalar(lerp(.25,.82,eoBack(r)));
  }
 }
 // świat
 world.visible=t>=T.drop0-.3&&t<T.glb0;const wo=seg(t,T.drop0-.3,T.drop0+.6);[ground.material,road.material,runway.material,dashM,lightM].forEach(m=>m.opacity=wo);
 // karton
 box.visible=(t>=T.drop0-.25&&t<T.load1)||(t>=T.cargo0&&t<T.cargo1)||t>=T.drop2a;
 const vanX=t<T.van1?lerp(-9,1.6,eo(seg(t,T.van0,T.van1))):lerp(1.6,21.2,eio(seg(t,T.drv0,T.drv1)));
 van.visible=t>=T.van0&&t<T.glb0;van.position.set(vanX,GROUND,-1.8);wheels.forEach(w=>w.rotation.y=-vanX/.22);
 const rear=new THREE.Vector3(vanX-1.0,GROUND+.3,-1.8);
 const tau=Math.max(0,t-T.take0);
 plane.visible=t>=T.drv0&&t<T.glb0;plane.position.set(26+7*tau*tau,GROUND+.55+(tau>.6?4.2*(tau-.6)*(tau-.6):0),-3.6);plane.rotation.z=.26*seg(tau,.5,1.0);
 if(box.visible){
  box.rotation.set(0,0,0);let bs=1;
  if(t<T.load0){box.position.set(0,GROUND,0);bs=eoBack(seg(t,T.drop0-.25,T.drop0+.15));}
  else if(t<T.load1){const s=eio(seg(t,T.load0,T.load1));box.position.set(lerp(0,rear.x,s),lerp(GROUND,rear.y,s)+Math.sin(s*PI)*1.1,lerp(0,rear.z,s));bs=lerp(1,.55,s);box.rotation.z=s*PI*.5;}
  else if(t<T.cargo1){const s=eio(seg(t,T.cargo0,T.cargo1));const to=plane.position.clone().add(new THREE.Vector3(-.8,-.1,.4));box.position.set(lerp(rear.x,to.x,s),lerp(rear.y,to.y,s)+Math.sin(s*PI)*1.2,lerp(rear.z,to.z,s));bs=lerp(.55,.35,s);box.rotation.y=s*PI;}
  else{const e=seg(t,T.drop2a,T.drop2b);const bo=Math.sin(seg(t,T.drop2b,T.drop2b+.25)*PI)*.12;box.position.set(DC.x,GROUND+2.6*(1-ei(e))+bo,DC.z-.35);box.rotation.y=(1-e)*1.2;}
  box.scale.setScalar(Math.max(.001,bs));
  const cs=t<T.cargo0?eio(seg(t,T.close0,T.close0+.25)):1,cf=t<T.cargo0?eio(seg(t,T.close0+.15,T.close1)):1;
  let op={s:1-cs,f:1-cf};if(t>=T.drop2a){const o=eio(seg(t,T.bOpen0,T.bOpen1));op={s:o,f:o};}
  flaps(op);tape.scale.set(1,1,t>=T.drop2a?Math.max(.001,1-seg(t,T.bOpen0-.15,T.bOpen0)):Math.max(.001,eio(seg(t,T.tape0,T.tape1))));tape.visible=tape.scale.z>.01;
 }
 // glob
 globe.visible=t>=T.glb0-.05&&t<T.door0+.05;
 if(globe.visible){const p=eio(seg(t,T.glb0+.15,T.glb1-.4));rTube.geometry.setDrawRange(0,Math.floor(p*160)*8*6);
  globe.rotation.y=(t-T.glb0)*.06;
  const pp=rCurve.getPoint(Math.min(p,.999)),pn=rCurve.getPoint(Math.min(p+.01,1));const m4=new THREE.Matrix4().lookAt(pn,pp,pp.clone().normalize());miniPlane.position.copy(pp);miniPlane.quaternion.setFromRotationMatrix(m4);
  miniPlane.visible=p<.995;const rp=seg(t,T.glb1-.45,T.glb1);ringB.scale.setScalar(1+rp*3);ringB.material.opacity=rp>0?1-rp:0;}
 // drzwi
 door.visible=t>=T.door0-.05;
 if(door.visible){const o=eio(seg(t,T.dOpen0,T.dOpen1));leafP.rotation.y=-1.75*o;warm.intensity=10*o;}
 // zaciemnienia między scenami
 const bump=(c)=>cl(1-Math.abs(t-c)/.28);fadeM.opacity=Math.max(bump(T.glb0),bump(T.door0));fader.visible=fadeM.opacity>0;
 if(SH){bloom.strength=globe.visible?.45:(t>=T.door0?.25:0);bloom.threshold=globe.visible?.55:.85;}
 bgMat.uniforms.uA.value=t>T.drop0-.3?lerp(1,.45,seg(t,T.drop0-.3,T.drop0+.6)):1;
 // napisy
 let ci=0;for(let k=0;k<CAPS.length;k++)if(t>=CAPS[k][0])ci=k;
 if(ci!==capI){capI=ci;const c=$('#cap');c.classList.remove('on');const [_,n,txt]=CAPS[ci];setTimeout(()=>{if(!txt)return;c.querySelector('span').innerHTML=`<b>${n}</b>&nbsp;&nbsp;${txt}`;c.classList.add('on');},180);}
 document.body.classList.toggle('end',t>=T.back1-.2);
 $('#prog').style.width=(cl(t/T.END)*100)+'%';
 camAt(t);
}

// ---------------- pętla ----------------
let t0=performance.now(),t=0,playing=true,sent=false,paused=false;const SPEED=1.38;
addEventListener('message',e=>{if(e.data==='nadx-pause')paused=true;if(e.data==='nadx-play')paused=false;});const EMBED=qs.has('embed');if(EMBED)document.querySelectorAll('.bar').forEach(b=>b.style.display='none');
if(EMBED){document.querySelectorAll('#fin a').forEach(a=>a.target='_top');}
const startAll=()=>{t0=performance.now();IDLE=0;playing=true;sent=false;document.body.classList.remove('end');};
$('#again').addEventListener('click',startAll);
const ready=Promise.race([new Promise(r=>setTimeout(r,9000)),Promise.all(ALLT.map(x=>new Promise(r=>{if(x.image&&x.image.complete)r();else{const i=setInterval(()=>{if(x.image&&x.image.complete){clearInterval(i);r();}},50);}})))]);
let frames=0,acc=0;
let pauseAt=0;
function loop(now){requestAnimationFrame(loop);
 if(paused&&FORCE===null){pauseAt=pauseAt||now;return;}if(pauseAt){t0+=now-pauseAt;pauseAt=0;}
 if(FORCE!==null){t=Math.min(FORCE,T.END);IDLE=Math.max(0,FORCE-T.END);}else if(playing){t=(now-t0)/1000*SPEED;if(t>T.END){IDLE=(t-T.END)/SPEED;t=T.END;if(EMBED&&!sent){sent=true;parent.postMessage('nadx-intro-end','*');}}}
 update(t);composer.render();
 if(qs.has('hud')){frames++;acc+=1;const h=$('#hud');h.hidden=false;h.textContent=t.toFixed(2)+'s';}
}
ready.then(()=>{ALLT.forEach(x=>{try{gl.initTexture(x)}catch(e){}});t0=performance.now();requestAnimationFrame(loop);if(EMBED)parent.postMessage('nadx-intro-ready','*');});
window.__setT=v=>{update(v);composer.render();};
</script>
