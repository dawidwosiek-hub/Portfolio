const eo=x=>1-Math.pow(1-cl(x),3), ei=x=>{x=cl(x);return x*x*x;};
const eoBack=x=>{x=cl(x);const c1=1.4,c3=c1+1;return 1+c3*Math.pow(x-1,3)+c1*Math.pow(x-1,2);};
const lerp=(a,b,t)=>a+(b-a)*t;
const PI=Math.PI;

// ---------------- oś czasu ----------------
const T={gather0:.15,gather1:2.3,crisp0:2.35,crisp1:3.05,rot0:3.35,rot1:4.55,open0:4.8,open1:5.45,flip0:5.65,flip1:6.35,close0:6.6,close1:7.15,
 burn0:7.3,burn1:9.2,f10:9.55,f11:10.1,f20:10.2,f21:10.75,f30:10.85,f31:11.4,card0:11.6,card1:12.35,sq0:12.95,sq1:13.65,
 ship0:13.7,teeG1:14.6,teeS0:14.4,teeS1:14.9,logo0:14.45,logo1:15.0,hood0:15.3,hood1:16.15,fold0:16.4,fold1:16.85,flipA:16.9,flipB:17.3,drop0:17.4,drop1:18.05,close0:18.05,close1:18.45,tape0:18.45,tape1:18.7,van0:18.45,van1:19.3,load0:19.35,load1:19.8,drv0:19.85,drv1:21.1,cargo0:21.1,cargo1:21.5,take0:21.55,glb0:23.0,glb1:24.9,door0:24.9,drop2a:25.0,drop2b:25.45,dOpen0:25.45,dOpen1:25.95,bOpen0:25.95,bOpen1:26.25,rise0:26.1,rise1:26.9,back0:26.9,back1:27.9,END:28.5};
const CAPS=[[0,'01','Znak'],[3.3,'02','Księga znaku'],[7.25,'03','Plakat'],[11.55,'04','Wizytówka'],[13.7,'05','Koszulka'],[15.3,'06','Bluza'],[16.4,'07','Pakowanie'],[18.45,'08','Kurier'],[21.1,'09','Eksport'],[24.9,'10','Dostawa do klienta'],[26.9,'','']];

// ---------------- renderer ----------------
const canvas=$('#gl');
const gl=new THREE.WebGLRenderer({canvas,antialias:true,powerPreference:'high-performance'});
gl.outputColorSpace=THREE.SRGBColorSpace;gl.toneMapping=THREE.ACESFilmicToneMapping;gl.toneMappingExposure=1.0;
const DPR=Math.min(devicePixelRatio||1,innerWidth<800?1.5:1.6);gl.setPixelRatio(DPR);
const scene=new THREE.Scene();
const cam=new THREE.PerspectiveCamera(35,1,.05,120);
const texL=new THREE.TextureLoader();
const ALLT=[];const tex=(u,srgb=true)=>{const t=texL.load(u);ALLT.push(t);if(srgb)t.colorSpace=THREE.SRGBColorSpace;t.anisotropy=gl.capabilities.getMaxAnisotropy();return t;};
const M='/media/intro/';
const tLogo=tex(M+'logo.webp'),tCover=tex(M+'book-cover.webp'),tS1=tex(M+'book-spread1.webp'),tS2=tex(M+'book-spread2.webp'),tPoster=tex(M+'poster.webp'),tCard=tex(M+'card.webp'),tPaper=tex(M+'paper.webp?v=2');
const half=(t,right)=>{const c=t.clone();c.repeat.set(.5,1);c.offset.set(right?.5:0,0);c.needsUpdate=true;return c;};

// tło: ciemne studio z miękkim światłem
const bgMat=new THREE.ShaderMaterial({depthWrite:false,depthTest:false,uniforms:{uA:{value:1},uT:{value:0},uWarm:{value:0}},
 vertexShader:`varying vec2 v;void main(){v=uv;gl_Position=vec4(position.xy,.9999,1.);}`,
 fragmentShader:`varying vec2 v;uniform float uA,uT,uWarm;
 float h(vec2 p){return fract(sin(dot(p,vec2(12.9898,78.233)))*43758.5453);}
 void main(){vec2 p=v-vec2(.5,.56);float r=length(p*vec2(1.6,1.));
  vec3 c=mix(vec3(.085,.08,.075),vec3(.012),smoothstep(.0,.75,r));
  c+=vec3(.9,.45,.12)*uWarm*.22*exp(-pow(length(p*vec2(1.2,1.6)),2.)*5.);
  c*=uA;c+=(h(gl_FragCoord.xy+uT)-.5)/255.;gl_FragColor=vec4(c,1.);}`});
const bg=new THREE.Mesh(new THREE.PlaneGeometry(2,2),bgMat);bg.frustumCulled=false;bg.renderOrder=-10;scene.add(bg);

// światła
scene.add(new THREE.HemisphereLight(0xfff4e6,0x1a1612,.9));
const key=new THREE.DirectionalLight(0xffffff,2.2);key.position.set(2.5,3.5,5);scene.add(key);
const rim=new THREE.DirectionalLight(0xffd28a,1.4);rim.position.set(-4,2,-3);scene.add(rim);
const fireL=new THREE.PointLight(0xff7a1a,0,6,2);fireL.position.set(0,-.6,1.2);scene.add(fireL);

// ---------------- 1. cząstki → kwadrat ----------------
const N=innerWidth<800?14000:28000, LS=1.9; // rozmiar kwadratu (świat)
const pos=new Float32Array(N*3),tgt=new Float32Array(N*3),col=new Float32Array(N*3),rnd=new Float32Array(N*4);
for(let i=0;i<N;i++){
 const r=2.2+Math.pow(Math.random(),.6)*7,a=Math.random()*PI*2,y=(Math.random()-.5)*(2+r*.5);
 pos.set([Math.cos(a)*r,y,Math.sin(a)*r*.6-1.5],i*3);rnd.set([Math.random(),Math.random(),Math.random(),Math.random()],i*4);
}
const pgeo=new THREE.BufferGeometry();
pgeo.setAttribute('position',new THREE.BufferAttribute(pos,3));pgeo.setAttribute('aT',new THREE.BufferAttribute(tgt,3));
pgeo.setAttribute('aC',new THREE.BufferAttribute(col,3));pgeo.setAttribute('aR',new THREE.BufferAttribute(rnd,4));
const pU={uG:{value:0},uTime:{value:0},uFade:{value:1},uPx:{value:600}};
const pmat=new THREE.ShaderMaterial({uniforms:pU,transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,
 vertexShader:`attribute vec3 aT,aC;attribute vec4 aR;uniform float uG,uTime,uFade,uPx;varying vec3 vC;varying float vA;
 void main(){float d=smoothstep(0.,1.,clamp((uG-aR.w*.35)/.65,0.,1.));
  vec3 p=position;float a=uTime*.15*(.5+aR.y);p.xz=mat2(cos(a),-sin(a),sin(a),cos(a))*p.xz;
  vec3 sw=vec3(sin(uTime*1.3+aR.x*6.28),cos(uTime*1.1+aR.y*6.28),sin(uTime*.9+aR.z*6.28));
  p+=sw*.25;
  vec3 q=mix(p,aT,d)+sw*.6*sin(d*3.1416)*(1.-d);
  vC=mix(vec3(1.,.62,.15)*.6,aC*1.15,d);vA=(.35+.65*d)*uFade;
  vec4 mv=modelViewMatrix*vec4(q,1.);gl_PointSize=max(1.2,mix(.03,.016,d)*uPx/-mv.z);gl_Position=projectionMatrix*mv;}`,
 fragmentShader:`varying vec3 vC;varying float vA;void main(){vec2 c=gl_PointCoord-.5;float a=smoothstep(.5,.1,length(c))*vA;if(a<.01)discard;gl_FragColor=vec4(vC*a,a);}`});
const pts=new THREE.Points(pgeo,pmat);pts.frustumCulled=false;scene.add(pts);
// próbkowanie całego znaku (żółte tło + czarne litery jako ciemne cząstki)
{const im=new Image();im.onload=()=>{const S=360,cv=document.createElement('canvas');cv.width=cv.height=S;const c=cv.getContext('2d');c.drawImage(im,0,0,S,S);
 const d=c.getImageData(0,0,S,S).data;
 for(let i=0;i<N;i++){const x=Math.random()*S|0,y=Math.random()*S|0,o=(y*S+x)*4;const dark=d[o]<80;
  tgt.set([(x/S-.5)*LS,-(y/S-.5)*LS,(Math.random()-.5)*.02],i*3);
  col.set(dark?[.05,.04,.03]:[1,.78,.05],i*3);}
 pgeo.attributes.aT.needsUpdate=true;pgeo.attributes.aC.needsUpdate=true;};im.src=M+'logo.webp';}

// ---------------- 2. znak → księga ----------------
const G=new THREE.Group();scene.add(G);
const BW=1.6,BH=2.262,BT=.24;
const logoMat=new THREE.MeshStandardMaterial({map:tLogo,roughness:.55,metalness:0,transparent:true,opacity:0});
const logoEdge=new THREE.MeshStandardMaterial({color:0xffcc00,roughness:.6});
const logo=new THREE.Mesh(new THREE.BoxGeometry(1,1,1),[logoEdge,logoEdge,logoEdge,logoEdge,logoMat,logoEdge]);
logo.scale.set(LS,LS,.02);G.add(logo);
const bookRoot=new THREE.Group();bookRoot.rotation.y=PI;G.add(bookRoot);
// shader spalania wstrzykiwany do materiałów księgi
const burnU={uBurn:{value:0},uY0:{value:-BH/2},uY1:{value:BH/2}};
const BURN_GLSL=`float bh(vec3 p){p=fract(p*.3183099+.1);p*=17.;return fract(p.x*p.y*p.z*(p.x+p.y+p.z));}
 float bn(vec3 x){vec3 i=floor(x),f=fract(x);f=f*f*(3.-2.*f);return mix(mix(mix(bh(i),bh(i+vec3(1,0,0)),f.x),mix(bh(i+vec3(0,1,0)),bh(i+vec3(1,1,0)),f.x),f.y),mix(mix(bh(i+vec3(0,0,1)),bh(i+vec3(1,0,1)),f.x),mix(bh(i+vec3(0,1,1)),bh(i+vec3(1,1,1)),f.x),f.y),f.z);}
 float bf(vec3 p){return bn(p)*.55+bn(p*2.1)*.3+bn(p*4.3)*.15;}`;
function burnable(mat){mat.onBeforeCompile=sh=>{Object.assign(sh.uniforms,burnU);
 sh.vertexShader=sh.vertexShader.replace('#include <common>','#include <common>\nvarying vec3 vBP;').replace('#include <begin_vertex>','#include <begin_vertex>\nvBP=(modelMatrix*vec4(transformed,1.)).xyz;');
 sh.fragmentShader=sh.fragmentShader.replace('#include <common>',`#include <common>\nvarying vec3 vBP;uniform float uBurn,uY0,uY1;\n${BURN_GLSL}`)
 .replace('#include <map_fragment>',`#include <map_fragment>\nfloat yn=(vBP.y-uY0)/(uY1-uY0);float bv=yn*.85+bf(vBP*3.2)*.55;float th=uBurn*1.55-.12;
  if(bv<th)discard;float edge=1.-smoothstep(0.,.07,bv-th);float charr=1.-smoothstep(.05,.2,bv-th);diffuseColor.rgb*=1.-charr*.85*step(.001,uBurn);`)
 .replace('#include <emissivemap_fragment>',`#include <emissivemap_fragment>\ntotalEmissiveRadiance+=vec3(1.,.42,.06)*edge*6.*step(.001,uBurn)+vec3(1.,.8,.4)*pow(edge,6.)*8.*step(.001,uBurn);`);};
 mat.customProgramCacheKey=()=>'burn';return mat;}
const coverOut=burnable(new THREE.MeshStandardMaterial({map:tCover,roughness:.7}));
const coverIn=burnable(new THREE.MeshStandardMaterial({map:half(tS1,false),roughness:.85}));
const darkM=burnable(new THREE.MeshStandardMaterial({color:0x141414,roughness:.75}));
const pageEdge=(()=>{const c=document.createElement('canvas');c.width=16;c.height=256;const x=c.getContext('2d');for(let i=0;i<256;i++){const v=225+((i*37)%23);x.fillStyle=`rgb(${v},${v-3},${v-10})`;x.fillRect(0,i,16,1);}const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;t.wrapS=t.wrapT=THREE.RepeatWrapping;t.repeat.set(1,6);return t;})();
const edgeM=burnable(new THREE.MeshStandardMaterial({map:pageEdge,roughness:.9}));
const pageRightM=burnable(new THREE.MeshStandardMaterial({map:half(tS1,true),roughness:.85}));
const book=new THREE.Group();bookRoot.add(book);
const back=new THREE.Mesh(new THREE.BoxGeometry(BW,BH,.025),darkM);back.position.z=-BT/2;book.add(back);
const block=new THREE.Mesh(new THREE.BoxGeometry(BW-.05,BH-.07,BT-.05),[edgeM,edgeM,edgeM,edgeM,pageRightM,edgeM]);block.position.set(.01,0,0);book.add(block);
const spine=new THREE.Mesh(new THREE.BoxGeometry(.03,BH,BT),darkM);spine.position.set(-BW/2,0,0);book.add(spine);
const hinge=new THREE.Group();hinge.position.set(-BW/2,0,BT/2);book.add(hinge);
const cover=new THREE.Mesh(new THREE.BoxGeometry(BW,BH,.025),[darkM,darkM,darkM,darkM,coverOut,coverIn]);cover.position.set(BW/2,0,0);hinge.add(cover);
// kartka przewracana (zgięcie liczone na CPU)
const PG=new THREE.PlaneGeometry(BW-.06,BH-.08,40,1);PG.translate((BW-.06)/2,0,0);
const pgBase=PG.attributes.position.array.slice();
const pageFront=burnable(new THREE.MeshStandardMaterial({map:half(tS1,true),roughness:.85,side:THREE.FrontSide}));
const pageBack=burnable(new THREE.MeshStandardMaterial({map:half(tS2,false),roughness:.85,side:THREE.BackSide}));
const pageHinge=new THREE.Group();pageHinge.position.set(-BW/2+.02,0,BT/2-.015);book.add(pageHinge);
const pageA=new THREE.Mesh(PG,pageFront),pageB=new THREE.Mesh(PG,pageBack);pageHinge.add(pageA,pageB);pageHinge.visible=false;
pageBack.map.repeat.x=-.5;pageBack.map.offset.x=.5;pageBack.map.needsUpdate=true;
function bendPage(p){const a=PG.attributes.position.array,w=BW-.06,n=41;const curl=Math.sin(p*PI)*1.1;
 let px=0,pz=0;for(let i=0;i<n;i++){const s=i/(n-1);const ang=p*PI+curl*(s-.5)*.9*(1-p*.2);
  if(i>0){const ds=w/(n-1);px+=Math.cos(ang)*ds;pz+=Math.sin(ang)*ds;}
  for(const k of [i,i+n]){a[k*3]=px;a[k*3+2]=pz;}}
 PG.attributes.position.needsUpdate=true;PG.computeVertexNormals();}
// żar
const EN=1600,eGeo=new THREE.BufferGeometry(),eA=new Float32Array(EN*4);
for(let i=0;i<EN;i++)eA.set([Math.random(),Math.random(),Math.random(),Math.random()],i*4);
eGeo.setAttribute('position',new THREE.BufferAttribute(new Float32Array(EN*3),3));eGeo.setAttribute('aR',new THREE.BufferAttribute(eA,4));
const eU={uT:{value:0},uB0:{value:T.burn0},uB1:{value:T.burn1},uPx:{value:600},uW:{value:BW},uH:{value:BH}};
const eMat=new THREE.ShaderMaterial({uniforms:eU,transparent:true,depthWrite:false,blending:THREE.AdditiveBlending,
 vertexShader:`attribute vec4 aR;uniform float uT,uB0,uB1,uPx,uW,uH;varying float vA;varying vec3 vC;
 void main(){float born=mix(uB0,uB1-.2,aR.x);float age=uT-born;float life=.9+aR.y*1.1;
  float k=clamp((born-uB0)/(uB1-uB0),0.,1.);float fy=-uH/2.+uH*clamp(k*1.55-.12,0.,1.)/.85;
  vec3 p=vec3((aR.z-.5)*uW,fy,(aR.w-.5)*.3);
  p.y+=age*(.6+aR.y*.9)+age*age*.3;p.x+=sin(age*3.+aR.z*20.)*.12*age;p.z+=age*.5*(aR.w-.3);
  vA=step(0.,age)*(1.-smoothstep(life*.4,life,age))*step(uB0,uT);
  vC=mix(vec3(1.,.35,.03),vec3(1.,.85,.5),aR.y);
  vec4 mv=modelViewMatrix*vec4(p,1.);gl_PointSize=max(1.,(.012+aR.w*.02)*uPx/-mv.z);gl_Position=projectionMatrix*mv;}`,
 fragmentShader:`varying float vA;varying vec3 vC;void main(){float a=smoothstep(.5,0.,length(gl_PointCoord-.5))*vA;if(a<.01)discard;gl_FragColor=vec4(vC*a*2.,a);}`});
const embers=new THREE.Points(eGeo,eMat);embers.frustumCulled=false;bookRoot.add(embers);

// ---------------- 3. plakat ze składaniem ----------------
const holder=new THREE.Group();bookRoot.add(holder);
const PW=BW,PH=BH;
const fU={uF1:{value:0},uF2:{value:0},uF3:{value:0},uMap:{value:tPoster},uPaper:{value:tPaper},uOp:{value:1}};
const posterMat=new THREE.ShaderMaterial({uniforms:fU,side:THREE.DoubleSide,transparent:true,
 vertexShader:`uniform float uF1,uF2,uF3;varying vec2 vUv;varying vec3 vN;varying float vSh;
 const float PI=3.14159265;
 void main(){vUv=uv;vec3 p=position;vec3 n=vec3(0.,0.,1.);float H=${PH.toFixed(4)};
  if(p.y>0.){float a=uF1*PI;float y=p.y,z=p.z;p.y=y*cos(a)-z*sin(a);p.z=y*sin(a)+z*cos(a)+.004*smoothstep(.5,1.,uF1);n=vec3(0.,-sin(a),cos(a));}
  if(p.x>0.){float b=uF2*PI;float x=p.x,z=p.z;p.x=x*cos(b)-z*sin(b);p.z=x*sin(b)+z*cos(b)+.008*smoothstep(.5,1.,uF2);vec3 m=n;n.x=m.x*cos(b)-m.z*sin(b);n.z=m.x*sin(b)+m.z*cos(b);}
  float L=-H/4.;if(p.y>L){float c=uF3*PI;float y=p.y-L,z=p.z;p.y=y*cos(c)-z*sin(c)+L;p.z=y*sin(c)+z*cos(c)+.012*smoothstep(.5,1.,uF3);vec3 m=n;n.y=m.y*cos(c)-m.z*sin(c);n.z=m.y*sin(c)+m.z*cos(c);}
  vN=normalize(normalMatrix*n);gl_Position=projectionMatrix*modelViewMatrix*vec4(p,1.);}`,
 fragmentShader:`uniform sampler2D uMap,uPaper;uniform float uOp;varying vec2 vUv;varying vec3 vN;
 void main(){vec3 N=gl_FrontFacing?vN:-vN;float l=.55+.5*max(0.,dot(N,normalize(vec3(.35,.55,1.))));
  vec3 c=gl_FrontFacing?texture2D(uMap,vUv).rgb:texture2D(uPaper,vUv).rgb;
  c=pow(c,vec3(2.2))*l;gl_FragColor=vec4(pow(c,vec3(1./2.2)),uOp);}`});
posterMat.toneMapped=false;
const poster=new THREE.Mesh(new THREE.PlaneGeometry(PW,PH,48,72),posterMat);holder.add(poster);
// wizytówka
const CW=.874,CH=.566;
const cardM=new THREE.MeshStandardMaterial({map:tCard,roughness:.5});
const cardBackM=new THREE.MeshStandardMaterial({color:0xffcc00,roughness:.55});
const card=new THREE.Mesh(new THREE.BoxGeometry(CW,CH,.012),[cardBackM,cardBackM,cardBackM,cardBackM,cardM,cardBackM]);card.rotation.y=PI;card.visible=false;holder.add(card);
const sq=new THREE.Mesh(new THREE.BoxGeometry(1,1,.02),[logoEdge,logoEdge,logoEdge,logoEdge,new THREE.MeshStandardMaterial({map:tLogo,roughness:.55}),logoEdge]);sq.visible=false;holder.add(sq);

// ---------------- 4. historia produktu: koszulka → bluza → paczka → kurier → samolot → klient ----------------
const GROUND=-1.6;
const mats=[];const M3=(o)=>{const m=new THREE.MeshStandardMaterial(o);mats.push(m);return m;};
// --- kształty odzieży (kontur od środka góry, w lewo) ---
