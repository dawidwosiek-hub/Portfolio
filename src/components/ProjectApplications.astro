---
import ProjectImage from './ProjectImage.astro';
import PrintMockup from './PrintMockup.astro';
import ProjectSources from './ProjectSources.astro';
import ProjectFilms from './ProjectFilms.astro';
import type {ProjectApplication} from '../lib/content';
interface Props {applications:ProjectApplication[];startNumber:number}
const {applications,startNumber}=Astro.props;
---
{applications.map((application,index)=>{
 const originals=[...(application.original?[application.original]:[]),...(application.originals || [])];
 return <section class="application-section" id={`application-${application.slug}`} aria-labelledby={`title-${application.slug}`}>
  <div class="application-rule"><span>{String(startNumber+index).padStart(2,'0')} / {application.label}</span>{application.concept&&<strong>Projekt koncepcyjny</strong>}</div>
  <div class="application-heading"><h2 id={`title-${application.slug}`}>{application.title}</h2><p>{application.description}</p></div>
  {application.mockup&&<figure class="application-mockup"><div class="application-visual"><PrintMockup mockup={application.mockup}/></div><figcaption>Prezentacja z wykorzystaniem oryginalnego projektu.</figcaption></figure>}
  {application.image&&<figure class="application-mockup"><div class="application-visual"><ProjectImage media={application.image} sizes="(max-width: 760px) 88vw, min(85vw, 1120px)"/></div>{application.image.caption&&<figcaption>{application.image.caption}</figcaption>}</figure>}
  {application.videos&&application.videos.length>0&&<ProjectFilms videos={application.videos} section={application.slug}/>}
  {originals.length>0&&<ProjectSources media={originals}/>}
 </section>
})}
<style>
 .application-section{padding-bottom:var(--section-space,80px);scroll-margin-top:35px}
 .application-rule{display:flex;justify-content:space-between;align-items:center;gap:20px;border-top:1px solid var(--line);padding-top:24px;font-size:.65rem;line-height:1.6;letter-spacing:.12em;text-transform:uppercase;font-weight:600}
 .application-rule>span{display:flex;gap:14px;align-items:center}
 .application-rule>span:before{content:'';width:24px;height:3px;background:var(--accent,#bd1014);flex-shrink:0}
 .application-rule strong{font-size:.63rem;letter-spacing:.06em;font-weight:500;color:var(--muted);text-align:right}
 .application-heading{display:grid;grid-template-columns:1.2fr 1fr;gap:10%;align-items:start;margin:36px 0 20px}
 .application-heading h2{font-size:var(--case-title,clamp(2.2rem,3.7vw,3.6rem));white-space:pre-line}
 .application-heading p{font-size:.9rem;max-width:470px;padding-top:4px}
 figure{margin:0}
 .application-visual{max-width:1120px;margin:auto;padding:30px 0 8px}
 .application-visual :global(img){width:100%;height:auto;max-height:760px;object-fit:contain}
 figcaption{font-size:.68rem;color:var(--muted);padding-top:16px;line-height:1.7;text-align:center}
 @media(max-width:760px){.application-section{padding-bottom:52px}.application-rule{padding-top:18px;font-size:.6rem;letter-spacing:.06em;gap:12px}.application-rule>span{gap:8px}.application-rule>span:before{width:16px}.application-rule strong{font-size:.6rem}.application-heading{grid-template-columns:1fr;gap:20px;margin:28px 0 12px}.application-heading h2{font-size:2.4rem}.application-heading p{font-size:.88rem;padding:0}.application-visual{padding:22px 0 0}figcaption{font-size:.66rem;padding-top:14px}}
</style>
