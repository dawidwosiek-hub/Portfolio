---
import ProjectImage from './ProjectImage.astro';
import type {ProjectApplication} from '../lib/content';
interface Props {applications:ProjectApplication[];startNumber:number}
const {applications,startNumber}=Astro.props;
---
{applications.map((application,index)=><section class="application-section" id={`application-${application.slug}`} aria-labelledby={`title-${application.slug}`}>
 <div class="application-rule"><span>{String(startNumber+index).padStart(2,'0')} / {application.label}</span>{application.concept&&<strong>Projekt koncepcyjny</strong>}</div>
 <div class="application-heading"><h2 id={`title-${application.slug}`}>{application.title}</h2><p>{application.description}</p></div>
 <div class:list={['application-media',{'with-original':!!application.original}]}>
  <figure class="application-mockup"><ProjectImage media={application.image} sizes={application.original?'(max-width: 760px) 88vw, 55vw':'90vw'}/>{application.image.caption&&<figcaption>{application.image.caption}</figcaption>}</figure>
  {application.original&&<figure class="application-original"><div class="original-mount"><a href={application.original.src} target="_blank" rel="noopener noreferrer" aria-label={`Powiększ oryginalny projekt: ${application.label}`}><ProjectImage media={application.original} sizes="(max-width: 760px) 78vw, 28vw"/><span aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></span></a></div>{application.original.caption&&<figcaption>{application.original.caption}</figcaption>}</figure>}
 </div>
</section>)}
<style>
 .application-section{padding-bottom:80px;scroll-margin-top:35px}
 .application-rule{display:flex;justify-content:space-between;align-items:center;gap:20px;border-top:1px solid var(--line);padding-top:24px;font-size:.65rem;line-height:1.6;letter-spacing:.12em;text-transform:uppercase;font-weight:600}
 .application-rule>span{display:flex;gap:14px;align-items:center}
 .application-rule>span:before{content:'';width:24px;height:3px;background:var(--accent,#bd1014);flex-shrink:0}
 .application-rule strong{font-size:.58rem;letter-spacing:.08em;font-weight:500;padding:6px 10px;border:1px solid var(--line);color:var(--muted);text-align:right}
 .application-heading{display:grid;grid-template-columns:1.2fr 1fr;gap:10%;align-items:end;margin:38px 0}
 .application-heading h2{font-size:clamp(2.1rem,3.9vw,4rem);white-space:pre-line}
 .application-heading p{font-size:.92rem;max-width:470px}
 .application-media{display:grid;grid-template-columns:1fr;gap:40px;align-items:center}
 .with-original{grid-template-columns:1.65fr 1fr}
 figure{margin:0;min-width:0}
 .application-media :global(img){width:100%;height:auto}
 figcaption{font-size:.68rem;color:var(--muted);padding-top:18px;line-height:1.7}
 .original-mount{background:#f6f6f4;padding:30px}
 .original-mount a{display:block;position:relative}
 .original-mount a>span{position:absolute;right:0;bottom:0;background:white;color:var(--ink);width:30px;height:30px;display:grid;place-items:center;font-size:1rem}
 .original-mount a:hover>span{background:var(--yellow)}
 @media(max-width:760px){.application-section{padding-bottom:48px}.application-rule{padding-top:18px;font-size:.57rem;letter-spacing:.07em;gap:12px}.application-rule>span{gap:8px}.application-rule>span:before{width:16px}.application-rule strong{font-size:.5rem;padding:5px 7px}.application-heading{grid-template-columns:1fr;gap:22px;margin:28px 0}.application-heading h2{font-size:2.5rem}.application-heading p{font-size:.88rem}.with-original{grid-template-columns:1fr}.application-media{gap:26px}.original-mount{padding:24px}figcaption{font-size:.64rem;padding-top:14px}}
</style>
