---
import {projects} from '../lib/content';
import ProjectImage from './ProjectImage.astro';
const selected = projects.filter(p=>p.featured);
// rytm siatki: duża, mała, mała / trzy średnie / mała, mała, duża
const pattern=['xl','s','s','m','m','m','s','s','xl','m','m','m'];
---
<div class="fw" role="list">
 {selected.map((p,i)=>{
  const cover=p.cover||{src:p.image,smallSrc:p.imageSmall,mediumSrc:p.imageMedium,alt:p.alt,width:p.imageWidth,height:p.imageHeight};
  const size=pattern[i%pattern.length];
  return <a role="listitem" href={`/realizacje/${p.slug}`} class={`fw-card fw-${size}`} style={`--acc:${p.accent||'#ffcc00'}`} data-reveal>
   <div class="fw-media"><ProjectImage media={cover} sizes={size==='xl'?'(max-width: 760px) 92vw, 66vw':'(max-width: 760px) 92vw, 33vw'}/></div>
   <div class="fw-shade" aria-hidden="true"></div>
   <div class="fw-top"><span class="fw-cat">{p.category}</span></div>
   <div class="fw-body">
    <h3>{p.name}</h3>
    <p>{p.teaser||p.scope}</p>
   </div>
   <span class="fw-go" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="2"/></svg></span>
  </a>})}
</div>
<script is:inline>(()=>{const els=document.querySelectorAll('.fw-card[data-reveal]');if(!('IntersectionObserver' in window)||matchMedia('(prefers-reduced-motion: reduce)').matches){els.forEach(e=>e.classList.add('in'));return;}
const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add('in');io.unobserve(e.target);}}),{threshold:.12});els.forEach(e=>io.observe(e));})();</script>
<style>
 .fw{display:grid;grid-template-columns:repeat(12,minmax(0,1fr));grid-auto-flow:dense;gap:14px}
 .fw-card{position:relative;display:block;overflow:hidden;background:#111;color:#fff;isolation:isolate;border-radius:2px;opacity:0;transform:translateY(40px);transition:opacity .8s cubic-bezier(.2,.7,.2,1),transform .8s cubic-bezier(.2,.7,.2,1)}
 .fw-card.in{opacity:1;transform:none}
 .fw-xl{grid-column:span 8;grid-row:span 2;min-height:620px}
 .fw-s{grid-column:span 4;min-height:303px}
 .fw-m{grid-column:span 4;min-height:420px}
 .fw-media{position:absolute;inset:0}
 .fw-media :global(img){width:100%;height:100%;object-fit:cover;display:block;transform:scale(1.02);transition:transform 1.1s cubic-bezier(.2,.7,.2,1),filter .6s}
 .fw-card:hover .fw-media :global(img),.fw-card:focus-visible .fw-media :global(img){transform:scale(1.08);filter:brightness(1.06) saturate(1.08)}
 .fw-shade{position:absolute;inset:0;background:linear-gradient(180deg,#0000 35%,#000000b3 78%,#000000e6);transition:opacity .5s}
 .fw-card:after{content:'';position:absolute;left:0;bottom:0;height:4px;width:100%;background:var(--acc);transform:scaleX(0);transform-origin:0 50%;transition:transform .6s cubic-bezier(.2,.7,.2,1)}
 .fw-card:hover:after,.fw-card:focus-visible:after{transform:scaleX(1)}
 .fw-top{position:absolute;top:16px;left:18px;right:18px;display:flex;justify-content:flex-end;align-items:center;font-size:.7rem;font-weight:600;letter-spacing:.02em}
 .fw-n{background:#000000a0;backdrop-filter:blur(6px);padding:5px 9px;font-variant-numeric:tabular-nums}
 .fw-cat{background:#ffffffe6;color:#111;padding:5px 10px}
 .fw-body{position:absolute;left:22px;right:80px;bottom:22px}
 .fw-body h3{font-size:clamp(1.5rem,2.1vw,2.3rem);letter-spacing:-.045em;line-height:1.02;color:#fff}
 .fw-xl .fw-body h3{font-size:clamp(2.4rem,4.4vw,4.8rem)}
 .fw-body p{color:#e2e2e2;font-size:.84rem;line-height:1.5;margin-top:10px;max-width:440px;max-height:0;opacity:0;overflow:hidden;transition:max-height .5s,opacity .5s}
 .fw-xl .fw-body p,.fw-card:hover .fw-body p,.fw-card:focus-visible .fw-body p{max-height:5em;opacity:1}
 .fw-go{position:absolute;right:20px;bottom:22px;width:46px;height:46px;border-radius:50%;background:var(--acc);color:#111;display:grid;place-items:center;transform:scale(.6) rotate(-45deg);opacity:0;transition:transform .45s cubic-bezier(.3,1.5,.5,1),opacity .3s}
 .fw-go svg{width:18px;height:18px}
 .fw-card:hover .fw-go,.fw-card:focus-visible .fw-go{transform:none;opacity:1}
 @media(max-width:1000px){.fw-xl{grid-column:span 12;min-height:460px}.fw-s,.fw-m{grid-column:span 6;min-height:320px}}
 @media(max-width:640px){.fw{gap:10px}.fw-xl,.fw-s,.fw-m{grid-column:span 12;min-height:300px}.fw-body p{max-height:5em;opacity:1}.fw-go{opacity:1;transform:none;width:38px;height:38px}}
 @media(prefers-reduced-motion:reduce){.fw-card{opacity:1;transform:none;transition:none}.fw-media :global(img){transition:none}}
</style>
