---
// Wstęp strony głównej: znak NADX budowany w 3D podczas przewijania (Three.js z /public/nadx3d).
---
<section id="lx" aria-label="Wstęp: znak NADX">
 <div class="lx-pin" id="lx-pin">
  <canvas id="lx-gl" aria-hidden="true"></canvas>
  <img class="lx-fallback" src="/brand/nadx-logo.svg" alt="" width="812" height="820"/>
  <div class="lx-cap lx-fade" id="lx-cap" aria-hidden="true"></div>
  <div class="lx-final lx-fade" id="lx-final">
   <p class="lx-k">Dawid Wosiek / grafika i wideo</p>
   <h1>Logo i grafika. Wideo dla <u>Twojej firmy.</u></h1>
   <p class="lx-lead">Projektuję identyfikację, materiały reklamowe i nadruki. Montuję filmy dla firm i twórców.</p>
   <div class="lx-row"><a class="lx-btn" href="/realizacje">Zobacz realizacje</a><a class="lx-btn lx-ghost" href="/kontakt">Zapytaj o wycenę</a></div>
  </div>
  <div class="lx-hint" id="lx-hint" aria-hidden="true">Przewiń, żeby zbudować znak</div>
  <div class="lx-prog" aria-hidden="true"><i id="lx-bar"></i></div>
 </div>
</section>
<style is:global>
#lx{position:relative;height:760vh;background:#080808;color:#fff;font-family:inherit}
#lx.lx-static{height:100vh;height:100svh}
#lx .lx-pin{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden}
#lx canvas{position:absolute;inset:0;width:100%;height:100%;display:block}
#lx .lx-fallback{position:absolute;right:6%;top:50%;transform:translateY(-50%);width:min(34vw,420px);display:none}
#lx.lx-no3d .lx-fallback{display:block}
#lx .lx-cap{position:absolute;z-index:3;left:clamp(16px,5vw,72px);bottom:clamp(40px,8vh,88px);max-width:min(460px,calc(100vw - 32px));pointer-events:none}
#lx .lx-cap small{display:block;color:#ffcc00;font-size:14px;font-weight:600;margin-bottom:6px}
#lx .lx-cap strong{display:block;font-size:clamp(44px,7vw,104px);line-height:.92;font-weight:800;letter-spacing:-.05em}
#lx .lx-cap span{display:block;color:#c9c9c9;margin-top:12px;font-size:17px;max-width:38ch;line-height:1.5}
#lx .lx-final{position:absolute;z-index:3;left:clamp(16px,5vw,72px);top:50%;max-width:min(560px,46vw)}
#lx .lx-final p.lx-k{font-size:13px;font-weight:600;color:#ffcc00;margin:0 0 16px;letter-spacing:0;text-transform:none}
#lx .lx-final h1{font-size:clamp(40px,5.6vw,86px);line-height:.96;font-weight:800;letter-spacing:-.045em;margin:0;color:#fff;text-wrap:balance}
#lx .lx-final h1 u{text-decoration:none;box-shadow:inset 0 -.12em #ffcc00}
#lx .lx-final .lx-lead{color:#c9c9c9;max-width:42ch;margin:20px 0 26px;font-size:17px;line-height:1.55}
#lx .lx-row{display:flex;flex-wrap:wrap;gap:12px 26px;align-items:center}
#lx .lx-btn{display:inline-flex;align-items:center;justify-content:center;min-height:48px;padding:12px 22px;background:#ffcc00;color:#000;font-weight:600;text-decoration:none;font-size:15px}
#lx .lx-btn.lx-ghost{background:none;color:#fff;border-bottom:2px solid #fff;min-height:44px;padding:10px 2px}
#lx .lx-btn:focus-visible{outline:2px solid #ffcc00;outline-offset:3px}
#lx .lx-fade{opacity:0;transition:opacity .35s ease,transform .35s ease;transform:translateY(12px)}
#lx .lx-fade.on{opacity:1;transform:none}
#lx .lx-final.lx-fade{transform:translateY(calc(-50% + 12px))}
#lx .lx-final.lx-fade.on{transform:translateY(-50%)}
#lx .lx-final:not(.on) *{pointer-events:none}
#lx .lx-prog{position:absolute;z-index:3;left:0;right:0;bottom:0;height:3px;background:rgba(255,255,255,.1)}
#lx .lx-prog i{display:block;height:100%;width:0;background:#ffcc00}
#lx .lx-hint{position:absolute;z-index:3;right:clamp(16px,5vw,72px);bottom:clamp(40px,8vh,88px);font-size:14px;color:#aaa;transition:opacity .3s}
@media(max-width:860px){
 #lx .lx-final{top:auto;bottom:clamp(36px,7vh,72px);max-width:none;right:16px}
 #lx .lx-final.lx-fade{transform:translateY(12px)}#lx .lx-final.lx-fade.on{transform:none}
 #lx .lx-final .lx-lead{display:none}
 #lx .lx-hint{display:none}
 #lx .lx-fallback{top:12%;right:50%;transform:translateX(50%);width:52vw}
}
@media(prefers-reduced-motion:reduce){#lx .lx-fade,#lx .lx-final.lx-fade{transition:none}}
</style>
<script is:inline type="module">
import * as THREE from '/nadx3d/lib/three.module.min.js';
import {SVGLoader} from '/nadx3d/lib/addons/loaders/SVGLoader.js';
import {EffectComposer} from '/nadx3d/lib/addons/postprocessing/EffectComposer.js';
import {RenderPass} from '/nadx3d/lib/addons/postprocessing/RenderPass.js';
import {UnrealBloomPass} from '/nadx3d/lib/addons/postprocessing/UnrealBloomPass.js';
import {BokehPass} from '/nadx3d/lib/addons/postprocessing/BokehPass.js';
import {ShaderPass} from '/nadx3d/lib/addons/postprocessing/ShaderPass.js';
import {OutputPass} from '/nadx3d/lib/addons/postprocessing/OutputPass.js';
import {RoomEnvironment} from '/nadx3d/lib/addons/environments/RoomEnvironment.js';
import {Reflector} from '/nadx3d/lib/addons/objects/Reflector.js';
import {RoundedBoxGeometry} from '/nadx3d/lib/addons/geometries/RoundedBoxGeometry.js';
{
const $=id=>document.getElementById(id);
const intro=$('lx'),canvas=$('lx-gl');
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
const mobile=()=>innerWidth<860;
const shot=location.search.includes('shot');
const clock=new THREE.Clock();
const cl=x=>Math.min(1,Math.max(0,x)),sm=x=>{x=cl(x);return x*x*(3-2*x);};
const seg=(p,a,b)=>cl((p-a)/(b-a));
const easeOut=x=>1-Math.pow(1-x,3),easeBack=x=>{const c1=1.70158,c3=c1+1;return 1+c3*Math.pow(x-1,3)+c1*Math.pow(x-1,2);};

// ---------- renderer ----------
let renderer;
try{renderer=new THREE.WebGLRenderer({canvas,antialias:true,preserveDrawingBuffer:shot});}
catch(e){intro.classList.add('lx-no3d','lx-static');$('lx-final').classList.add('on');$('lx-hint').style.display='none';throw e;}
if(reduce)intro.classList.add('lx-static');
renderer.setPixelRatio(Math.min(devicePixelRatio,mobile()?2:2));
renderer.setSize(innerWidth,innerHeight,false);
renderer.outputColorSpace=THREE.SRGBColorSpace;renderer.toneMapping=THREE.ACESFilmicToneMapping;
const scene=new THREE.Scene();scene.background=new THREE.Color(0x080808);scene.fog=new THREE.Fog(0x080808,9,22);
scene.environment=new THREE.PMREMGenerator(renderer).fromScene(new RoomEnvironment(renderer),.04).texture;
const camera=new THREE.PerspectiveCamera(34,innerWidth/innerHeight,.1,80);

// ---------- posadzka, siatka szkicu, światła ----------
const fg=new THREE.PlaneGeometry(60,60);
let reflector=null;
if(!mobile()){reflector=new Reflector(fg,{clipBias:.003,textureWidth:Math.round(innerWidth*.5),textureHeight:Math.round(innerHeight*.5),color:0x8a8a8a});reflector.rotation.x=-Math.PI/2;scene.add(reflector);}
const floorMat=new THREE.MeshStandardMaterial({color:0x0c0c0c,roughness:.5,transparent:true,opacity:mobile()?1:.86});
const floor=new THREE.Mesh(fg,floorMat);floor.rotation.x=-Math.PI/2;floor.position.y=.003;scene.add(floor);
const grid=new THREE.GridHelper(24,48,0xffcc00,0xffcc00);grid.position.y=.01;grid.material.transparent=true;grid.material.depthWrite=false;scene.add(grid);
const sc=document.createElement('canvas');sc.width=sc.height=128;{const g=sc.getContext('2d'),gr=g.createRadialGradient(64,64,0,64,64,64);gr.addColorStop(0,'rgba(0,0,0,.9)');gr.addColorStop(1,'rgba(0,0,0,0)');g.fillStyle=gr;g.fillRect(0,0,128,128);}
const shadow=new THREE.Mesh(new THREE.PlaneGeometry(3.6,2.3),new THREE.MeshBasicMaterial({map:new THREE.CanvasTexture(sc),transparent:true,depthWrite:false,opacity:0}));shadow.rotation.x=-Math.PI/2;shadow.position.y=.02;scene.add(shadow);
scene.add(new THREE.HemisphereLight(0xffffff,0x111111,.3));
const keyL=new THREE.SpotLight(0xffffff,0,22,.6,.6,2);keyL.position.set(-3,6.5,5);keyL.target.position.set(0,1.4,0);scene.add(keyL,keyL.target);
const rim=new THREE.SpotLight(0xffcc00,0,14,.7,.7,2);rim.position.set(3,3,-4);rim.target.position.set(0,1.4,0);scene.add(rim,rim.target);
const flash=new THREE.PointLight(0xffffff,0,7,2);scene.add(flash);
const strips=[];
for(const [x,z] of [[-4.2,-3.6],[4.2,-3.6],[-2.2,-4.6],[2.2,-4.6]]){
 const m=new THREE.Mesh(new THREE.BoxGeometry(.03,4.4,.03),new THREE.MeshBasicMaterial({color:0xffcc00,transparent:true,opacity:0}));m.position.set(x,2.2,z);
 const l=new THREE.PointLight(0xffcc00,0,9,2);l.position.set(x,2.2,z+.6);scene.add(m,l);strips.push({m,l});
}
// pył i iskry
const dn=mobile()?350:1000,dpos=new Float32Array(dn*3);for(let i=0;i<dn;i++){dpos[i*3]=(Math.random()-.5)*14;dpos[i*3+1]=Math.random()*5.5;dpos[i*3+2]=(Math.random()-.5)*9;}
const dg=new THREE.BufferGeometry();dg.setAttribute('position',new THREE.BufferAttribute(dpos,3));
const dust=new THREE.Points(dg,new THREE.PointsMaterial({color:0xfff2c2,size:.016,transparent:true,opacity:.5,depthWrite:false,blending:THREE.AdditiveBlending}));scene.add(dust);
const SPK=260,spos=new Float32Array(SPK*3),svel=[];for(let i=0;i<SPK;i++)svel.push(new THREE.Vector3((Math.random()-.5)*2.4,Math.random()*1.6+.3,(Math.random()*.9+.2)*1.6));
const sgeo=new THREE.BufferGeometry();sgeo.setAttribute('position',new THREE.BufferAttribute(spos,3));
const sparks=new THREE.Points(sgeo,new THREE.PointsMaterial({color:new THREE.Color(0xffd84d).multiplyScalar(3),size:.03,transparent:true,opacity:0,depthWrite:false,blending:THREE.AdditiveBlending}));scene.add(sparks);

// ---------- znak ----------
const S=2.2/820.32,PW=811.89*S,PH=820.32*S,PD=.32,Y0=1.5;
const logo=new THREE.Group();logo.position.y=Y0;scene.add(logo);
const yellow=new THREE.MeshStandardMaterial({color:0xffcc00,roughness:.32,metalness:0,envMapIntensity:.7,emissive:0xffcc00,emissiveIntensity:.04});
// płyta: zwykły prostopadłościan i proste materiały (Safari na iOS źle renderował zaokrągloną bryłę)
const plateSide=new THREE.MeshLambertMaterial({color:0xffcc00,emissive:0xffcc00,emissiveIntensity:.08});
let plateFace=plateSide;
const plate=new THREE.Mesh(new THREE.BoxGeometry(PW,PH,PD),[plateSide,plateSide,plateSide,plateSide,plateSide,plateSide]);plate.visible=false;logo.add(plate);
// kafle budujące płytę
const NX=14,NY=14,tw=PW/NX,th=PH/NY;
const tiles=new THREE.InstancedMesh(new RoundedBoxGeometry(tw*.96,th*.96,PD,2,.012),yellow,NX*NY);logo.add(tiles);
const tileData=[];for(let j=0;j<NY;j++)for(let i=0;i<NX;i++){
 const home=new THREE.Vector3(-PW/2+tw*(i+.5),-PH/2+th*(j+.5),0);
 const dir=new THREE.Vector3((Math.random()-.5)*2,(Math.random()-.2)*1.6,Math.random()*1.2+.4).normalize().multiplyScalar(4+Math.random()*5);
 const d=home.length()/1.6;tileData.push({home,from:home.clone().add(dir),rot:new THREE.Euler((Math.random()-.5)*7,(Math.random()-.5)*7,(Math.random()-.5)*7),delay:d*.55+Math.random()*.25});
}
// obrys płyty (szkic)
const wireMat=new THREE.LineBasicMaterial({color:0xffcc00,transparent:true,opacity:1});
const wires=[];
function addWire(geo,parent,pos,scale){const e=new THREE.EdgesGeometry(geo,25);const l=new THREE.LineSegments(e,wireMat);if(pos)l.position.copy(pos);if(scale)l.scale.copy(scale);parent.add(l);wires.push(l);l.userData.n=e.attributes.position.count;return l;}
addWire(new THREE.BoxGeometry(PW,PH,PD),logo);
const letters=[],letterMat=new THREE.MeshStandardMaterial({color:0x0a0a0a,roughness:.2,metalness:.2,envMapIntensity:1.2,emissive:0xffcc00,emissiveIntensity:0});
let ready=false;
new SVGLoader().load('/nadx3d/nadx-logo-inline.svg',data=>{
 data.paths.forEach(path=>{
  // Safari na iOS nie odczytuje stylów CSS z pliku SVG, więc żółte tło też wygląda na czarny kształt.
  // Rozpoznajemy je po rozmiarze (prawie cały znak) i pomijamy, niezależnie od koloru.
  const shapes=SVGLoader.createShapes(path);if(!shapes.length)return;
  {const bb=new THREE.Box2();shapes.forEach(sh=>sh.getPoints().forEach(pt=>bb.expandByPoint(pt)));const sz=new THREE.Vector2();bb.getSize(sz);if(sz.x>600||sz.y>600)return;}
  if(path.color.getHex()!==0x000000)return;
  const geo=new THREE.ExtrudeGeometry(shapes,{depth:34,bevelEnabled:true,bevelThickness:4,bevelSize:2.5,bevelSegments:3,curveSegments:24});
  geo.computeBoundingBox();const bb=geo.boundingBox,c=new THREE.Vector3();bb.getCenter(c);
  geo.translate(-c.x,-c.y,-bb.min.z);
  {const n=geo.attributes.normal.array;for(let i=0;i<n.length;i+=3){if(!(Number.isFinite(n[i])&&Number.isFinite(n[i+1])&&Number.isFinite(n[i+2]))||(n[i]===0&&n[i+1]===0&&n[i+2]===0)){n[i]=0;n[i+1]=0;n[i+2]=1;}}}
  const m=new THREE.Mesh(geo,letterMat);
  const home=new THREE.Vector3((c.x-811.89/2)*S,-(c.y-820.32/2)*S,PD/2-.004);
  m.position.copy(home);m.scale.set(S,-S,S);
  m.userData={home,order:(c.y<410?0:2)+(c.x<406?0:1),pop:0};
  logo.add(m);letters.push(m);
  m.userData.wire=addWire(geo,logo,home,new THREE.Vector3(S,-S,S));
 });
 letters.sort((a,b)=>a.userData.order-b.userData.order);
 letters.forEach((m,i)=>m.userData.i=i);
 ready=true;
 plate.visible=true;tiles.visible=true;try{renderer.compile(scene,camera);}catch(e){}plate.visible=false;
});

// ---------- makiety: wizytówki, papier firmowy, naklejka ----------
const logoImg=new Image();logoImg.src='/nadx3d/nadx-logo-inline.svg';
function canvasTex(w,h,draw){const c=document.createElement('canvas');c.width=w;c.height=h;const t=new THREE.CanvasTexture(c);t.colorSpace=THREE.SRGBColorSpace;t.anisotropy=renderer.capabilities.getMaxAnisotropy();
 const run=()=>{const g=c.getContext('2d');draw(g,w,h);t.needsUpdate=true;};run();
 const again=()=>run();if(!logoImg.complete)logoImg.addEventListener('load',again,{once:true});if(document.fonts)document.fonts.ready.then(again);return t;}
const rr=(g,x,y,w,h,r)=>{g.beginPath();g.roundRect(x,y,w,h,r);};
const D_front=(g,w,h)=>{g.clearRect(0,0,w,h);rr(g,0,0,w,h,26);g.fillStyle='#ffcc00';g.fill();if(logoImg.complete&&logoImg.naturalWidth){const s=300;g.drawImage(logoImg,(w-s)/2,(h-s)/2-6,s,s*820/812);}};
const D_back=(g,w,h)=>{g.clearRect(0,0,w,h);rr(g,0,0,w,h,26);g.fillStyle='#111';g.fill();
 if(logoImg.complete&&logoImg.naturalWidth)g.drawImage(logoImg,70,70,118,118*820/812);
 g.fillStyle='#fff';g.font='800 64px Inter, Arial';g.fillText('Dawid Wosiek',70,330);
 g.fillStyle='#bdbdbd';g.font='500 32px Inter, Arial';g.fillText('Grafika, wideo i produkcja',70,380);
 g.fillStyle='#fff';g.font='500 30px Inter, Arial';g.fillText('516 139 400',70,470);g.fillText('DawidWosiek@gmail.com',70,515);
 g.fillStyle='#ffcc00';g.font='800 30px Inter, Arial';g.fillText('nadx.pl',w-70-g.measureText('nadx.pl').width,515);};
const D_paper=(g,w,h)=>{g.fillStyle='#fafafa';g.fillRect(0,0,w,h);
 if(logoImg.complete&&logoImg.naturalWidth)g.drawImage(logoImg,64,64,96,96*820/812);
 g.fillStyle='#111';g.font='600 22px Inter, Arial';g.fillText('Dawid Wosiek / NADX',w-64-g.measureText('Dawid Wosiek / NADX').width,92);
 g.fillStyle='#777';g.font='400 18px Inter, Arial';g.fillText('nadx.pl  |  516 139 400',w-64-g.measureText('nadx.pl  |  516 139 400').width,122);
 g.fillStyle='#ffcc00';g.fillRect(64,200,w-128,6);
 g.fillStyle='#d9d9d9';const rows=[[250,.42],[300,.92],[334,.88],[368,.95],[402,.7],[470,.9],[504,.94],[538,.86],[572,.6],[640,.93],[674,.9],[708,.8]];rows.forEach(([y,f])=>g.fillRect(64,y,(w-128)*f,12));
 g.fillStyle='#111';g.fillRect(64,h-120,w-128,2);g.fillStyle='#999';g.font='400 16px Inter, Arial';g.fillText('Kraków  |  DawidWosiek@gmail.com',64,h-84);};
const D_sticker=(g,w,h)=>{g.clearRect(0,0,w,h);g.beginPath();g.arc(w/2,h/2,w/2-4,0,Math.PI*2);g.fillStyle='#ffcc00';g.fill();g.lineWidth=10;g.strokeStyle='#111';g.stroke();if(logoImg.complete&&logoImg.naturalWidth){const s=300;g.drawImage(logoImg,(w-s)/2,(h-s)/2,s,s*820/812);}};
// twarz płyty: logo narysowane z oryginalnego SVG
plateFace=new THREE.MeshLambertMaterial({map:canvasTex(812,820,(g,w,h)=>{g.fillStyle='#ffcc00';g.fillRect(0,0,w,h);if(logoImg.complete&&logoImg.naturalWidth)g.drawImage(logoImg,0,0,w,h);}),emissive:0xffffff,emissiveIntensity:.35});
plateFace.emissiveMap=plateFace.map;
// makieta = obrys (szkic) + druk odsłaniany żółtą linią + rewers
// ---------- makiety 3D: wizytówki, kubek, telefon, notes (każda z własnym wejściem) ----------
renderer.localClippingEnabled=true;
const HQ=(w,h,s,d)=>canvasTex(w*s,h*s,(g)=>{g.save();g.scale(s,s);d(g,w,h);g.restore();});
const spriteTex=(()=>{const c=document.createElement('canvas');c.width=c.height=64;const g=c.getContext('2d'),r=g.createRadialGradient(32,32,0,32,32,32);r.addColorStop(0,'rgba(255,255,255,1)');r.addColorStop(.35,'rgba(255,255,255,.55)');r.addColorStop(1,'rgba(255,255,255,0)');g.fillStyle=r;g.fillRect(0,0,64,64);return new THREE.CanvasTexture(c);})();
const glint=new THREE.PointLight(0xffffff,0,3.2,2);scene.add(glint);
const goldMat=new THREE.MeshStandardMaterial({color:0xffcc00,metalness:1,roughness:.22,envMapIntensity:1.6});
// iskry + fala na posadzce przy lądowaniu
function fx(n=70,color=0xffd84d){
 const pos=new Float32Array(n*3),vel=[];for(let i=0;i<n;i++){const a=Math.random()*Math.PI*2,s=.6+Math.random()*1.4;vel.push([Math.cos(a)*s,.8+Math.random()*1.8,Math.sin(a)*s]);}
 const g=new THREE.BufferGeometry();g.setAttribute('position',new THREE.BufferAttribute(pos,3));
 const pts=new THREE.Points(g,new THREE.PointsMaterial({map:spriteTex,color:new THREE.Color(color).multiplyScalar(2.2),size:.07,transparent:true,opacity:0,depthWrite:false,blending:THREE.AdditiveBlending}));scene.add(pts);
 const ring=new THREE.Mesh(new THREE.RingGeometry(.92,1,96),new THREE.MeshBasicMaterial({color:new THREE.Color(0xffcc00).multiplyScalar(1.6),transparent:true,opacity:0,depthWrite:false,blending:THREE.AdditiveBlending,side:THREE.DoubleSide}));ring.rotation.x=-Math.PI/2;scene.add(ring);
 return {run(o,tau,scale=1){const on=tau>0&&tau<1;pts.visible=ring.visible=on;if(!on)return;
  for(let i=0;i<n;i++){const v=vel[i];pos[i*3]=o.x+v[0]*tau*.55*scale;pos[i*3+1]=o.y+v[1]*tau*.7*scale-1.6*tau*tau*scale;pos[i*3+2]=o.z+v[2]*tau*.55*scale;}
  g.attributes.position.needsUpdate=true;pts.material.opacity=Math.sin(Math.PI*tau);
  ring.position.set(o.x,.02,o.z);ring.scale.setScalar((.15+tau*1.3)*scale);ring.material.opacity=(1-tau)*.8;}};
}
function foil(scale){ // złocone, wypukłe litery NADX (te same kształty co w znaku)
 const g=new THREE.Group();letters.forEach(m=>{const f=new THREE.Mesh(m.geometry,goldMat);f.position.set(m.userData.home.x*scale,m.userData.home.y*scale,0);f.scale.set(S*scale,-S*scale,S*scale*.35);g.add(f);});return g;}
function roundedCard(W,H,T,r,mats){const s=new THREE.Shape();s.moveTo(r,0);s.lineTo(W-r,0);s.quadraticCurveTo(W,0,W,r);s.lineTo(W,H-r);s.quadraticCurveTo(W,H,W-r,H);s.lineTo(r,H);s.quadraticCurveTo(0,H,0,H-r);s.lineTo(0,r);s.quadraticCurveTo(0,0,r,0);
 const geo=new THREE.ExtrudeGeometry(s,{depth:T,bevelEnabled:false,curveSegments:10});
 const uv=geo.attributes.uv;for(let i=0;i<uv.count;i++)uv.setXY(i,uv.getX(i)/W,uv.getY(i)/H);
 geo.translate(-W/2,-H/2,-T/2);return new THREE.Mesh(geo,mats);}
const black=()=>new THREE.MeshStandardMaterial({color:0x121212,roughness:.55});
const CW=1.5,CH=CW*600/1050;

// A) stos wizytówek: karty spadają po kolei, złocenie wbija się w wierzchnią
const stack=(()=>{
 const grp=new THREE.Group();grp.position.set(-.35,0,1.9);grp.rotation.y=.35;scene.add(grp);
 const edge=new THREE.MeshStandardMaterial({color:0xffcc00,roughness:.4,emissive:0xffcc00,emissiveIntensity:.05});
