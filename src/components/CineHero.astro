---
// Hero strony głównej: kinowa scena WebGL. Pył → znak NADX z cząstek → eksplozja → cząstki układają się w realne realizacje
// na zakrzywionej ścianie → ostre kadry. Na końcu: karuzela realizacji (przeciąganie, klik = strona projektu).
// Poprzednie intro (znak budowany przewijaniem) zostało zachowane w LogoIntro.astro i działa pod /intro-3d.
import {projects} from '../lib/content';
const order=['odwroceni-projekty-oklejen','shiro-logo-i-wizytowki','bipi-detailing-bilbord','lucky-luke-meble-baner','estetic-studio-pracownia-protetyczna','mm-trans-plus-logo','prato-development-rolki','olsen-odziez-firmowa','leasing-cartel-logo','diverto-materialy-promocyjne','marta-romanska-zagorska-plakaty','parkiety-przybycien-logo'];
const V='20261123d';
const cards=order.map(s=>projects.find(p=>p.slug===s)).filter(p=>p&&p.imageSmall).map(p=>{
 const big=(p.imageWidth||1536)<=1536?p.image:p.imageSmall!.replace(/-768\.webp$/,'-1536.webp');
 return {slug:p.slug,name:p.name,cat:p.category,small:`${p.imageSmall}?v=${V}`,big:`${big}?v=${V}`};
});
---
<section id="ch" class="ch" aria-label="NADX: wybrane realizacje">
 <canvas id="ch-gl" aria-hidden="true"></canvas>
 <div class="ch-scrim" aria-hidden="true"></div>
 <div class="ch-wrap">
  <div class="ch-copy" id="ch-copy">
   <p class="ch-k">Dawid Wosiek / grafika i wideo</p>
   <h1>Logo i grafika. Wideo dla <u>Twojej firmy.</u></h1>
   <p class="ch-lead">Projektuję identyfikację, materiały reklamowe i nadruki. Montuję filmy dla firm i twórców.</p>
   <div class="ch-row"><a class="ch-btn" href="/realizacje">Zobacz realizacje</a><a class="ch-btn ch-ghost" href="/kontakt">Zapytaj o wycenę</a></div>
  </div>
  <div class="ch-stage" id="ch-stage" aria-hidden="true"></div>
 </div>
 <div class="ch-title" id="ch-title" aria-hidden="true"><strong>Dawid Wosiek</strong><span>grafika, wideo, produkcja</span></div>
 <a class="ch-tag" id="ch-tag" href="/realizacje" tabindex="-1" aria-hidden="true"><small></small><strong></strong></a>
 <p class="ch-hint" id="ch-hint" aria-hidden="true">Przeciągnij galerię. Kliknij kadr, żeby otworzyć projekt.</p>
 <div class="ch-black" id="ch-black" aria-hidden="true"></div>
 <div class="ch-bars" aria-hidden="true"><i></i><i></i></div>
 <button type="button" class="ch-ctl" id="ch-skip" hidden>Pomiń intro</button>
 <button type="button" class="ch-ctl" id="ch-replay" hidden>Odtwórz intro</button>
 <div class="ch-prog" aria-hidden="true"><i id="ch-bar"></i></div>
 <script type="application/json" id="ch-data" set:html={JSON.stringify(cards)}></script>
</section>
<script is:inline>document.getElementById('ch').classList.add('ch-js');setTimeout(function(){document.getElementById('ch').classList.add('ch-ready')},16000);</script>
<style is:global>
