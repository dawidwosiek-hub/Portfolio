---
const { compact = false } = Astro.props;
---
<div class:list={['brand-art', {compact}]} role="img" aria-label="Kompozycja typograficzna NADX: czarne i żółte powierzchnie, wizytówka i znak NADX. Grafika strony, nie realizacja klienta.">
  <div class="art-grid"></div>
  <span class="art-index">N / 01 — BRAND SYSTEM</span>
  <div class="art-poster"><span class="poster-small">GRAFIKA / FILM / PRODUKCJA</span><strong>NAD<span>X</span></strong><span class="poster-bottom">POMYSŁ MA ZNACZENIE.<br/>FORMA ROBI RÓŻNICĘ.</span><i aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></i></div>
  <div class="art-card"><b>NADX<span>+</span></b><span>DESIGN THAT<br/>GETS NOTICED.</span><i></i></div>
  <div class="art-tag"><span>OD POMYSŁU<br/>DO REALIZACJI.</span><b><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></b></div>
  <span class="art-caption">KOMPOZYCJA MARKI NADX</span>
  <span class="art-cross" aria-hidden="true">+</span>
</div>
