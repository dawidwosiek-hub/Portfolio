---
const { compact = false } = Astro.props;
---
<div class:list={['brand-art', {compact}]} role="img" aria-label="Kompozycja marki NADX: oficjalne logo w układzie NA / DX na żółtym tle, plakat i wizytówka. Grafika strony, nie realizacja klienta.">
  <div class="art-grid"></div>
  <span class="art-index">N / 01 — BRAND SYSTEM</span>
  <div class="art-poster"><span class="poster-small">GRAFIKA / FILM / PRODUKCJA</span><img class="art-poster-logo" src="/brand/nadx-logo.svg" alt="" width="812" height="820"/><span class="poster-bottom">POMYSŁ MA ZNACZENIE.<br/>FORMA ROBI RÓŻNICĘ.</span></div>
  <div class="art-card"><img class="art-card-logo" src="/brand/nadx-logo.svg" alt="" width="812" height="820"/><span>DESIGN THAT<br/>GETS NOTICED.</span></div>
  <div class="art-tag"><span>OD POMYSŁU<br/>DO REALIZACJI.</span><b><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></b></div>
  <span class="art-caption">KOMPOZYCJA MARKI NADX</span>
  <span class="art-cross" aria-hidden="true">+</span>
</div>
