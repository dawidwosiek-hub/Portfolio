---
import BusinessCards from './BusinessCards.astro';
import ProjectFilms from './ProjectFilms.astro';
import ProjectImage from './ProjectImage.astro';
import type {Project} from '../lib/content';
interface Props {project:Project}
const {project:p}=Astro.props;
const applications=p.applications || [];
const voucher=applications.find(a=>a.slug==='vouchery')!;
const sticker=applications.find(a=>a.slug==='naklejki')!;
const banner=applications.find(a=>a.slug==='baner')!;
const flags=applications.find(a=>a.slug==='flagi')!;
const apparel=applications.find(a=>a.slug==='odziez')!;
const shoes=applications.find(a=>a.slug==='obuwie')!;
const cards=p.gallery.filter(i=>i.kind==='original');
const hero='/media/shiro/shiro-brand-scene.webp';
---
<article class="shiro-case case-study">
  <header class="shiro-intro frame">
    <a class="breadcrumb" href="/realizacje">← Wszystkie realizacje</a>
    <div class="intro-grid"><div><span class="label">SHIRO / LOGO I MATERIAŁY MARKI</span><h1>SHIRO<span>.</span></h1></div><div><p>Jeden znak.<br/>Cała rodzina materiałów.</p><span class="credit">Projekt: Dawid Wosiek / NADX</span></div></div>
    <nav class="case-nav" aria-label="W tej realizacji"><a href="#logo-title">Logo</a><a href="#identity-title">Typografia</a><a href="#gallery-title">Wizytówki</a>{applications.map(a=><a href={`#application-${a.slug}`}>{a.label}</a>)}</nav>
  </header>

  <figure class="shiro-hero frame"><img src={hero} srcset="/media/shiro/shiro-brand-scene-768.webp 768w, /media/shiro/shiro-brand-scene.webp 1536w" sizes="(max-width: 600px) 100vw, min(90vw, 1280px)" alt="Wizualizacja materiałów marki SHIRO: dwa stosy wizytówek i voucher w kompozycji fotograficznej na bieli." width="1536" height="1024" fetchpriority="high"/><figcaption><span>SHIRO / rodzina materiałów</span><span>Wizualizacja projektu</span></figcaption></figure>

  <section class="identity-section frame" aria-labelledby="logo-title">
    <div class="section-rule"><span class="label">01 / PODSTAWA IDENTYFIKACJI</span><span class="label muted">LOGO · TYPOGRAFIA · KOLOR</span></div>
    <div class="section-heading"><h2 id="logo-title">Motoryzacyjny charakter.<br/>Własne liternictwo.</h2><p>Znak SHIRO łączy autorskie litery z motywem bieżnika. Czerń, czerwień i geometryczne detale wracają w kolejnych materiałach.</p></div>
    <div class="identity-grid"><figure class="logo-stage"><img src={p.logo!.src} alt={p.logo!.alt} width={p.logo!.width} height={p.logo!.height} class="logo-inverted"/><figcaption>Autorski projekt logo / wariant jednobarwny</figcaption></figure><div class="type-panel"><span class="label muted">TYPOGRAFIA</span><h3 id="identity-title">Red Hat Display</h3><p class="type-sample">Aa Bb Cc<br/>0123456789</p><div class="colors" aria-label="Kolory prezentowanych materiałów"><span style="--color:#101010">Czerń</span><span style="--color:#ed151c">Czerwień</span><span style="--color:#fff">Biel</span></div></div></div>
  </section>

  <section class="case-print frame" aria-labelledby="gallery-title">
    <div class="section-rule"><span class="label">02 / PIERWSZY KONTAKT Z MARKĄ</span><span class="label muted">DWA OBSZARY DZIAŁALNOŚCI</span></div>
    <div class="section-heading"><h2 id="gallery-title">Dwa warianty.<br/>Wspólny charakter.</h2><p>Mechanic &amp; Chiptuning oraz Car Rental. Ta sama identyfikacja, różne układy informacji i akcenty dopasowane do działalności.</p></div>
    <div class="cards-composition"><figure class="case-hero case-cards"><BusinessCards cards={cards}/><figcaption>Wizytówki SHIRO / prezentacja oryginalnych projektów.</figcaption></figure><div class="card-originals"><span class="label muted">ORYGINALNE PROJEKTY / POWIĘKSZ</span>{cards.map((card,i)=><figure class="source-item" data-kind="original"><button type="button" class="visual-open" data-shiro-src={card.src} data-shiro-title={i===0?'Mechanic & Chiptuning — oryginalny projekt':'Car Rental — oryginalny projekt'} aria-label={`Powiększ projekt wizytówki: ${i===0?'Mechanic & Chiptuning':'Car Rental'}`}><ProjectImage media={card}/></button><figcaption>{i===0?'01 / Mechanic & Chiptuning':'02 / Car Rental'}</figcaption></figure>)}</div></div>
  </section>

  <section class="application-section voucher-section frame" id="application-vouchery" aria-labelledby="title-vouchery">
    <div class="section-rule application-rule"><span class="label">03 / VOUCHER PODARUNKOWY</span><span class="label muted">AWERS I REWERS</span></div>
    <div class="section-heading"><h2 id="title-vouchery">Prezent w stylu SHIRO.</h2><p>Charakter marki na awersie, miejsce na najważniejsze informacje na rewersie. Obie strony tworzą jeden materiał.</p></div>
    <div class="voucher-pair">{voucher.originals!.map((image,i)=><figure class="source-item" data-kind="original"><button type="button" class="visual-open" data-shiro-src={image.src} data-shiro-title={i===0?'Voucher SHIRO — awers':'Voucher SHIRO — rewers'} aria-label={`Powiększ ${i===0?'awers':'rewers'} vouchera SHIRO`}><ProjectImage media={image} sizes="(max-width: 760px) 88vw, 43vw"/></button><figcaption>{i===0?'Awers / znak i komunikat':'Rewers / pola do uzupełnienia'}</figcaption></figure>)}</div>
  </section>

  <section class="application-section sticker-section frame" id="application-naklejki" aria-labelledby="title-naklejki">
    <div class="sticker-copy"><span class="label">04 / MAŁY FORMAT</span><h2 id="title-naklejki">Motyw, który<br/>wraca w detalach.</h2><p>Sześciokąty i czerwone akcenty budują tło dla znaku. Naklejka rozwija język marki w prostym, zwartym formacie.</p></div><figure class="source-item" data-kind="original"><button type="button" class="visual-open" data-shiro-src={sticker.original!.src} data-shiro-title="Naklejka SHIRO Car Rental — oryginalny projekt" aria-label="Powiększ oryginalny projekt naklejki SHIRO"><ProjectImage media={sticker.original!} sizes="(max-width: 760px) 88vw, 46vw"/></button><figcaption>Naklejka Car Rental / oryginalny projekt.</figcaption></figure>
  </section>

  <div class="advertising-group frame">
    <section class="application-section banner-section" id="application-baner" aria-labelledby="title-baner"><div class="section-rule application-rule"><span class="label">05 / REKLAMA ZEWNĘTRZNA</span></div><div class="section-heading"><h2 id="title-baner">Marka w większej skali.</h2><p>Wspólne kolory i znak przechodzą na reklamę. Duży format porządkuje ofertę i dane kontaktowe.</p></div><figure><button type="button" class="visual-open banner-crop" data-shiro-src={banner.image!.src} data-shiro-title="Baner SHIRO — wizualizacja projektu" aria-label="Powiększ wizualizację banera SHIRO"><svg viewBox="48 138 1440 735" role="img" aria-labelledby="shiro-banner-title"><title id="shiro-banner-title">{banner.image!.alt}</title><image href={banner.image!.src} width="1536" height="1024"/></svg></button><figcaption>Baner SHIRO Mechanic &amp; Chiptuning / wizualizacja projektu.</figcaption></figure></section>
    <section class="application-section flags-section" id="application-flagi" aria-labelledby="title-flagi"><div class="application-rule flag-rule"><span class="label">FLAGI / DWA KOMUNIKATY</span></div><div class="flags-grid"><div><h2 id="title-flagi">Ten sam znak.<br/>Czytelna informacja.</h2><p>Pionowy układ usług, geometryczny detal i logo przy podstawie łączą flagi z pozostałymi materiałami.</p><span class="flags-label">WULKANIZACJA / MECHANIKA</span></div><figure><button type="button" class="visual-open flags-crop" data-shiro-src={flags.image!.src} data-shiro-title="Flagi SHIRO — wizualizacja projektu" aria-label="Powiększ wizualizację flag SHIRO"><svg viewBox="280 0 1000 1024" role="img" aria-labelledby="shiro-flags-title"><title id="shiro-flags-title">{flags.image!.alt}</title><image href={flags.image!.src} width="1536" height="1024"/></svg></button><figcaption>Flagi Wulkanizacja i Mechanika / wizualizacja projektu.</figcaption></figure></div></section>
  </div>

  <section class="application-section apparel-section frame" id="application-odziez" aria-labelledby="title-odziez"><div class="section-rule application-rule"><span class="label">06 / ODZIEŻ</span><span class="label muted">ZNAK NA NOWYM NOŚNIKU</span></div><div class="section-heading"><h2 id="title-odziez">Od identyfikacji<br/>do odzieży.</h2><p>Czarna koszulka i bluza z niewielkim znakiem. Obejrzyj oryginalne animowane wizualizacje, aby zobaczyć rozmieszczenie logo z różnych stron.</p></div><figure class="apparel-scene"><img src="/media/shiro/shiro-apparel-scene.webp" srcset="/media/shiro/shiro-apparel-scene-768.webp 768w, /media/shiro/shiro-apparel-scene.webp 1536w" sizes="(max-width: 600px) 88vw, min(90vw, 1280px)" alt="Wizualizacja czarnej koszulki i bluzy SHIRO z niewielkim logo, naturalną fakturą bawełny i detalami materiału." width="1536" height="1024" loading="lazy"/><figcaption>Odzież SHIRO / wizualizacja projektu.</figcaption></figure><ProjectFilms videos={apparel.videos!} section="shiro-odziez"/></section>

  <section class="application-section footwear-section frame" id="application-obuwie" aria-labelledby="title-obuwie"><div class="section-rule application-rule"><span class="label">07 / ROZWINIĘCIE JĘZYKA MARKI</span><strong>Projekt koncepcyjny</strong></div><div class="section-heading"><h2 id="title-obuwie">Charakter marki.<br/>Jeszcze jeden krok.</h2><p>Koncepcja graficzna obuwia przenosi czerwień, literę H i wzór sześciokątów na nową formę. Wizualizacja i plansza pokazują dwa poziomy prezentacji tego samego pomysłu.</p></div><div class="footwear-grid"><figure><button type="button" class="visual-open" data-shiro-src={shoes.image!.src} data-shiro-title="Obuwie SHIRO — wizualizacja koncepcji" aria-label="Powiększ wizualizację koncepcji obuwia SHIRO"><ProjectImage media={shoes.image!} sizes="(max-width: 760px) 88vw, 50vw"/></button><figcaption>Wizualizacja koncepcji graficznej obuwia.</figcaption></figure><figure class="shoe-original source-item" data-kind="original"><button type="button" class="visual-open" data-shiro-src={shoes.original!.src} data-shiro-title="Obuwie SHIRO — oryginalne widoki projektu" aria-label="Powiększ oryginalny projekt koncepcyjny obuwia"><svg viewBox="0 0 1300 836" role="img" aria-labelledby="shiro-shoe-source-title"><title id="shiro-shoe-source-title">{shoes.original!.alt}</title><defs><clipPath id="shoe-original-mask"><path d="M549,-0.5L556.5,1L595.5,66L601.5,89L601.5,112L635,133.5L674,149.5L684,151.5L711,151.5L746,142.5L774,125.5L788.5,111L807.5,81L824,65.5L836,62.5L849.5,77L864.5,130L873.5,182L876.5,257L872.5,287L879.5,295L879.5,356L881.5,359L881.5,366L879.5,368L881.5,379L879.5,393L867.5,411L852,425.5L824,440.5L793,447.5L779,447.5L776,442.5L773,447.5L766,447.5L764,442.5L761.5,443L760,447.5L753,447.5L750.5,445L751,442.5L748.5,443L747,447.5L740,447.5L738,442.5L735.5,443L734,447.5L727,447.5L724,442.5L721,447.5L714,447.5L712,442.5L709.5,443L708,447.5L701,447.5L699,442.5L696.5,443L695,447.5L688,447.5L686,442.5L683.5,443L682,447.5L675,447.5L673,442.5L670.5,443L669,447.5L662,447.5L660,442.5L657.5,443L656,447.5L649,447.5L647,442.5L644.5,443L643,447.5L636,447.5L634,442.5L631.5,443L632.5,445L630,447.5L623,447.5L621,442.5L618.5,443L617,447.5L610,447.5L606,442.5L604,447.5L597,447.5L595,442.5L592.5,443L591,447.5L584,447.5L582,442.5L579.5,443L578,447.5L571,447.5L569,442.5L566.5,443L565,447.5L558,447.5L556,442.5L552,447.5L545,447.5L543,442.5L539,447.5L532,447.5L530,442.5L527.5,443L528.5,445L526,447.5L519,447.5L517,442.5L513,447.5L506,447.5L504,442.5L500,447.5L493,447.5L490,442.5L487,447.5L480,447.5L478,442.5L474,447.5L467,447.5L464,442.5L461,447.5L454,447.5L452,442.5L448,447.5L441,447.5L439,442.5L435,447.5L428,447.5L426,442.5L423.5,443L424.5,445L422,447.5L415,447.5L413,442.5L409,447.5L402,447.5L400,442.5L396,447.5L389,447.5L387,442.5L383,447.5L376,447.5L374,442.5L370,447.5L363,447.5L361,442.5L357,447.5L350,447.5L348,442.5L344,447.5L337,447.5L335,442.5L331,447.5L324,447.5L321,442.5L318,447.5L311,447.5L308,442.5L305,447.5L298,447.5L295,442.5L292,447.5L285,447.5L283,442.5L279,447.5L273,447.5L270,442.5L266,447.5L259,446.5L257,442.5L254,446.5L246,446.5L244,442.5L241,446.5L234,446.5L231,442.5L228,445.5L220,445.5L217,441.5L214,445.5L207,444.5L204,440.5L200,444.5L194,443.5L192.5,440L190,439.5L188,443.5L181,442.5L179,438.5L176,441.5L169,441.5L165,437.5L154,439.5L151.5,437L152.5,436L150,435.5L148,438.5L145,438.5L139,437.5L137,433.5L134,435.5L127,435.5L124,430.5L121,433.5L117,433.5L94,428.5L44,411.5L21,399.5L5.5,387L-0.5,373L0.5,323L4.5,320L1.5,317L1.5,311L8.5,303L11.5,288L17.5,274L22.5,266L33,255.5L43,250.5L53,248.5L61,250.5L105,237.5L191,216.5L216,204.5L225,198.5L236,194.5L237.5,189L253,177.5L261,174.5L267,176.5L272,173.5L272.5,168L289,155.5L296,152.5L304,153.5L304.5,151L322,135.5L330,131.5L336,133.5L351,118.5L361,113.5L368,113.5L378,101.5L388,94.5L397,90.5L405,90.5L408.5,88L407.5,85L419,74.5L430,69.5L435,71.5L443,61.5L453,54.5L462,50.5L466,51.5L549,-0.5Z M1136,0.5L1170,3.5L1186,9.5L1188.5,16L1198,22.5L1209.5,38L1226.5,54L1256.5,102L1266.5,126L1272.5,159L1275.5,193L1275.5,269L1283.5,300L1285.5,317L1296.5,327L1297.5,330L1297.5,337L1294.5,343L1296.5,345L1297.5,411L1295.5,415L1289,419.5L1271,424.5L1267.5,430L1269.5,437L1261,447.5L1014,447.5L1005,443.5L1001,435.5L983,431.5L973.5,423L971.5,406L971.5,350L969.5,348L969.5,342L981.5,329L985.5,309L994.5,290L994.5,262L998.5,235L1013.5,152L1021.5,122L1037.5,91L1082.5,26L1099,13.5L1099.5,9L1104,5.5L1136,0.5Z M236,521.5L267,521.5L295,524.5L382,540.5L585,541.5L699,549.5L753,549.5L774,551.5L801,557.5L824,567.5L838,577.5L853.5,595L865.5,614L874.5,634L881.5,658L882.5,673L878.5,695L863.5,731L850.5,750L838,762.5L819,773.5L794,783.5L739,797.5L728,797.5L721,800.5L713,798.5L707,800.5L700,799.5L656,804.5L606,804.5L602,806.5L566,808.5L563,810.5L555,809.5L549,812.5L545,810.5L536,813.5L526,812.5L524,814.5L505,814.5L503,816.5L498,815.5L488,818.5L453,820.5L360,835.5L244,835.5L193,825.5L166,816.5L122,795.5L78,770.5L45,746.5L22.5,722L7.5,693L2.5,664L3.5,640L10.5,616L24.5,593L42,575.5L67,558.5L96,545.5L138,533.5L172,527.5L236,521.5Z"/></clipPath></defs><image href={shoes.original!.src} width="1300" height="836" clip-path="url(#shoe-original-mask)"/></svg></button><figcaption>Oryginalna koncepcja / bok, tył i widok z góry.</figcaption></figure></div></section>

  <section class="case-scope frame" aria-labelledby="scope-title"><div><span class="label">ZAKRES MOJEJ PRACY</span><h2 id="scope-title">Od autorskiego znaku<br/>do rodziny materiałów.</h2></div><ul>{p.scopeItems!.map((item,i)=><li><span>{String(i+1).padStart(2,'0')}</span>{item}</li>)}</ul></section>
</article>
<section class="shiro-cta"><div class="frame"><h2>Twoja marka.<br/>Spójna w każdym formacie.</h2><a class="button" href="/kontakt?projekt=SHIRO&usluga=logo-i-identyfikacja" data-track="portfolio_contact" data-project={p.slug}>Chcę podobny projekt <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></a></div></section>
<dialog class="shiro-zoom" aria-labelledby="shiro-zoom-title"><div class="zoom-toolbar"><h2 id="shiro-zoom-title">Podgląd projektu</h2><button type="button" class="zoom-close">Zamknij <span aria-hidden="true">×</span></button></div><img alt=""/></dialog>
<script>
const zoom=document.querySelector<HTMLDialogElement>('.shiro-zoom');
let trigger:HTMLButtonElement|null=null;
document.querySelectorAll<HTMLButtonElement>('[data-shiro-src]').forEach(button=>button.addEventListener('click',()=>{if(!zoom)return;trigger=button;const image=zoom.querySelector('img')!;image.src=button.dataset.shiroSrc!;image.alt=button.dataset.shiroTitle!;zoom.querySelector('#shiro-zoom-title')!.textContent=image.alt;zoom.showModal();zoom.querySelector<HTMLButtonElement>('.zoom-close')?.focus();}));
zoom?.querySelector('.zoom-close')?.addEventListener('click',()=>zoom.close());
zoom?.addEventListener('close',()=>trigger?.focus({preventScroll:true}));
zoom?.addEventListener('click',event=>{if(event.target!==zoom)return;const b=zoom.getBoundingClientRect();if(event.clientX<b.left||event.clientX>b.right||event.clientY<b.top||event.clientY>b.bottom)zoom.close();});
</script>
<style>
 @font-face{font-family:'Shiro Red Hat';src:url('/fonts/red-hat-display.woff2') format('woff2');font-weight:300 900;font-style:normal;font-display:swap}
 .shiro-case{--shiro-red:#ed151c;background:#fff;--accent:#ed151c}
