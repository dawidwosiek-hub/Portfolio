---
import segs from '../../public/media/cine/showreel.json';
---
<section class="reel" aria-labelledby="reel-title">
 <div class="reel-head">
  <h2 id="reel-title">Realizacje w ruchu.</h2>
  <p>Prawdziwe projekty, na prawdziwych nośnikach. Kliknij nazwę, żeby zobaczyć cały projekt.</p>
 </div>
 <div class="reel-frame">
  <video id="reel-v" muted loop playsinline preload="none" poster="/media/cine/showreel-poster.jpg" aria-label="Montaż wybranych realizacji NADX">
   <source data-src="/media/cine/showreel.mp4?v=1" type="video/mp4"/>
  </video>
  <div class="reel-grain" aria-hidden="true"></div>
  <a class="reel-cap" id="reel-cap" href={`/realizacje/${segs[0].slug}`}>
   <span class="reel-n" id="reel-n">01</span>
   <span class="reel-t"><b id="reel-name">{segs[0].name}</b><small id="reel-kind">{segs[0].kind}</small></span>
   <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg>
  </a>
  <button class="reel-pp" id="reel-pp" type="button" aria-label="Wstrzymaj film">❚❚</button>
  <ol class="reel-ticks" aria-label="Rozdziały filmu">
   {segs.map((s,i)=><li><button type="button" data-i={i} aria-label={`Przejdź do: ${s.name}`}><i></i></button></li>)}
  </ol>
 </div>
</section>
<script type="application/json" id="reel-segs" set:html={JSON.stringify(segs)}></script>
<script is:inline>(()=>{
const v=document.getElementById('reel-v');if(!v)return;
const S=JSON.parse(document.getElementById('reel-segs').textContent);
const cap=document.getElementById('reel-cap'),nm=document.getElementById('reel-name'),kd=document.getElementById('reel-kind'),nn=document.getElementById('reel-n'),pp=document.getElementById('reel-pp');
const ticks=[...document.querySelectorAll('.reel-ticks button')];
const RM=matchMedia('(prefers-reduced-motion: reduce)').matches;
let loaded=false,cur=-1,userPaused=RM;
const load=()=>{if(loaded)return;loaded=true;const s=v.querySelector('source');s.src=s.dataset.src;v.load();};
const set=i=>{if(i===cur)return;cur=i;const s=S[i];cap.href='/realizacje/'+s.slug;nm.textContent=s.name;kd.textContent=s.kind;nn.textContent=String(i+1).padStart(2,'0');cap.classList.remove('in');void cap.offsetWidth;cap.classList.add('in');ticks.forEach((b,k)=>b.classList.toggle('on',k===i));};
const tick=()=>{const t=v.currentTime;let i=S.findIndex(s=>t>=s.t0&&t<s.t1);if(i<0)i=S.length-1;set(i);const p=(t-S[i].t0)/(S[i].t1-S[i].t0);ticks[i].style.setProperty('--p',Math.min(1,p));if(!v.paused)requestAnimationFrame(tick);};
v.addEventListener('play',()=>{pp.textContent='❚❚';pp.setAttribute('aria-label','Wstrzymaj film');requestAnimationFrame(tick);});
v.addEventListener('pause',()=>{pp.textContent='▶';pp.setAttribute('aria-label','Odtwórz film');});
pp.addEventListener('click',()=>{if(v.paused){userPaused=false;load();v.play().catch(()=>{});}else{userPaused=true;v.pause();}});
ticks.forEach(b=>b.addEventListener('click',()=>{load();const i=+b.dataset.i;const go=()=>{v.currentTime=S[i].t0+.05;set(i);if(!userPaused)v.play().catch(()=>{});};v.readyState>0?go():v.addEventListener('loadedmetadata',go,{once:true});}));
if(RM){pp.textContent='▶';set(0);return;}
new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){load();if(!userPaused)v.play().catch(()=>{});}else v.pause();}),{rootMargin:'200px 0px',threshold:.15}).observe(v);
set(0);
})();</script>
<style>
 .reel{background:#050505;color:#fff;padding:90px 0 0}
 .reel-head{width:90%;max-width:1500px;margin:0 auto 34px;display:grid;grid-template-columns:1.2fr 1fr;gap:40px;align-items:end}
 .reel-head h2{font-size:clamp(2.6rem,5.2vw,5.6rem);letter-spacing:-.06em}
 .reel-head p{color:#a9a9a9;font-size:.95rem}
 .reel-frame{position:relative;width:100%;aspect-ratio:16/9;max-height:88vh;background:#000;overflow:hidden}
 .reel-frame video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
 .reel-grain{position:absolute;inset:0;pointer-events:none;background:linear-gradient(180deg,#050505 0,transparent 18%,transparent 62%,#050505d9 100%)}
 .reel-cap{position:absolute;left:5%;bottom:13%;display:flex;align-items:center;gap:22px;color:#fff;max-width:80%}
 .reel-cap.in{animation:capin .6s cubic-bezier(.2,.8,.2,1)}
 @keyframes capin{from{opacity:0;transform:translateY(18px)}to{opacity:1;transform:none}}
 .reel-n{font-size:.8rem;color:var(--yellow);font-weight:700;border:1px solid #ffcc0080;padding:6px 8px}
 .reel-t{display:flex;flex-direction:column}
 .reel-t b{font-size:clamp(1.6rem,3.6vw,3.6rem);letter-spacing:-.05em;line-height:1;font-weight:750}
 .reel-t small{font-size:.85rem;color:#cfcfcf;margin-top:8px}
 .reel-cap .arrow{width:34px;height:34px;flex-shrink:0;transition:transform .2s}
 .reel-cap:hover .arrow,.reel-cap:focus-visible .arrow{transform:translate(4px,-4px);color:var(--yellow)}
 .reel-pp{position:absolute;right:5%;bottom:13%;width:48px;height:48px;border-radius:50%;border:1px solid #ffffff70;background:#00000060;color:#fff;font-size:.85rem}
 .reel-pp:hover{background:var(--yellow);color:#000;border-color:var(--yellow)}
 .reel-ticks{position:absolute;left:5%;right:5%;bottom:5%;display:flex;gap:6px;list-style:none;margin:0;padding:0}
 .reel-ticks li{flex:1}
 .reel-ticks button{display:block;width:100%;height:20px;background:none;border:0;padding:8px 0}
 .reel-ticks i{display:block;height:3px;background:#ffffff40;position:relative;overflow:hidden}
 .reel-ticks i:after{content:'';position:absolute;inset:0;background:var(--yellow);transform-origin:0 50%;transform:scaleX(0)}
 .reel-ticks button.on i:after{transform:scaleX(var(--p,0))}
 .reel-ticks button:hover i{background:#ffffff80}
 @media (max-width:760px){.reel-head{grid-template-columns:1fr;gap:16px}.reel-frame{aspect-ratio:4/5}.reel-cap{bottom:16%;gap:14px}.reel-pp{bottom:auto;top:20px}}
</style>
