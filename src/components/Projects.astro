---
import {projects,projectCategories} from '../lib/content';
import ProjectImage from './ProjectImage.astro';
const {featured=false} = Astro.props;
const selected = featured ? projects.filter(p=>p.featured).slice(0,6) : projects;
const wide=(i:number)=>i%3===0;
const mediaFor=(p:typeof projects[number])=>p.cover||{src:p.image,smallSrc:p.imageSmall,mediumSrc:p.imageMedium,alt:p.alt,width:p.imageWidth,height:p.imageHeight};
---
{selected.length ? <div class="work-grid">{selected.map((p,i)=><a href={`/realizacje/${p.slug}`} class={`project work-card${wide(i)?' wide':''}`} data-category={p.category} data-categories={JSON.stringify(projectCategories(p))}>
  <div class="work-image"><ProjectImage media={mediaFor(p)} sizes={wide(i)?'100vw':'(max-width:760px) 100vw, 50vw'}/></div>
  <div class="work-text"><h3>{p.name}</h3><span class="work-type">{p.category}</span><p>{p.teaser||p.scope}</p></div>
</a>)}</div> : <div class="portfolio-empty"><h3>Realizacje pojawią się wkrótce.</h3><p>W tym czasie poznaj zakres usług i opowiedz mi o swoim projekcie.</p><a class="text-link" href="/oferta">Poznaj ofertę</a></div>}
