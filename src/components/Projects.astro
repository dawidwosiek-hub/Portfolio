---
import {projects,projectCategories} from '../lib/content';
import ProjectImage from './ProjectImage.astro';
const {featured=false,compact=false} = Astro.props;
const selected = featured ? projects.filter(p=>p.featured).slice(0,6) : projects;
---
{selected.length ? <div class:list={["project-grid",{compact}]}>{selected.map((p,i)=><a href={`/realizacje/${p.slug}`} class:list={['project',{'wide':!compact&&i%3===0,'with-logo':!!p.logo,'with-print-mockup':!!(p.mockup||p.apparel)}]} data-category={p.category} data-categories={JSON.stringify(projectCategories(p))}><div class="project-image"><ProjectImage media={{src:p.image,smallSrc:p.imageSmall,mediumSrc:p.imageMedium,alt:p.alt,width:p.imageWidth,height:p.imageHeight}} sizes={compact?'(max-width: 760px) 88vw, 29vw':i%3===0?'90vw':'(max-width: 760px) 88vw, 44vw'}/><span aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></span></div><div class="project-meta"><h3>{p.name}</h3><span>{projectCategories(p).join(' · ')}</span></div><p>{p.scope}</p>{p.imageCaption&&<small class="project-visualization-note">{p.imageCaption}</small>}</a>)}</div> : <div class="portfolio-empty"><span class="empty-index">[ WKRÓTCE ]</span><h3>Prace mówią<br/>najwięcej.</h3><p>Wybrane realizacje pojawią się tutaj po uzupełnieniu materiałów. W tym czasie poznaj zakres usług i opowiedz mi o swoim projekcie.</p><a class="text-link" href="/oferta">Poznaj ofertę <span aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></span></a></div>}

<style>
 .project-grid.compact{grid-template-columns:repeat(3,minmax(0,1fr));gap:34px}.compact .project{min-width:0}.compact .project-image :global(img){aspect-ratio:1.4;object-fit:contain;background:#fff}.compact .project-meta{display:block}.compact .project-meta h3{font-size:1.5rem;margin-bottom:9px}.compact .project-meta>span{font-size:.68rem}.compact .project>p{font-size:.83rem;line-height:1.8}.compact .project-visualization-note{font-size:.63rem;line-height:1.7}@media(max-width:760px){.project-grid.compact{grid-template-columns:1fr;gap:30px}.compact .project-meta h3{font-size:1.5rem}.compact .project-image :global(img){aspect-ratio:1.45}}
</style>
