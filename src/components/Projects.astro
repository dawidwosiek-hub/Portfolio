---
import {projects,projectCategories} from '../lib/content';
import ProjectImage from './ProjectImage.astro';
const {featured=false} = Astro.props;
const selected = featured ? projects.filter(p=>p.featured).slice(0,6) : projects;
---
{selected.length ? <div class="project-grid">{selected.map((p,i)=><a href={`/realizacje/${p.slug}`} class:list={['project',{'wide':i%3===0,'with-logo':!!p.logo}]} data-category={p.category} data-categories={JSON.stringify(projectCategories(p))}><div class="project-image"><ProjectImage media={{src:p.image,smallSrc:p.imageSmall,alt:p.alt,width:p.imageWidth,height:p.imageHeight}} sizes={i%3===0?'90vw':'(max-width: 760px) 88vw, 44vw'}/><span aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></span></div><div class="project-meta"><h3>{p.name}</h3><span>{projectCategories(p).join(' · ')}</span></div><p>{p.scope}</p>{p.imageCaption&&<small class="project-visualization-note">{p.imageCaption}</small>}</a>)}</div> : <div class="portfolio-empty"><span class="empty-index">[ WKRÓTCE ]</span><h3>Prace mówią<br/>najwięcej.</h3><p>Wybrane realizacje pojawią się tutaj po uzupełnieniu materiałów. W tym czasie poznaj zakres usług i opowiedz mi o swoim projekcie.</p><a class="text-link" href="/oferta">Poznaj ofertę <span aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></span></a></div>}
