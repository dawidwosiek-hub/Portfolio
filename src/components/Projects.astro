---
import {projects} from '../lib/content';
const {featured=false} = Astro.props;
const selected = featured ? projects.filter(p=>p.featured).slice(0,6) : projects;
---
{selected.length ? <div class="project-grid">{selected.map((p,i)=><a href={`/realizacje/${p.slug}`} class:list={['project',{'wide':i%3===0}]} data-category={p.category}><div class="project-image"><img src={p.image} alt={p.alt} loading="lazy" width="1200" height="900"/><span aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></span></div><div class="project-meta"><h3>{p.name}</h3><span>{p.category}</span></div><p>{p.scope}</p></a>)}</div> : <div class="portfolio-empty"><span class="empty-index">[ WKRÓTCE ]</span><h3>Prace mówią<br/>najwięcej.</h3><p>Wybrane realizacje pojawią się tutaj po uzupełnieniu materiałów. W tym czasie poznaj zakres usług i opowiedz mi o swoim projekcie.</p><a class="text-link" href="/oferta">Poznaj ofertę <span aria-hidden="true"><svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></span></a></div>}
