---
// Hero „przewijany film”: klatki filmu AI rysowane na canvas zgodnie z postępem przewijania.
// Nad filmem: hasła poszczególnych scen i ostre kadry prawdziwych realizacji (1:1, nie generowane).
import {projects} from '../lib/content';
interface Cap{from:number;to:number;k?:string;t:string;align?:'l'|'c'|'r'}
interface Work{from:number;to:number;slug:string;side:'l'|'r'}
const {name='nadx',captions=[] as Cap[],works=[] as Work[],poster=''}=Astro.props;
const V='20261124a';
const W=works.map(w=>{const p=projects.find(x=>x.slug===w.slug);return p&&p.imageSmall?{...w,name:p.name,cat:p.category,src:`${p.imageSmall.replace(/-768\.webp$/,'-1536.webp')}?v=${V}`,alt:p.imageAlt||p.name}:null}).filter(Boolean);
---
<section id="sf" class="sf" data-film={`/media/film/${name}`} aria-label="NADX: grafika, druk i film">
 <div class="sf-pin">
  <canvas id="sf-c" aria-hidden="true"></canvas>
  {poster&&<img class="sf-poster" src={poster} alt="" aria-hidden="true"/>}
  <div class="sf-shade" aria-hidden="true"></div>
  <div class="sf-wrap">
   {captions.map((c,i)=><div class={`sf-cap sf-${c.align||'l'}`} data-from={c.from} data-to={c.to}>{c.k&&<p class="sf-k">{c.k}</p>}<p class="sf-t" set:html={c.t}/></div>)}
   {W.map(w=><a class={`sf-work sf-w${w!.side}`} href={`/realizacje/${w!.slug}`} data-from={w!.from} data-to={w!.to} tabindex="-1"><img src={w!.src} alt={w!.alt} loading="lazy" decoding="async"/><span><small>{w!.cat}</small>{w!.name}</span></a>)}
   <div class="sf-end" data-from="0.9" data-to="1.01">
    <p class="sf-k">Dawid Wosiek / grafika i wideo</p>
    <h1>Logo i grafika. Wideo dla <u>Twojej firmy.</u></h1>
    <p class="sf-lead">Projektuję identyfikację, materiały reklamowe i nadruki. Montuję filmy dla firm i twórców.</p>
    <div class="sf-row"><a class="sf-btn" href="/realizacje">Zobacz realizacje</a><a class="sf-btn sf-ghost" href="/kontakt">Zapytaj o wycenę</a></div>
   </div>
  </div>
  <div class="sf-hint" aria-hidden="true"><i></i>Przewiń</div>
  <div class="sf-prog" aria-hidden="true"><i></i></div>
  <div class="sf-load" aria-hidden="true"><i></i></div>
 </div>
</section>
<style is:global>
#sf{position:relative;height:820vh;background:#060504;color:#fff}
#sf .sf-pin{position:sticky;top:0;height:100vh;height:100svh;overflow:hidden}
#sf canvas,#sf .sf-poster{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;display:block}
#sf .sf-poster{transition:opacity .6s}#sf.sf-ok .sf-poster{opacity:0}
#sf .sf-shade{position:absolute;inset:0;pointer-events:none;background:radial-gradient(120% 80% at 50% 50%,transparent 45%,rgba(0,0,0,.55)),linear-gradient(0deg,rgba(0,0,0,.45),transparent 35%)}
#sf .sf-wrap{position:absolute;inset:0;padding:0 max(5%,calc((100% - 1620px) / 2))}
#sf .sf-cap,#sf .sf-end{position:absolute;top:50%;left:max(5%,calc((100% - 1620px) / 2));right:max(5%,calc((100% - 1620px) / 2));opacity:0;transform:translateY(calc(-50% + var(--y,24px)));will-change:opacity,transform,filter;pointer-events:none}
#sf .sf-c{text-align:center}#sf .sf-r{text-align:right}
#sf .sf-cap::before,#sf .sf-end::before{content:"";position:absolute;z-index:-1;top:-45vh;bottom:-45vh;left:-12vw;right:-12vw;background:linear-gradient(90deg,rgba(0,0,0,.86),rgba(0,0,0,.62) 38%,rgba(0,0,0,0) 66%);pointer-events:none}
#sf .sf-r::before{background:linear-gradient(270deg,rgba(0,0,0,.86),rgba(0,0,0,.62) 38%,rgba(0,0,0,0) 66%)}
#sf .sf-c::before{background:radial-gradient(60% 50% at 50% 50%,rgba(0,0,0,.8),rgba(0,0,0,.45) 60%,rgba(0,0,0,0))}
#sf .sf-cap,#sf .sf-end{z-index:1;isolation:isolate}
#sf .sf-k{font-size:14px;text-shadow:0 1px 10px #000;font-weight:600;color:#ffcc00;margin:0 0 14px;max-width:none}
#sf .sf-t{font-size:clamp(36px,4.8vw,88px);line-height:1;font-weight:800;letter-spacing:-.04em;margin:0;max-width:12ch;text-wrap:balance;color:#fff;text-shadow:0 2px 24px rgba(0,0,0,.8),0 0 2px rgba(0,0,0,.6)}
#sf .sf-c .sf-t{margin:0 auto}#sf .sf-r .sf-t{margin-left:auto}
#sf .sf-t em{font-style:normal;color:#ffcc00}
#sf .sf-work{position:absolute;top:50%;width:min(30vw,480px);z-index:2;opacity:0;transform:translateY(calc(-50% + var(--y,40px))) scale(var(--s,.96));background:#111;box-shadow:0 30px 80px rgba(0,0,0,.6);pointer-events:none;color:#fff;will-change:opacity,transform}
#sf .sf-work img{display:block;width:100%;aspect-ratio:3/2;object-fit:cover}
#sf .sf-work span{display:block;padding:12px 16px 14px;font-weight:700;font-size:16px;letter-spacing:-.02em}
#sf .sf-work small{display:block;font-weight:600;font-size:11px;color:#ffcc00;margin-bottom:2px}
#sf .sf-work small::first-letter{text-transform:uppercase}
#sf .sf-wr{right:max(5%,calc((100% - 1620px) / 2))}#sf .sf-wl{left:max(5%,calc((100% - 1620px) / 2))}
#sf .sf-work.on{pointer-events:auto}#sf .sf-work:hover span{background:#ffcc00;color:#000}#sf .sf-work:hover small{color:#000}
#sf .sf-end h1{font-size:clamp(40px,5vw,86px);line-height:.96;font-weight:800;letter-spacing:-.045em;margin:0;max-width:12ch}
#sf .sf-end h1 u{text-decoration:none;box-shadow:inset 0 -.12em #ffcc00}
#sf .sf-end.on{pointer-events:auto}
#sf .sf-lead{color:#d6d6d6;max-width:42ch;margin:20px 0 28px;font-size:17px;line-height:1.55}
#sf .sf-row{display:flex;flex-wrap:wrap;gap:12px 26px;align-items:center}
#sf .sf-btn{display:inline-flex;align-items:center;min-height:48px;padding:12px 22px;background:#ffcc00;color:#000;font-weight:600;font-size:15px}
#sf .sf-btn:hover{background:#fff}
#sf .sf-ghost{background:none;color:#fff;border-bottom:2px solid #fff;padding:10px 2px;min-height:44px}
#sf .sf-ghost:hover{background:none;color:#ffcc00;border-color:#ffcc00}
#sf .sf-btn:focus-visible,#sf .sf-work:focus-visible{outline:2px solid #ffcc00;outline-offset:3px}
#sf .sf-hint{position:absolute;left:50%;bottom:28px;transform:translateX(-50%);font-size:12px;font-weight:600;color:#cfcfcf;display:flex;flex-direction:column;align-items:center;gap:10px;transition:opacity .5s}
#sf .sf-hint i{width:1px;height:40px;background:linear-gradient(#fff0,#fff);animation:sfh 1.8s ease-in-out infinite}
@keyframes sfh{0%{transform:scaleY(0);transform-origin:top}50%{transform:scaleY(1);transform-origin:top}51%{transform-origin:bottom}100%{transform:scaleY(0);transform-origin:bottom}}
#sf.sf-moved .sf-hint{opacity:0}
#sf .sf-prog{position:absolute;left:0;right:0;bottom:0;height:3px;background:rgba(255,255,255,.08)}
#sf .sf-prog i{display:block;height:100%;width:100%;transform-origin:left;transform:scaleX(var(--p,0));background:#ffcc00}
#sf .sf-load{position:absolute;top:0;left:0;right:0;height:2px}
#sf .sf-load i{display:block;height:100%;background:rgba(255,204,0,.5);width:var(--l,0%);transition:width .3s,opacity .6s}
#sf.sf-full .sf-load i{opacity:0}
@media(max-width:860px){
 #sf{height:680vh}
 #sf .sf-t{font-size:clamp(28px,8.4vw,52px);max-width:none}
 #sf .sf-cap,#sf .sf-end{top:auto;bottom:max(64px,9svh);transform:translateY(var(--y,24px))}
 #sf .sf-r,#sf .sf-c{text-align:left}#sf .sf-r .sf-t,#sf .sf-c .sf-t{margin:0}
 #sf .sf-work{width:72vw;top:16svh;transform:translateY(var(--y,40px)) scale(var(--s,.96))}
 #sf .sf-wl{left:6%}#sf .sf-wr{right:6%}
 #sf .sf-lead{display:none}
 #sf .sf-shade{background:linear-gradient(0deg,rgba(0,0,0,.9),rgba(0,0,0,.55) 38%,rgba(0,0,0,.15) 62%,rgba(0,0,0,.35))}
 #sf .sf-cap::before,#sf .sf-end::before{display:none}
 #sf .sf-work{width:64vw}
}
@media(prefers-reduced-motion:reduce){#sf{height:auto}#sf .sf-pin{position:relative}#sf .sf-cap,#sf .sf-work,#sf .sf-hint{display:none}#sf .sf-end{opacity:1;filter:none;transform:translateY(-50%)}#sf.sf-ok .sf-poster{opacity:1}#sf canvas{display:none}}
</style>
<script is:inline>
(()=>{
const root=document.getElementById('sf');if(!root)return;
const cv=document.getElementById('sf-c'),ctx=cv.getContext('2d');
const reduce=matchMedia('(prefers-reduced-motion: reduce)').matches;
const mob=innerWidth<860||matchMedia('(pointer:coarse)').matches&&innerWidth<1100;
const base=root.dataset.film,set=mob?'m':'d';
const items=[...root.querySelectorAll('[data-from]')].map(el=>({el,a:+el.dataset.from,b:+el.dataset.to,work:el.classList.contains('sf-work'),end:el.classList.contains('sf-end')}));
let N=0,frames=[],cur=-1,p=0,sp=0,raf=0,loaded=0;
const pad=i=>String(i).padStart(3,'0');
function size(){const d=Math.min(devicePixelRatio||1,2);cv.width=Math.round(cv.clientWidth*d);cv.height=Math.round(cv.clientHeight*d);cur=-1;}
function nearest(i){if(frames[i]&&frames[i].ok)return frames[i];for(let k=1;k<N;k++){const a=frames[i-k],b=frames[i+k];if(a&&a.ok)return a;if(b&&b.ok)return b;}return null;}
function draw(i){const f=nearest(i);if(!f)return;const im=f.im,W=cv.width,H=cv.height,s=Math.max(W/im.width,H/im.height),w=im.width*s,h=im.height*s;
 // lekki „dolly”: delikatne powiększenie z postępem, żeby ruch nie stawał między klatkami
 const z=1+.04*p;ctx.drawImage(im,(W-w*z)/2,(H-h*z)/2,w*z,h*z);}
function load(i){if(frames[i])return;const im=new Image();im.decoding='async';const f={im,ok:false};frames[i]=f;im.onload=()=>{f.ok=true;loaded++;root.style.setProperty('--l',(loaded/N*100)+'%');if(loaded===N)root.classList.add('sf-full');if(Math.abs(i-Math.round(sp*(N-1)))<3)cur=-1;if(!root.classList.contains('sf-ok')){root.classList.add('sf-ok');cur=-1;}};im.src=`${base}/${set}/${pad(i)}.webp`;}
function progress(){const r=root.getBoundingClientRect(),tot=root.offsetHeight-innerHeight;return Math.min(1,Math.max(0,-r.top/tot));}
const ease=x=>x<0?0:x>1?1:x*x*(3-2*x);
function tick(){raf=requestAnimationFrame(tick);
 p=progress();sp+=(p-sp)*.14;if(Math.abs(p-sp)<.0004)sp=p;
 const i=Math.round(sp*(N-1));if(i!==cur){draw(i);cur=i;}
 root.style.setProperty('--p',sp);
 if(sp>.01)root.classList.add('sf-moved');
 for(const it of items){const len=it.b-it.a,f=Math.min(.06,len*.3);
  let v=it.end?ease((sp-it.a)/f):Math.min(ease((sp-it.a)/f),ease((it.b-sp)/f));
  const s=it.el.style;s.opacity=v.toFixed(3);
  const dir=sp<(it.a+it.b)/2?1:-1;s.setProperty('--y',((1-v)*(it.work?60:28)*dir).toFixed(1)+'px');
  if(!it.work)s.setProperty('--b',((1-v)*10).toFixed(1)+'px');else s.setProperty('--s',(0.94+.06*v).toFixed(3));
  it.el.classList.toggle('on',v>.6);}
}
if(reduce){return;}
fetch(base+'/manifest.json').then(r=>r.json()).then(m=>{N=m[set];frames=new Array(N);
 // najpierw co 8. klatka (szybki podgląd całości), potem co 2., potem reszta
 const order=[];for(const st of [8,4,2,1])for(let i=0;i<N;i+=st)if(!order.includes(i))order.push(i);
 let q=0;const pump=()=>{let n=0;while(q<order.length&&n<6){load(order[q++]);n++;}if(q<order.length)setTimeout(pump,60);};pump();
 size();addEventListener('resize',size);tick();
}).catch(()=>{});
new IntersectionObserver(e=>{if(!e[0].isIntersecting){cancelAnimationFrame(raf);raf=0;}else if(!raf&&N)tick();}).observe(root);
})();
</script>
