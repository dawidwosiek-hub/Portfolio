---
import ProcessArtwork from './ProcessArtwork.astro';
import ProjectInquiry from './ProjectInquiry.astro';
import {media} from '../lib/odwroceni-media';
const steps=[['przestrzen','01','Film'],['kierunek','02','Koncepcja'],['samochod','03','Projekty'],['lodz','04','Łódź'],['zastosowanie','05','Zdjęcia']];
---
<article class="process-case">
  <header class="process-intro frame">
    <a class="back" href="/realizacje">← Wszystkie realizacje</a>
    <div class="intro-meta"><span class="label">ODWRÓCENI / PROJEKTY OKLEJEŃ</span><span class="label credit">DAWID WOSIEK / NADX</span></div>
    <div class="intro-grid"><h1>Odwróceni<span class="dot">.</span></h1><div><p>Projekt oklejenia samochodu i łodzi. Warianty grafiki, rozmieszczenie na bryle oraz wizualizacje pokazujące cały pomysł.</p><a class="intro-quote text-link" href="/kontakt?projekt=Odwr%C3%B3ceni&amp;usluga=druk-i-reklama&amp;temat=oklejenia">Zapytaj o projekt oklejenia <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></a></div></div>
  </header>

  <section id="przestrzen" class="story-section frame" aria-labelledby="story-title">
    <div class="story-header"><h2 id="story-title">Od planszy do wizualizacji.</h2><span>22 s / odtwórz prezentację</span></div>
    <video class="story-film" data-story-film controls muted playsinline preload="none" poster={media.carScene} width="1280" height="720" aria-label="Odwróceni — od planszy do wizualizacji samochodu"><source src={media.storyFilm} type="video/mp4"/></video>
    <div class="story-chapters" role="group" aria-label="Przejdź do etapu filmu"><button type="button" data-story-time="0" aria-pressed="true"><span>01</span>Projekt na planszy</button><button type="button" data-story-time="1.6" aria-pressed="false"><span>02</span>Grafika i detale</button><button type="button" data-story-time="11.6" aria-pressed="false"><span>03</span>Widoki bryły</button></div>
    <div class="story-sources"><button type="button" class="scene-open" data-scene-src={media.carScene} aria-label="Powiększ: samochód Odwróceni — wizualizacja projektu">Powiększ wizualizację samochodu +</button><span>Materiały źródłowe: <a href={media.carFilm} target="_blank" rel="noopener">film z detalami</a> · <a href={media.orbitFilm} target="_blank" rel="noopener">film z różnych stron</a></span></div>
  </section>

  <nav class="process-nav" aria-label="Etapy projektu"><div class="frame">{steps.map(([id,num,name])=><a href={`#${id}`}><span>{num}</span>{name}</a>)}</div></nav>

  <section id="kierunek" class="chapter frame" aria-labelledby="direction-title">
    <div class="chapter-index"><span class="label">01 / KIERUNEK GRAFICZNY</span><span class="chapter-rule"></span></div>
    <div class="chapter-heading"><h2 id="direction-title">Grafika dopasowana<br/>do powierzchni.</h2><p>Duży znak wyznacza główny punkt kompozycji. Ostre cięcia podążają za linią samochodu, a żółte nadwozie staje się częścią projektu.</p></div>
    <div class="direction-board">
      <figure class="direction-drawing"><button class="artwork" type="button" data-artwork aria-label="Powiększ: kompozycja pierwszego boku samochodu"><ProcessArtwork src={media.carSide1} view="car-side-1" id="direction-side" alt="Projekt żółtego samochodu z czarną kompozycją, białymi cięciami i złotym akcentem."/></button><figcaption class="drawing-caption"><span>Kompozycja na boku samochodu</span><span>Powiększ <b aria-hidden="true">+</b></span></figcaption></figure>
      <div class="direction-key"><div class="palette car-palette" aria-label="Kolory projektu samochodu"><span style="--swatch:#ffce00"><i></i>Żółć</span><span style="--swatch:#101010"><i></i>Czerń</span><span style="--swatch:#ffffff"><i></i>Biel</span><span style="--swatch:#b78950"><i></i>Złoty akcent</span></div><div><span class="label">JĘZYK GRAFICZNY</span><h3>Ostre cięcia.<br/>Czytelny znak.<br/>Wyraźny rytm.</h3></div></div>
    </div>
    <div class="composition-study" aria-labelledby="study-title">
      <figure><button class="scene-button" type="button" data-scene aria-label="Powiększ: szkic poglądowy kompozycji oklejenia"><img src={media.compositionStudy} srcset={`${media.compositionStudy.replace('.webp','-768.webp')} 768w, ${media.compositionStudy} 1536w`} sizes="(max-width: 760px) 88vw, 60vw" alt="Szkic poglądowy: obrys samochodu z liniami prowadzącymi kompozycję i konturami kanciastych elementów oklejenia." width="1536" height="1024" loading="lazy"/></button><figcaption>Szkic poglądowy przygotowany na potrzeby prezentacji projektu. <span>Powiększ +</span></figcaption></figure>
      <div class="study-notes"><span class="label">STUDIUM KOMPOZYCJI</span><h3 id="study-title">Jak grafika<br/>pracuje z bryłą.</h3><ol><li><strong>Kierunek</strong><p>Ukośne linie prowadzą wzrok wzdłuż nadwozia.</p></li><li><strong>Punkt skupienia</strong><p>Największa powierzchnia drzwi eksponuje znak i nazwę.</p></li><li><strong>Ciągłość</strong><p>Cięcia na bokach, masce i tyle utrzymują rytm całej kompozycji.</p></li></ol></div>
    </div>
  </section>

  <section id="samochod" class="chapter frame" aria-labelledby="car-title">
    <div class="chapter-index"><span class="label">02 / WARIANTY I ROZMIESZCZENIE</span><span class="chapter-rule"></span></div>
    <div class="chapter-heading"><h2 id="car-title">Dwa warianty.<br/>Różna hierarchia znaku.</h2><p>Proporcje znaku, udział bieli i złoty akcent zmieniają odbiór tej samej bryły. Oba warianty pokazują różne sposoby zbudowania hierarchii.</p></div>
    <div class="variants">
      <figure><div class="variant-head"><span class="variant-letter">A</span><span class="label">ZŁOTY AKCENT</span></div><button class="artwork" type="button" data-artwork aria-label="Powiększ: wariant samochodu ze złotym akcentem"><ProcessArtwork src={media.carVariants} view="variant-gold" id="variant-gold" alt="Wariant A: duży czarny obszar, smukłe liternictwo i złote akcenty."/></button><figcaption><h3>Znak i podpis.</h3><p>Więcej czerni, złote detale i podpis pod nazwą.</p></figcaption></figure>
      <figure><div class="variant-head"><span class="variant-letter">B</span><span class="label">BIEL I KONTRAST</span></div><button class="artwork" type="button" data-artwork aria-label="Powiększ: kontrastowy wariant samochodu"><ProcessArtwork src={media.carVariants} view="variant-white" id="variant-white" alt="Wariant B: większa biała nazwa i mocne białe cięcia w czarnej grafice."/></button><figcaption><h3>Większa siła nazwy.</h3><p>Szersze liternictwo i wyraźniejsze przełamania koloru.</p></figcaption></figure>
    </div>
    <div class="layout-heading"><span class="label">DOPASOWANIE DO BRYŁY</span><h3>Każda strona<br/>ma znaczenie.</h3><p>Motyw przechodzi na drugi bok, tył i maskę. Kompozycje zachowują wspólny rytm, reagując na kształt poszczególnych powierzchni.</p></div>
    <div class="placement-board">
      <figure class="opposite-side"><span class="view-label label">BOK / DRUGA STRONA</span><button class="artwork" type="button" data-artwork aria-label="Powiększ: projekt drugiego boku samochodu"><ProcessArtwork src={media.carSide2} view="car-side-2" id="opposite-side" alt="Rozmieszczenie grafiki na drugim boku samochodu Odwróceni."/></button></figure>
      <figure class="car-top"><span class="view-label label">WIDOK Z GÓRY / GRAFIKA NA MASCE</span><button class="artwork" type="button" data-artwork aria-label="Powiększ: samochód z góry i grafika maski"><ProcessArtwork src={media.carTop} view="car-top" id="car-top" alt="Projekt samochodu z góry ze znakiem i geometrią na masce."/></button><figcaption>Znak wpisany w kształt maski.</figcaption></figure>
      <figure class="car-rear"><span class="view-label label">TYŁ / DOMKNIĘCIE KOMPOZYCJI</span><button class="artwork" type="button" data-artwork aria-label="Powiększ: projekt tyłu samochodu"><ProcessArtwork src={media.carRear} view="car-rear" id="car-rear" alt="Projekt tyłu samochodu z nazwą, adresem profilu i kontynuacją motywu."/></button><figcaption>Układ napisów i kontynuacja charakterystycznych cięć.</figcaption></figure>
    </div>
  </section>

  <section id="lodz" class="chapter frame" aria-labelledby="boat-title">
    <div class="chapter-index"><span class="label">04 / DRUGI NOŚNIK</span><span class="chapter-rule"></span></div>
    <div class="chapter-heading"><h2 id="boat-title">Ten sam motyw<br/>na długiej burcie.</h2><p>Limonka i róż nadają nowy charakter. Ostre kształty łączą znak z dużym napisem, a cała kompozycja wykorzystuje długość i linię kadłuba.</p></div>
    <figure class="boat-scene"><button class="scene-button" type="button" data-scene aria-label="Powiększ: łódź Odwróceni — wizualizacja projektu"><img src={media.boatScene} srcset={`${media.boatScene.replace(".webp","-768.webp")} 768w, ${media.boatScene} 1536w`} sizes="(max-width: 600px) 88vw, 90vw" alt="Łódź z limonkowo-różową grafiką Odwróceni na jeziorze o wschodzie słońca — wizualizacja projektu." width="1536" height="1024" loading="lazy"/></button><figcaption><span class="label">ŁÓDŹ / WIZUALIZACJA PROJEKTU</span><span>Powiększ <b aria-hidden="true">+</b></span></figcaption></figure>
    <div class="boat-board-heading"><h3>Rytm dopasowany<br/>do kadłuba.</h3><div class="palette boat-palette" aria-label="Kolory projektu łodzi"><span style="--swatch:#b0e600"><i></i>Limonka</span><span style="--swatch:#df087c"><i></i>Róż</span><span style="--swatch:#101010"><i></i>Czerń</span><span style="--swatch:#ffffff"><i></i>Biel</span></div></div>
    <div class="boat-design-board">
      <figure class="boat-profile"><span class="view-label label">BURTA / PIERWSZY BOK</span><button class="artwork" type="button" data-artwork aria-label="Powiększ: pierwszy bok łodzi"><ProcessArtwork src={media.boatBoard} view="boat-side-1" id="boat-side-1" alt="Pierwszy bok łodzi z limonkowo-różową grafiką i napisem Misiek Koterski."/></button></figure>
      <figure class="boat-profile reverse"><span class="view-label label">BURTA / DRUGI BOK</span><button class="artwork" type="button" data-artwork aria-label="Powiększ: drugi bok łodzi"><ProcessArtwork src={media.boatBoard} view="boat-side-2" id="boat-side-2" alt="Drugi bok łodzi pokazujący dalszy przebieg różowo-limonkowego motywu."/></button></figure>
      <figure class="boat-rear"><span class="view-label label">TYŁ / KONTYNUACJA MOTYWU</span><button class="artwork" type="button" data-artwork aria-label="Powiększ: tył łodzi"><ProcessArtwork src={media.boatBoard} view="boat-rear" id="boat-rear" alt="Tył łodzi z oznaczeniem Odwróceni, napisem i kolorowymi akcentami."/></button><figcaption><h3>Spójna również z tyłu.</h3><p>Nazwa i akcenty kolorystyczne powracają na rufie.</p></figcaption></figure>
    </div>
  </section>

  <section id="zastosowanie" class="chapter frame application-chapter" aria-labelledby="application-title">
    <div class="chapter-index"><span class="label">05 / ZASTOSOWANIE PROJEKTU</span><span class="chapter-rule"></span></div>
    <div class="chapter-heading"><h2 id="application-title">Projekt w swoim<br/>otoczeniu.</h2><p>Zdjęcia łodzi pokazują kompozycję na rzeczywistym kadłubie: proporcje dużego napisu, drobne oznaczenia i relację koloru z kształtem burty.</p></div>
    <div class="reality-gallery"><figure class="workshop-photo"><img src={media.boatWorkshop} alt="Łódź z projektem limonkowo-różowego oklejenia w warsztacie." width="1280" height="960" loading="lazy"/><figcaption class="drawing-caption"><span>Łódź / zdjęcie zastosowania projektu</span></figcaption></figure><figure class="night-photo"><img src={media.boatNight} alt="Łódź z grafiką Odwróceni sfotografowana wieczorem przed drewnianym budynkiem." width="1280" height="960" loading="lazy"/><figcaption>Ten sam projekt w innym świetle.</figcaption></figure></div>
  </section>

  <section class="project-scope frame"><div><span class="label">ZAKRES MOJEJ PRACY</span><h2>Od kierunku<br/>do pełnej kompozycji.</h2><p>Projekt graficzny i opracowanie materiałów wizualnych: Dawid Wosiek / NADX.</p></div><ul><li><span>01</span>Koncepcje graficzne samochodu i łodzi</li><li><span>02</span>Warianty i dopasowanie do poszczególnych widoków</li><li><span>03</span>Plansze oraz materiały wizualne projektu</li></ul></section>
</article>
<ProjectInquiry project="Odwróceni" service="druk-i-reklama" topic="oklejenia" title="Projekt oklejenia dla Twojej marki." description="Masz samochód, łódź lub inny nośnik? Napisz, co chcesz oznakować i jakie materiały już posiadasz. Ustalimy koncepcję, potrzebne widoki i wycenę projektu."/>
<dialog class="artwork-dialog" aria-labelledby="artwork-dialog-title"><div class="dialog-bar"><h2 id="artwork-dialog-title">Podgląd projektu</h2><button type="button" class="dialog-close">Zamknij <span aria-hidden="true">×</span></button></div><div class="dialog-artwork"></div></dialog>

<script>
  const dialog=document.querySelector<HTMLDialogElement>('.artwork-dialog');
  let trigger:HTMLButtonElement|null=null;
  document.querySelectorAll<HTMLButtonElement>('.process-case [data-artwork],.process-case [data-scene],.process-case [data-scene-src]').forEach(button=>button.addEventListener('click',()=>{
    const source=button.querySelector('svg,img');if((!source&&!button.dataset.sceneSrc)||!dialog)return;
    trigger=button;
    const clone=source?source.cloneNode(true) as Element:new Image();
    if(clone instanceof HTMLImageElement&&button.dataset.sceneSrc){clone.src=button.dataset.sceneSrc;clone.alt=button.getAttribute('aria-label')||'Wizualizacja projektu';}
    if(clone instanceof HTMLImageElement){clone.loading='eager';clone.removeAttribute('fetchpriority');}
    clone.querySelectorAll('[id]').forEach(el=>{const old=el.id;el.id=old+'-zoom';clone.querySelectorAll('[clip-path]').forEach(target=>{if(target.getAttribute('clip-path')===`url(#${old})`)target.setAttribute('clip-path',`url(#${old}-zoom)`);});[clone,...clone.querySelectorAll('[aria-labelledby]')].forEach(target=>{const labelledBy=target.getAttribute('aria-labelledby');if(labelledBy)target.setAttribute('aria-labelledby',labelledBy.split(' ').map(id=>id===old?old+'-zoom':id).join(' '));});});
    dialog.querySelector('.dialog-artwork')!.replaceChildren(clone);
    dialog.querySelector('#artwork-dialog-title')!.textContent=button.getAttribute('aria-label')!.replace(/^Powiększ: /,'');
    dialog.showModal();document.body.style.overflow='hidden';dialog.querySelector<HTMLButtonElement>('.dialog-close')?.focus();
  }));
  dialog?.querySelector('.dialog-close')?.addEventListener('click',()=>dialog.close());
  dialog?.addEventListener('click',event=>{if(event.target===dialog){const box=dialog.getBoundingClientRect();if(event.clientX<box.left||event.clientX>box.right||event.clientY<box.top||event.clientY>box.bottom)dialog.close();}});
  dialog?.addEventListener('close',()=>{document.body.style.overflow='';dialog.querySelector('.dialog-artwork')?.replaceChildren();trigger?.focus();});
  const story=document.querySelector<HTMLVideoElement>('[data-story-film]');
  const storyButtons=[...document.querySelectorAll<HTMLButtonElement>('[data-story-time]')];
  const markChapter=()=>{if(!story)return;const index=story.currentTime>=11.6?2:story.currentTime>=1.6?1:0;storyButtons.forEach((button,i)=>button.setAttribute('aria-pressed',String(i===index)));};
  storyButtons.forEach(button=>button.addEventListener('click',async()=>{if(!story)return;try{if(story.readyState===0){await new Promise<void>((resolve,reject)=>{story.addEventListener('loadedmetadata',()=>resolve(),{once:true});story.addEventListener('error',()=>reject(new Error('film')),{once:true});story.load();});}story.currentTime=Number(button.dataset.storyTime);await story.play();}catch{story?.focus();}}));
  story?.addEventListener('timeupdate',markChapter);story?.addEventListener('play',()=>story.classList.add('started'));
  const videoObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{if(!entry.isIntersecting)(entry.target as HTMLVideoElement).pause();}),{threshold:0});
  document.querySelectorAll<HTMLVideoElement>('.process-case video').forEach(video=>videoObserver.observe(video));
</script>

<style>
  .process-case{--case-line:#dedede;--case-muted:#626262;background:#fff}
  .frame{width:90%;max-width:1280px;margin-inline:auto}
  .review-note{padding:8px 5%;border-bottom:1px solid var(--case-line);display:flex;justify-content:space-between;gap:16px;font-size:.56rem;letter-spacing:.07em;background:#fff}.review-note span{color:var(--case-muted);letter-spacing:0}
  .label{font-size:.6rem;font-weight:650;letter-spacing:.12em;line-height:1.5}.process-intro{padding:23px 0 31px}.back{font-size:.68rem;border-bottom:1px solid var(--case-line);padding-bottom:5px;display:inline-block}.intro-meta{display:flex;justify-content:space-between;gap:20px;margin-top:31px}.intro-grid{display:grid;grid-template-columns:1.8fr 1fr;gap:9%;align-items:end;margin-top:18px}h1{font-size:clamp(2.9rem,5.65vw,5.8rem);line-height:1.015;letter-spacing:-.065em}.dot{color:#c99f00}.intro-grid>div{padding-bottom:5px}.intro-grid p{font-size:.94rem;line-height:1.7;max-width:300px}.intro-scope{display:block;font-size:.64rem;color:var(--case-muted);margin-top:17px;line-height:1.7}
  figure{margin:0}.scene-button{display:block;width:100%;background:transparent;border:0;padding:0;cursor:zoom-in}.scene-button img{width:100%;height:auto}.hero-scene img{height:auto;object-fit:contain}.hero-scene figcaption,.boat-scene figcaption{display:flex;align-items:center;justify-content:space-between;gap:20px}.hero-scene figcaption a{font-size:.68rem;color:#101010}.hero-scene figcaption a span{margin-left:16px}.boat-scene{margin-top:27px}.boat-scene img{height:auto;object-fit:contain}.boat-scene figcaption b{font-size:1rem;font-weight:400;margin-left:9px}
  figcaption{font-size:.65rem;line-height:1.65;color:var(--case-muted);margin-top:12px}.process-nav{border-block:1px solid var(--case-line);margin-top:29px}.process-nav>div{display:flex;justify-content:space-between;gap:20px;padding:16px 0}.process-nav a{font-size:.69rem;white-space:nowrap}.process-nav a span{font-size:.55rem;color:#7a7a7a;margin-right:10px}.process-nav a:hover{text-decoration:underline;text-underline-offset:5px}
  .chapter{padding-top:57px;scroll-margin-top:25px}.chapter-index{display:flex;align-items:center;gap:26px}.chapter-rule{height:1px;background:var(--case-line);flex:1}.chapter-heading{display:grid;grid-template-columns:1.15fr 1fr;gap:15%;margin-top:24px;align-items:start}.chapter h2{font-size:clamp(2.1rem,3.25vw,3.3rem);line-height:1.08;letter-spacing:-.055em}.chapter-heading p{font-size:.85rem;line-height:1.8;padding-top:4px;max-width:460px}
