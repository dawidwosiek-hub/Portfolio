---
import ProcessArtwork from './ProcessArtwork.astro';
import {media} from '../previews/odwroceni';
const steps=[['kierunek','01','Kierunek'],['samochod','02','Samochód'],['przestrzen','03','Wizualizacja'],['lodz','04','Łódź'],['zastosowanie','05','Zastosowanie']];
---
<article class="process-case">
  <div class="review-note">PODGLĄD DO OCENY <span>Projekt poza publiczną listą realizacji</span></div>
  <header class="process-intro frame">
    <a class="back" href="/realizacje">← Wszystkie realizacje</a>
    <div class="intro-meta"><span class="label">ODWRÓCENI / PROJEKTY OKLEJEŃ</span><span class="label credit">DAWID WOSIEK / NADX</span></div>
    <div class="intro-grid"><h1>Wyrazisty projekt.<br/>Z każdej strony<span class="dot">.</span></h1><div><p>Samochód i łódź.<br/>Dwie formy, jeden wyrazisty język grafiki.</p><span class="intro-scope">Koncepcje · rozmieszczenie · wizualizacje</span></div></div>
  </header>

  <figure class="hero-film frame">
    <video controls muted playsinline preload="none" poster={media.carPoster} width="1280" height="720" aria-label="Odwróceni — detale wizualizacji samochodu"><source src={media.carFilm} type="video/mp4"/></video>
    <figcaption><span class="label">ODWRÓCENI / WIZUALIZACJA PROJEKTU</span><a href="#kierunek">Przejdź przez projekt <span aria-hidden="true">↓</span></a></figcaption>
  </figure>

  <nav class="process-nav" aria-label="Etapy projektu"><div class="frame">{steps.map(([id,num,name])=><a href={`#${id}`}><span>{num}</span>{name}</a>)}</div></nav>

  <section id="kierunek" class="chapter frame" aria-labelledby="direction-title">
    <div class="chapter-index"><span class="label">01 / KIERUNEK GRAFICZNY</span><span class="chapter-rule"></span></div>
    <div class="chapter-heading"><h2 id="direction-title">Najpierw charakter.<br/>Potem forma.</h2><p>Punktem wspólnym są mocny kontrast, ostre cięcia i duży znak. Na samochodzie żółte nadwozie staje się częścią kompozycji — grafika podąża za jego linią.</p></div>
    <div class="palette car-palette" aria-label="Kolory projektu samochodu"><span style="--swatch:#ffce00"><i></i>Żółć</span><span style="--swatch:#101010"><i></i>Czerń</span><span style="--swatch:#ffffff"><i></i>Biel</span><span style="--swatch:#b78950"><i></i>Złoty akcent</span></div>
    <figure class="direction-drawing">
      <button class="artwork" type="button" data-artwork aria-label="Powiększ: kompozycja pierwszego boku samochodu"><ProcessArtwork src={media.carSide1} view="car-side-1" id="direction-side" alt="Projekt żółtego samochodu z czarną kompozycją, białymi cięciami i złotym akcentem."/></button>
      <figcaption class="drawing-caption"><span>Kompozycja na boku samochodu</span><span>Powiększ projekt <b aria-hidden="true">+</b></span></figcaption>
    </figure>
    <div class="design-notes"><div><span class="label">01 / GŁÓWNY PUNKT</span><h3>Znak w centrum.</h3><p>Duża powierzchnia drzwi porządkuje hierarchię znaku i napisów.</p></div><div><span class="label">02 / RYTM</span><h3>Kierunek w grafice.</h3><p>Ukośne kształty nawiązują do linii nadwozia i łączą całą kompozycję.</p></div><div><span class="label">03 / KONTRAST</span><h3>Kolor jako tło.</h3><p>Czerń i biel wycinają wyraźne formy na żółtej karoserii.</p></div></div>
  </section>

  <section id="samochod" class="chapter frame" aria-labelledby="car-title">
    <div class="chapter-index"><span class="label">02 / WARIANTY I ROZMIESZCZENIE</span><span class="chapter-rule"></span></div>
    <div class="chapter-heading"><h2 id="car-title">Jeden temat.<br/>Dwa kierunki.</h2><p>Warianty różnią się proporcjami znaku, udziałem bieli i rolą złotego akcentu. Zestawienie pokazuje, jak te decyzje zmieniają odbiór tej samej bryły.</p></div>
    <div class="variants">
      <figure><div class="variant-head"><span class="variant-letter">A</span><span class="label">ZŁOTY AKCENT</span></div><button class="artwork" type="button" data-artwork aria-label="Powiększ: wariant samochodu ze złotym akcentem"><ProcessArtwork src={media.carVariants} view="variant-gold" id="variant-gold" alt="Wariant A: duży czarny obszar, smukłe liternictwo i złote akcenty."/></button><figcaption><h3>Znak i podpis.</h3><p>Więcej czerni, złote detale i podpis wpleciony pod nazwę.</p></figcaption></figure>
      <figure><div class="variant-head"><span class="variant-letter">B</span><span class="label">BIEL I KONTRAST</span></div><button class="artwork" type="button" data-artwork aria-label="Powiększ: kontrastowy wariant samochodu"><ProcessArtwork src={media.carVariants} view="variant-white" id="variant-white" alt="Wariant B: większa biała nazwa i mocne białe cięcia w czarnej grafice."/></button><figcaption><h3>Większa siła nazwy.</h3><p>Szersze liternictwo, biały znak i wyraźniejsze przełamania koloru.</p></figcaption></figure>
    </div>
    <div class="layout-heading"><span class="label">DOPASOWANIE DO BRYŁY</span><h3>Projekt nie kończy się<br/>na jednej stronie.</h3><p>Motyw przechodzi na drugi bok, tył i maskę. Każdy widok ma własną kompozycję, ale zachowuje wspólny rytm.</p></div>
    <figure class="opposite-side"><span class="view-label label">BOK / DRUGA STRONA</span><button class="artwork" type="button" data-artwork aria-label="Powiększ: projekt drugiego boku samochodu"><ProcessArtwork src={media.carSide2} view="car-side-2" id="opposite-side" alt="Rozmieszczenie grafiki na drugim boku samochodu Odwróceni."/></button></figure>
    <div class="car-angles"><figure><span class="view-label label">TYŁ / DOMKNIĘCIE KOMPOZYCJI</span><button class="artwork" type="button" data-artwork aria-label="Powiększ: projekt tyłu samochodu"><ProcessArtwork src={media.carRear} view="car-rear" id="car-rear" alt="Projekt tyłu samochodu z nazwą, adresem profilu i kontynuacją motywu."/></button><figcaption>Układ napisów i powrót charakterystycznych cięć.</figcaption></figure><figure><span class="view-label label">WIDOK Z GÓRY / GRAFIKA NA MASCE</span><button class="artwork" type="button" data-artwork aria-label="Powiększ: samochód z góry i grafika maski"><ProcessArtwork src={media.carTop} view="car-top" id="car-top" alt="Projekt samochodu z góry ze znakiem i geometrią na masce."/></button><figcaption>Znak wpisany w kształt maski i przedniej części nadwozia.</figcaption></figure></div>
  </section>

  <section id="przestrzen" class="chapter film-chapter" aria-labelledby="space-title">
    <div class="frame"><div class="chapter-index"><span class="label">03 / WIZUALIZACJA</span><span class="chapter-rule"></span></div><div class="chapter-heading"><h2 id="space-title">Z płaskiej planszy<br/>w przestrzeń.</h2><p>Wizualizacja pokazuje projekt pod różnymi kątami: proporcje grafiki, relację z kolorem auta i jej przebieg na bryle.</p></div></div>
    <figure class="orbit-film frame"><video controls muted playsinline preload="none" poster={media.orbitPoster} width="1280" height="720" aria-label="Odwróceni — wizualizacja samochodu z różnych stron"><source src={media.orbitFilm} type="video/mp4"/></video><figcaption><span class="label">SAMOCHÓD / WIZUALIZACJA PROJEKTU</span><span>Odtwórz, aby obejrzeć bryłę z różnych stron</span></figcaption></figure>
  </section>

  <section id="lodz" class="chapter frame" aria-labelledby="boat-title">
    <div class="chapter-index"><span class="label">04 / DRUGI NOŚNIK</span><span class="chapter-rule"></span></div>
    <div class="chapter-heading"><h2 id="boat-title">Ten sam język.<br/>Nowa energia.</h2><p>Na łodzi zmieniają się skala, proporcje i paleta. Limonka i róż wprowadzają nowy charakter, a ostre kształty łączą znak z dużym napisem na burcie.</p></div>
    <div class="palette boat-palette" aria-label="Kolory projektu łodzi"><span style="--swatch:#b0e600"><i></i>Limonka</span><span style="--swatch:#df087c"><i></i>Róż</span><span style="--swatch:#101010"><i></i>Czerń</span><span style="--swatch:#ffffff"><i></i>Biel</span></div>
    <figure class="boat-profile"><span class="view-label label">BURTA / PIERWSZY BOK</span><button class="artwork" type="button" data-artwork aria-label="Powiększ: pierwszy bok łodzi"><ProcessArtwork src={media.boatBoard} view="boat-side-1" id="boat-side-1" alt="Pierwszy bok łodzi z limonkowo-różową grafiką i napisem Misiek Koterski."/></button><figcaption class="drawing-caption"><span>Duży napis dopasowany do długości kadłuba.</span><span>Powiększ projekt <b aria-hidden="true">+</b></span></figcaption></figure>
    <div class="boat-details"><figure><span class="view-label label">TYŁ / KONTYNUACJA MOTYWU</span><button class="artwork" type="button" data-artwork aria-label="Powiększ: tył łodzi"><ProcessArtwork src={media.boatBoard} view="boat-rear" id="boat-rear" alt="Tył łodzi z oznaczeniem Odwróceni, napisem i kolorowymi akcentami."/></button><figcaption><h3>Spójność z każdej strony.</h3><p>Nazwa i akcenty kolorystyczne powracają na rufie.</p></figcaption></figure><figure><span class="view-label label">DETAL / OZNACZENIE</span><button class="artwork" type="button" data-artwork aria-label="Powiększ: detal oznaczenia łodzi"><ProcessArtwork src={media.boatBoard} view="boat-detail" id="boat-detail" alt="Detal czarnego elementu łodzi z limonkowo-różowym napisem ADHD Club."/></button><figcaption><h3>Mały element. Ten sam rytm.</h3><p>Paleta i liternictwo utrzymane również w detalach.</p></figcaption></figure></div>
    <figure class="boat-profile reverse"><span class="view-label label">BURTA / DRUGI BOK</span><button class="artwork" type="button" data-artwork aria-label="Powiększ: drugi bok łodzi"><ProcessArtwork src={media.boatBoard} view="boat-side-2" id="boat-side-2" alt="Drugi bok łodzi pokazujący dalszy przebieg różowo-limonkowego motywu."/></button><figcaption>Kompozycja dopasowana do przeciwnej strony łodzi.</figcaption></figure>
  </section>

  <section id="zastosowanie" class="chapter application-chapter" aria-labelledby="application-title">
    <div class="frame"><div class="chapter-index"><span class="label">05 / ZASTOSOWANIE PROJEKTU</span><span class="chapter-rule"></span></div><div class="chapter-heading"><h2 id="application-title">Z projektu<br/>w rzeczywistą skalę.</h2><p>Zdjęcia łodzi pokazują, jak zaprojektowana kompozycja wygląda na kadłubie. Widać relację dużego napisu, detali i koloru z kształtem burty.</p></div></div>
    <figure class="workshop-photo frame"><img src={media.boatWorkshop} alt="Łódź z projektem limonkowo-różowego oklejenia w warsztacie." width="1280" height="960" loading="lazy"/><figcaption class="drawing-caption"><span>Łódź / zdjęcie zastosowania projektu</span><span>Projekt graficzny: Dawid Wosiek / NADX</span></figcaption></figure>
    <div class="night-layout frame"><div><span class="label">GRAFIKA W OTOCZENIU</span><h3>Ten sam motyw.<br/>Inne światło.</h3><p>Czerń kadłuba łączy elementy projektu. Limonka, róż i biel nadają wyraźny podział całej burcie.</p></div><figure><img src={media.boatNight} alt="Łódź z grafiką Odwróceni sfotografowana wieczorem przed drewnianym budynkiem." width="1280" height="960" loading="lazy"/><figcaption>Drugie ujęcie łodzi z zastosowaną grafiką.</figcaption></figure></div>
  </section>

  <section class="project-scope frame"><span class="label">ZAKRES MOJEJ PRACY</span><div><h2>Od kierunku<br/>do pełnej kompozycji.</h2><ul><li><span>01</span>Koncepcje graficzne samochodu i łodzi</li><li><span>02</span>Warianty i dopasowanie do poszczególnych widoków</li><li><span>03</span>Plansze oraz materiały wizualne projektu</li></ul></div><p>Projekt graficzny i opracowanie materiałów wizualnych: Dawid Wosiek / NADX.</p></section>
</article>
<section class="process-cta"><div class="frame"><h2>Masz pomysł?<br/>Nadajmy mu formę.</h2><a class="button" href="/kontakt?usluga=druk-i-reklama">Porozmawiajmy o projekcie <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></a></div></section>
<dialog class="artwork-dialog" aria-labelledby="artwork-dialog-title"><div class="dialog-bar"><h2 id="artwork-dialog-title">Podgląd projektu</h2><button type="button" class="dialog-close">Zamknij <span aria-hidden="true">×</span></button></div><div class="dialog-artwork"></div></dialog>

<script>
  const dialog=document.querySelector<HTMLDialogElement>('.artwork-dialog');
  let trigger:HTMLButtonElement|null=null;
  document.querySelectorAll<HTMLButtonElement>('[data-artwork]').forEach(button=>button.addEventListener('click',()=>{
    const source=button.querySelector('svg');if(!source||!dialog)return;
    trigger=button;
    const clone=source.cloneNode(true) as SVGElement;
    // Each modal copy gets its own clip id so it never references a hidden duplicate.
    clone.querySelectorAll('[id]').forEach(el=>{const old=el.id;el.id=old+'-zoom';clone.querySelectorAll('[clip-path]').forEach(target=>{if(target.getAttribute('clip-path')===`url(#${old})`)target.setAttribute('clip-path',`url(#${old}-zoom)`);});[clone,...clone.querySelectorAll('[aria-labelledby]')].forEach(target=>{const labelledBy=target.getAttribute('aria-labelledby');if(labelledBy)target.setAttribute('aria-labelledby',labelledBy.split(' ').map(id=>id===old?old+'-zoom':id).join(' '));});});
    dialog.querySelector('.dialog-artwork')!.replaceChildren(clone);
    dialog.querySelector('#artwork-dialog-title')!.textContent=button.getAttribute('aria-label')!.replace(/^Powiększ: /,'');
    dialog.showModal();document.body.style.overflow='hidden';dialog.querySelector<HTMLButtonElement>('.dialog-close')?.focus();
  }));
  dialog?.querySelector('.dialog-close')?.addEventListener('click',()=>dialog.close());
  dialog?.addEventListener('click',event=>{if(event.target===dialog){const box=dialog.getBoundingClientRect();if(event.clientX<box.left||event.clientX>box.right||event.clientY<box.top||event.clientY>box.bottom)dialog.close();}});
  dialog?.addEventListener('close',()=>{document.body.style.overflow='';dialog.querySelector('.dialog-artwork')?.replaceChildren();trigger?.focus();});
  const videoObserver=new IntersectionObserver(entries=>entries.forEach(entry=>{if(!entry.isIntersecting)(entry.target as HTMLVideoElement).pause();}),{threshold:0});
  document.querySelectorAll<HTMLVideoElement>('.process-case video').forEach(video=>videoObserver.observe(video));
</script>

<style>
  .process-case{--case-line:#dedede;--case-muted:#626262;background:#fff}
  .frame{width:90%;max-width:1280px;margin-inline:auto}
  .review-note{padding:9px 5%;border-bottom:1px solid var(--case-line);display:flex;justify-content:space-between;gap:16px;font-size:.58rem;letter-spacing:.07em;background:#fff}
  .review-note span{color:var(--case-muted);letter-spacing:0}
  .process-intro{padding:30px 0 44px}.back{font-size:.7rem;border-bottom:1px solid var(--case-line);padding-bottom:5px;display:inline-block}
  .label{font-size:.6rem;font-weight:650;letter-spacing:.12em;line-height:1.5}
  .intro-meta{display:flex;justify-content:space-between;gap:20px;margin-top:48px}
  .intro-grid{display:grid;grid-template-columns:1.9fr 1fr;gap:6%;align-items:end;margin-top:22px}
  h1{font-size:clamp(3rem,6.15vw,6.4rem);line-height:1.01;letter-spacing:-.065em}
  .dot{color:#d9ad00}.intro-grid>div{padding-bottom:7px}.intro-grid p{font-size:1rem;line-height:1.65;max-width:320px}.intro-scope{display:block;font-size:.68rem;color:var(--case-muted);margin-top:23px;line-height:1.7}
  figure{margin:0}.hero-film video,.orbit-film video{width:100%;height:auto;aspect-ratio:16/9;background:#101010}
  figcaption{font-size:.66rem;line-height:1.65;color:var(--case-muted);margin-top:14px}
  .hero-film figcaption,.orbit-film figcaption{display:flex;justify-content:space-between;gap:20px;align-items:center}.hero-film figcaption a{color:#101010;font-size:.7rem}.hero-film figcaption a span{margin-left:18px}
  .process-nav{border-block:1px solid var(--case-line);margin-top:42px}.process-nav>div{display:flex;justify-content:space-between;gap:20px;padding:19px 0}.process-nav a{font-size:.72rem;white-space:nowrap}.process-nav a span{color:#7a7a7a;font-size:.57rem;margin-right:10px}.process-nav a:hover{text-decoration:underline;text-underline-offset:5px}
  .chapter{padding-top:88px;scroll-margin-top:25px}.chapter-index{display:flex;align-items:center;gap:28px}.chapter-rule{height:1px;background:var(--case-line);flex:1}.chapter-heading{display:grid;grid-template-columns:1.3fr 1fr;gap:14%;margin-top:30px;align-items:start}.chapter h2{font-size:clamp(2.1rem,3.85vw,3.9rem);line-height:1.07;letter-spacing:-.055em}.chapter-heading p{font-size:.89rem;line-height:1.85;padding-top:5px;max-width:440px}
  .palette{display:flex;gap:26px;margin-top:35px}.palette>span{display:flex;align-items:center;gap:8px;font-size:.62rem;color:var(--case-muted)}.palette i{display:block;background:var(--swatch);width:20px;height:9px;border:1px solid #10101015}
  .artwork{display:block;width:100%;padding:0;border:0;border-radius:0;background:transparent;color:inherit;cursor:zoom-in}.artwork :global(svg){display:block;width:100%;height:auto}.artwork:hover{outline:1px solid #10101020;outline-offset:9px}.direction-drawing{margin-top:35px}.drawing-caption{display:flex;justify-content:space-between;gap:20px}.drawing-caption b{font-size:1rem;font-weight:400;margin-left:10px;color:#101010}
  .design-notes{display:grid;grid-template-columns:repeat(3,1fr);gap:5%;margin-top:36px}.design-notes>div{border-top:1px solid var(--case-line);padding-top:19px}.design-notes .label{font-size:.55rem;color:var(--case-muted)}.design-notes h3{font-size:1.25rem;letter-spacing:-.035em;margin-top:13px}.design-notes p{font-size:.78rem;line-height:1.8;margin-top:12px;max-width:310px}
  .variants{display:grid;grid-template-columns:1fr 1fr;gap:5%;margin-top:45px}.variant-head{display:flex;align-items:center;gap:14px;border-top:1px solid var(--case-line);padding-top:16px;margin-bottom:28px}.variant-letter{font-size:.9rem;font-weight:600;width:28px;height:28px;border:1px solid var(--case-line);display:grid;place-items:center;border-radius:50%}.variants figcaption{margin-top:25px}.variants h3{color:#101010;font-size:1.4rem;letter-spacing:-.04em}.variants p{font-size:.8rem;line-height:1.8;margin-top:10px;max-width:410px}
  .layout-heading{display:grid;grid-template-columns:.65fr 1.25fr 1fr;gap:6%;border-top:1px solid var(--case-line);margin-top:65px;padding-top:30px;align-items:start}.layout-heading>.label{padding-top:6px}.layout-heading h3{font-size:clamp(1.7rem,2.4vw,2.6rem);line-height:1.15;letter-spacing:-.05em}.layout-heading p{font-size:.83rem;line-height:1.8;padding-top:5px}
  .view-label{color:var(--case-muted);display:block;margin-bottom:23px;font-size:.54rem}.opposite-side{max-width:1080px;margin:38px auto 0}.car-angles{display:grid;grid-template-columns:1fr 1fr;gap:9%;margin-top:44px;align-items:start}.car-angles figure{border-top:1px solid var(--case-line);padding-top:22px}.car-angles .artwork{min-height:260px;display:flex;align-items:center}.car-angles :global(svg){max-height:350px}.car-angles figcaption{margin-top:22px}
  .orbit-film{margin-top:40px}.orbit-film figcaption .label{font-size:.56rem}
  .boat-palette{margin-bottom:36px}.boat-profile{margin-top:30px}.boat-profile .artwork{max-width:1005px;margin-inline:auto}.boat-details{display:grid;grid-template-columns:1.1fr 1fr;gap:13%;margin:45px 5% 0}.boat-details>figure{border-top:1px solid var(--case-line);padding-top:23px}.boat-details .artwork{height:290px;display:flex;align-items:center;max-width:504px;margin-inline:auto}.boat-details>figure:last-child .artwork{max-width:351px}.boat-details :global(svg){max-height:290px}.boat-details h3{font-size:1.25rem;color:#101010;letter-spacing:-.035em}.boat-details p{font-size:.8rem;margin-top:10px;line-height:1.8}.reverse{margin-top:55px}
  .workshop-photo{margin-top:40px}.workshop-photo img{width:100%;aspect-ratio:2.15;object-fit:cover;object-position:center 30%}.night-layout{display:grid;grid-template-columns:.7fr 1.3fr;gap:9%;align-items:center;margin-top:55px}.night-layout h3{font-size:clamp(1.8rem,2.5vw,2.7rem);line-height:1.12;letter-spacing:-.05em;margin-top:22px}.night-layout p{font-size:.86rem;line-height:1.85;margin-top:23px;max-width:310px}.night-layout img{width:100%;height:auto}.night-layout .label{font-size:.56rem}
