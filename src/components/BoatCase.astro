---
import ProjectImage from './ProjectImage.astro';
import ProjectInquiry from './ProjectInquiry.astro';
import {media} from '../lib/odwroceni-media';
const views=[
 {src:'/media/odwroceni/odwroceni-burta.webp',title:'Burta / pierwszy bok',alt:'Pierwszy bok łodzi z limonkowo-różową grafiką i napisem Misiek Koterski.'},
 {src:'/media/odwroceni/odwroceni-druga-burta.webp',title:'Burta / drugi bok',alt:'Drugi bok łodzi pokazujący dalszy przebieg różowo-limonkowego motywu.'},
 {src:'/media/odwroceni/odwroceni-rufa.webp',title:'Rufa / kontynuacja motywu',alt:'Tył łodzi z oznaczeniem Odwróceni, napisem i kolorowymi akcentami.'}
];
---
<article class="process-case boat-case">
 <header class="frame intro">
  <a class="back" href="/realizacje">← Wszystkie realizacje</a>
  <div class="meta"><span>ODWRÓCENI / PROJEKT OKLEJENIA ŁODZI</span><span>DAWID WOSIEK / NADX</span></div>
  <div class="intro-grid"><h1>Odwróceni<span>.</span></h1><div><p>Projekt graficzny oklejenia łodzi Malibu Wakesetter. Limonka, róż i ostre cięcia prowadzą wzdłuż burty, a duży napis nadaje kompozycji charakter.</p><a class="text-link" href="/kontakt?projekt=Odwr%C3%B3ceni&amp;usluga=druk-i-reklama&amp;temat=oklejenia">Zapytaj o projekt oklejenia <svg class="arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14" stroke="currentColor" stroke-width="1.8"/></svg></a></div></div>
 </header>
 <figure class="frame hero-photo"><button type="button" class="scene-button" data-boat-zoom={media.boatScene} data-boat-title="Łódź Odwróceni — wizualizacja projektu" aria-label="Powiększ: łódź Odwróceni — wizualizacja projektu"><img src={media.boatScene} srcset={`${media.boatScene.replace('.webp','-768.webp')} 768w, ${media.boatScene} 1536w`} sizes="90vw" alt="Łódź Odwróceni z limonkowo-różową grafiką, na fizycznych podporach w jasnoszarym studiu — wizualizacja projektu." width="1536" height="1024" fetchpriority="high"/></button><figcaption><span>ŁÓDŹ / WIZUALIZACJA PROJEKTU</span><span>Oryginalna wizualizacja łodzi w opracowaniu studyjnym. Powiększ +</span></figcaption></figure>
 <nav class="process-nav frame" aria-label="Etapy projektu"><a href="#kierunek">Koncepcja</a><a href="#rozmieszczenie">Rozmieszczenie</a><a href="#lodz">Łódź</a><a href="#zastosowanie">Zdjęcia</a></nav>
 <section id="kierunek" class="frame chapter" aria-labelledby="direction-title">
  <div class="section-label">KIERUNEK GRAFICZNY</div><div class="chapter-heading"><h2 id="direction-title">Rytm, który podąża<br/>za kadłubem.</h2><p>Duża nazwa jest punktem skupienia. Ostre kształty prowadzą wzrok wzdłuż burty, a drobne oznaczenia zachowują czytelną hierarchię.</p></div>
  <figure class="composition-study"><button type="button" class="scene-button" data-boat-zoom={media.compositionStudy} data-boat-title="Plansza kompozycji oklejenia łodzi" aria-label="Powiększ: kompozycja oklejenia łodzi"><img src={media.compositionStudy} srcset={`${media.compositionStudy.replace('.webp','-768.webp')} 768w, ${media.compositionStudy} 1536w`} sizes="90vw" alt="Oryginalna plansza projektu łodzi z pierwszą burtą, rufą i drugim bokiem, zaprezentowana na papierze w jasnym studiu." width="1536" height="1024" loading="lazy"/></button><figcaption>Plansza kompozycji — oryginalne widoki projektu. <span>Powiększ +</span></figcaption></figure>
  <div class="palette" aria-label="Kolory projektu łodzi"><span><i style="background:#b0e600"></i>Limonka</span><span><i style="background:#df087c"></i>Róż</span><span><i style="background:#101010"></i>Czerń</span><span><i style="background:#fff"></i>Biel</span></div>
 </section>
 <section id="rozmieszczenie" class="frame chapter" aria-labelledby="layout-title">
  <span id="samochod" aria-hidden="true"></span><div class="section-label">WIDOKI I ROZMIESZCZENIE</div><div class="chapter-heading"><h2 id="layout-title">Każda strona<br/>ma znaczenie.</h2><p>Motyw przechodzi na drugi bok i rufę. Układ napisów oraz kolorowe akcenty tworzą spójną całość na poszczególnych powierzchniach.</p></div>
  <div class="view-grid">{views.map(view=><figure><button type="button" class="scene-button" data-artwork data-boat-zoom={view.src} data-boat-title={view.title} aria-label={`Powiększ: ${view.title}`}><ProjectImage media={{src:view.src,smallSrc:view.src.replace('.webp','-768.webp'),width:1536,height:1024,alt:view.alt}} sizes="(max-width:760px) 88vw, 44vw"/></button><figcaption>{view.title}</figcaption></figure>)}</div>
 </section>
 <section id="lodz" class="frame chapter" aria-labelledby="boat-title"><div class="section-label">GRAFIKA NA BRYLE</div><div class="chapter-heading"><h2 id="boat-title">Ten sam motyw<br/>na długiej burcie.</h2><p>Limonka i róż nadają łodzi charakter. Kompozycja wykorzystuje długość kadłuba, proporcje napisu i przestrzeń między elementami.</p></div><figure><button type="button" class="scene-button" data-boat-zoom={media.boatScene} data-boat-title="Łódź Odwróceni — wizualizacja projektu" aria-label="Powiększ wizualizację łodzi"><ProjectImage media={{src:media.boatScene,smallSrc:media.boatScene.replace('.webp','-768.webp'),width:1536,height:1024,alt:'Łódź z projektem limonkowo-różowego oklejenia Odwróceni w jasnym studiu.'}}/></button><figcaption>ŁÓDŹ / WIZUALIZACJA PROJEKTU</figcaption></figure></section>
 <section id="zastosowanie" class="frame chapter" aria-labelledby="application-title"><div class="section-label">DOKUMENTACJA PROJEKTU</div><div class="chapter-heading"><h2 id="application-title">Projekt w swoim<br/>otoczeniu.</h2><p>Fotografie pokazują kompozycję na rzeczywistym kadłubie. Zachowują oryginalne detale oklejenia, a studyjna oprawa porządkuje prezentację dokumentacji.</p></div><div class="reality-gallery"><figure><button type="button" class="scene-button" data-boat-zoom="/media/originals/podglad/odwroceni-c0ec4c60be97/027b65612a4f2c46.webp" data-boat-title="Łódź / zdjęcie zastosowania projektu" aria-label="Powiększ oryginalne zdjęcie łodzi w warsztacie"><img src={media.boatWorkshop} alt="Łódź z projektem limonkowo-różowego oklejenia w warsztacie." width="1280" height="960" loading="lazy"/></button><figcaption>Łódź / zdjęcie zastosowania projektu</figcaption></figure><figure><button type="button" class="scene-button" data-boat-zoom="/media/originals/podglad/odwroceni-c0ec4c60be97/1aac2f448138e211.webp" data-boat-title="Ten sam projekt w innym świetle" aria-label="Powiększ oryginalne wieczorne zdjęcie łodzi"><img src={media.boatNight} alt="Łódź z grafiką Odwróceni sfotografowana wieczorem przed drewnianym budynkiem." width="1280" height="960" loading="lazy"/></button><figcaption>Ten sam projekt w innym świetle.</figcaption></figure></div></section>
 <section id="przestrzen" class="frame chapter story-section" aria-labelledby="story-title"><div class="chapter-heading"><h2 id="story-title">Od planszy<br/>do prezentacji.</h2><p>Oryginalne widoki projektu oraz fotografie łodzi w jednej, uporządkowanej prezentacji.</p></div><video class="story-film" data-story-film controls muted playsinline preload="none" poster={media.boatScene} width="1280" height="720" aria-label="Odwróceni — prezentacja projektu oklejenia łodzi"><source src={media.storyFilm} type="video/mp4"/></video></section>
 <section class="frame chapter scope"><div><span class="section-label">ZAKRES MOJEJ PRACY</span><h2>Od kierunku<br/>do pełnej kompozycji.</h2><p>Projekt graficzny i opracowanie materiałów wizualnych: Dawid Wosiek / NADX.</p></div><ul><li>Koncepcja graficzna oklejenia łodzi</li><li>Rozmieszczenie motywu i hierarchia napisów</li><li>Dopasowanie do burt oraz rufy</li><li>Plansze i wizualizacje projektu</li></ul></section>
</article>
<ProjectInquiry project="Odwróceni" service="druk-i-reklama" topic="oklejenia" title="Projekt oklejenia dla Twojej marki." description="Masz łódź, samochód lub inny nośnik? Napisz, co chcesz oznakować i jakie materiały już posiadasz. Ustalimy koncepcję, potrzebne widoki i wycenę projektu."/>
<dialog class="boat-dialog" aria-labelledby="boat-dialog-title"><div class="dialog-bar"><h2 id="boat-dialog-title">Podgląd projektu</h2><button type="button" data-boat-close aria-label="Zamknij podgląd" autofocus>Zamknij ×</button></div><img alt=""/></dialog>
<script>
 const dialog=document.querySelector<HTMLDialogElement>('.boat-dialog');
 let trigger:HTMLButtonElement|null=null;
 document.querySelectorAll<HTMLButtonElement>('[data-boat-zoom]').forEach(button=>button.addEventListener('click',()=>{
  if(!dialog)return;trigger=button;
  const image=dialog.querySelector('img')!;image.src=button.dataset.boatZoom!;image.alt=button.dataset.boatTitle||button.getAttribute('aria-label')||'Podgląd projektu';
  dialog.querySelector('h2')!.textContent=image.alt;dialog.showModal();dialog.querySelector<HTMLButtonElement>('button')!.focus();
 }));
 dialog?.querySelector('[data-boat-close]')?.addEventListener('click',()=>dialog.close());
 dialog?.addEventListener('close',()=>trigger?.focus({preventScroll:true}));
 dialog?.addEventListener('click',e=>{if(e.target===dialog){const r=dialog.getBoundingClientRect();if(e.clientX<r.left||e.clientX>r.right||e.clientY<r.top||e.clientY>r.bottom)dialog.close();}});
 const film=document.querySelector<HTMLVideoElement>('[data-story-film]');
 if(film){new IntersectionObserver(entries=>{if(!entries.some(e=>e.isIntersecting))film.pause();},{threshold:.05}).observe(film);document.addEventListener('visibilitychange',()=>{if(document.hidden)film.pause();});}
</script>
<style>
 .frame{width:90%;max-width:1320px;margin-inline:auto}.intro{padding-top:42px}.back{display:inline-block;margin-bottom:48px;font-size:.8rem;border-bottom:1px solid #ccc;padding-bottom:4px}.meta{display:flex;justify-content:space-between;gap:24px;font-size:.65rem;letter-spacing:.1em;margin-bottom:28px}.intro-grid{display:grid;grid-template-columns:1.3fr 1fr;gap:10%;align-items:end}.intro h1{font-size:clamp(4rem,8.8vw,9rem);letter-spacing:-.075em}.intro h1>span{color:#ffcc00}.intro-grid p{font-size:1.05rem;line-height:1.7}.intro-grid .text-link{margin-top:26px;font-size:.8rem}.hero-photo{margin-top:46px}figure{margin:0}.scene-button{display:block;width:100%;padding:0;background:transparent;border:0;text-align:left;color:inherit}.scene-button>img,.scene-button :global(img){width:100%;height:auto;display:block}.hero-photo figcaption{display:flex;justify-content:space-between;gap:24px}figcaption{font-size:.72rem;line-height:1.7;color:#626262;margin-top:15px}.process-nav{display:flex;gap:32px;flex-wrap:wrap;border-block:1px solid #dedede;padding-block:20px;margin-top:34px;font-size:.76rem}.process-nav a{border-bottom:1px solid #ccc}.chapter{padding-block:54px 20px;scroll-margin-top:20px}.section-label{font-size:.65rem;letter-spacing:.12em;border-top:1px solid #dedede;padding-top:20px;margin-bottom:32px;display:block}.chapter-heading{display:grid;grid-template-columns:1.1fr 1fr;gap:12%;margin-bottom:34px;align-items:start}.chapter h2{font-size:clamp(2.3rem,4vw,4rem)}.chapter-heading p,.scope p{font-size:.94rem;line-height:1.8}.palette{display:flex;gap:24px;margin-top:24px;font-size:.72rem}.palette span{display:flex;align-items:center;gap:8px}.palette i{width:13px;height:13px;border:1px solid #bbb;border-radius:50%}.view-grid,.reality-gallery{display:grid;grid-template-columns:1fr 1fr;gap:30px}.view-grid>figure:first-child{grid-column:1/-1}.reality-gallery img{width:100%;height:auto}.story-film{width:100%;height:auto;background:#f0f0f0;aspect-ratio:16/9}.scope{display:grid;grid-template-columns:1fr 1fr;gap:12%;padding-bottom:80px}.scope h2{margin-bottom:24px}.scope ul{list-style:none;padding:0;margin:0}.scope li{padding:22px 0;border-top:1px solid #dedede;font-size:.9rem}.boat-dialog{width:min(1400px,calc(100vw - 32px));padding:20px;border:0;background:white;max-height:calc(100dvh - 32px);overflow:auto}.boat-dialog::backdrop{background:rgb(0 0 0 / .75)}.dialog-bar{display:flex;justify-content:space-between;align-items:center;gap:20px;margin-bottom:20px}.dialog-bar h2{font-size:1.05rem;letter-spacing:-.02em;line-height:1.4}.dialog-bar button{border:1px solid #ccc;background:white;min-height:44px;padding:8px 14px;font-size:.8rem;white-space:nowrap}.boat-dialog>img{display:block;width:100%;height:auto;max-height:calc(100dvh - 130px);object-fit:contain}
 @media(max-width:760px){.frame{width:88%}.intro{padding-top:28px}.back{margin-bottom:30px}.meta{font-size:.56rem;line-height:1.8;flex-wrap:wrap;gap:8px}.intro-grid,.chapter-heading,.scope{grid-template-columns:1fr;gap:24px}.intro h1{font-size:clamp(3.4rem,14vw,6rem)}.intro-grid p{font-size:.95rem}.hero-photo{margin-top:28px}.hero-photo figcaption{display:block}.hero-photo figcaption>span{display:block}.process-nav{gap:20px}.chapter{padding-top:36px}.chapter h2{font-size:2.35rem}.chapter-heading p{font-size:.9rem}.view-grid,.reality-gallery{grid-template-columns:1fr;gap:28px}.view-grid>figure:first-child{grid-column:auto}.palette{gap:14px;flex-wrap:wrap}.scope{padding-bottom:40px}.boat-dialog{padding:12px}.dialog-bar h2{font-size:.83rem}}
</style>
