---
const steps=[
 ['Zapytanie','Opisujesz projekt, termin i miejsce, w którym ma działać.'],
 ['Zakres i wycena','Ustalamy liczbę propozycji, poprawki, formaty plików i cenę, zanim zacznę.'],
 ['Projekt','Przygotowuję projekt i pokazuję go na nośniku, na którym będzie użyty.'],
 ['Poprawki','Dopracowuję projekt w uzgodnionym zakresie.'],
 ['Pliki','Dostajesz pliki gotowe do druku, haftu, oklejenia lub publikacji.'],
];
---
<section class="section process" aria-labelledby="process-title">
 <div class="section-head"><div><h2 id="process-title">Jak pracuję</h2><p>Od pierwszej wiadomości do plików, które możesz od razu przekazać do produkcji.</p></div></div>
 <ol class="steps">{steps.map(([label,text],i)=><li><b aria-hidden="true">{i+1}</b><h3>{label}</h3><p>{text}</p></li>)}</ol>
</section>
