---
import ProjectImage from './ProjectImage.astro';
import type {Project} from '../lib/content';
interface Props {project:Project;priority?:boolean;sizes?:string}
const {project:p,priority=false,sizes='(max-width: 760px) 88vw, 55vw'}=Astro.props;
const cover=p.cover||{src:p.image,smallSrc:p.imageSmall,mediumSrc:p.imageMedium,alt:p.alt,width:p.imageWidth,height:p.imageHeight};
---
<div class="project-cover" data-project-cover={p.slug}>
  <div class="cover-photograph"><ProjectImage media={cover} priority={priority} sizes={sizes}/></div>
  <span class="cover-label" aria-hidden="true"><i></i></span>
</div>

<style>
 .project-cover{position:relative;isolation:isolate;width:100%;aspect-ratio:3/2;overflow:hidden;background:#fff;color:#101010}
 .cover-photograph{position:absolute;inset:0}
 .project-cover :global(img){display:block;width:100%;height:100%;max-height:none;aspect-ratio:auto;object-fit:contain;transform:none!important;transition:none;filter:none}
 .cover-label{position:absolute;top:12px;left:12px;line-height:0}
 .cover-label i{display:block;width:7px;height:7px;background:#ffcc00}
</style>
