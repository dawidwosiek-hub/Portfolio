# Public HTTPS URL, without trailing slash. Required for canonical, sitemap and form origin.
SITE_URL=
# Resend: verified sender and destination inbox. Server-only values.
RESEND_API_KEY=
CONTACT_FROM=
CONTACT_TO=
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
FORM_SECRET=
# Optional Redis REST service: required for shared rate limits across multiple instances.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Set only if your reverse proxy overwrites (not appends) this IP header.
TRUSTED_IP_HEADER=
PORT=4321
HOST=0.0.0.0
# Optional private, read-only Google Drive library. Disabled unless all three are set.
# Setup: DRIVE-LIBRARY.md. Never use PUBLIC_ prefixes for these values.
DRIVE_LIBRARY_KEY=
DRIVE_LIBRARY_FOLDERS=
GOOGLE_DRIVE_SERVICE_ACCOUNT_JSON=
# Optional private Vertex AI bridge. No generation until explicitly enabled.
# Setup: VERTEX-STUDIO.md. Keep the JSON key in Render Secret Files, not in Git.
VERTEX_BRIDGE_KEY=
VERTEX_PROJECT_ID=pro-landing-512512-v7
VERTEX_REGION=us-central1
VERTEX_SERVICE_ACCOUNT_EMAIL=nadx-projekt@pro-landing-512512-v7.iam.gserviceaccount.com
VERTEX_SERVICE_ACCOUNT_FILE=/etc/secrets/nadx-vertex.json
VERTEX_IMAGE_MODEL=imagen-4.0-generate-001
VERTEX_GENERATION_ENABLED=false
VERTEX_IMAGES_PER_HOUR=3
